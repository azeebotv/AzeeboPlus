{
  "expo": {
    "name": "Azeebo+ TV",
    "slug": "azeebo-plus-tv",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "azeebo-tv",
    "ios": {
      "bundleIdentifier": "com.azeebo.plus.tv",
      "infoPlist": {
        "CFBundleURLSchemes": ["azeebo-tv"],
        "UIRequiresFullScreen": true,
        "UIStatusBarHidden": true
      }
    },
    "android": {
      "package": "com.azeebo.plus.tv",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B090E"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "azeebo-tv"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "androidTv": {
      "banner": "./assets/tv-banner.png",
      "leanback": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B090E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "iamdeprof",
    "extra": {
      "eas": {
        "projectId": "3627eb83-fb81-4f76-bae5-668a14102705"
      },
      "router": {},
      "CERT_PIN_PRODUCTION": "PLACEHOLDER_SET_VIA_EAS_SECRET",
      "CERT_PIN_PRODUCTION_BACKUP": "PLACEHOLDER_SET_VIA_EAS_SECRET",
      "CERT_PIN_STAGING": "PLACEHOLDER_SET_VIA_EAS_SECRET",
      "CERT_PIN_STAGING_BACKUP": "PLACEHOLDER_SET_VIA_EAS_SECRET",
      "CERT_PIN_EXPIRY": "2027-12-31T23:59:59Z"
    }
  }
}

# TV Application
NODE_ENV=development

# API Configuration (Expo requires EXPO_PUBLIC_ prefix for client-side access)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3013
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:3013

# Device-link activation page users visit on a phone/browser (defaults to
# https://app.azeeboplus.com/link when unset — override for staging).
EXPO_PUBLIC_ACTIVATION_URL=https://app.azeeboplus.com/link

# ── Certificate pinning (H10) ─────────────────────────────────────────
# Real pins must be injected as EAS secrets at build time (they must never be
# committed). The placeholders below keep TV's app.json surface identical to
# mobile's; certificatePinning.ts ignores values containing "PLACEHOLDER".
#
# Current live values for app.azeeboplus.com (SPKI sha256, base64):
#   leaf:      cjKtHNe6yvq6vm9pFAkEFpTYRlacD03dU8CDM06zLco=   (Let's Encrypt, renews ~Nov 26 2026)
#   backup:    nWN7PSep5XDQdge5zK24CnCRXHr3KvzhKEGxsdqCX9E=   (intermediate YR2, valid to Sep 2028)
# Pins hash the SPKI (public key), not the cert, so renewals that reuse the
# keypair keep matching; the BACKUP pin carries you through a full rotation.
# Re-derive any time with:
#   echo | openssl s_client -connect app.azeeboplus.com:443 -servername app.azeeboplus.com -showcerts 2>/dev/null \
#     | awk '/BEGIN CERTIFICATE/,/END CERTIFICATE/' > /tmp/chain.pem
#   # split the chain, then for the leaf:
#   openssl x509 -in /tmp/leaf.pem -noout -pubkey \
#     | openssl pkey -pubin -outform DER \
#     | openssl dgst -sha256 -binary | base64
#
# Provisioning — pins bind to the same EXPO_PUBLIC_API_BASE_URL host the API
# client uses (loader default app.azeeboplus.com; override via
# CERT_PIN_HOST_PRODUCTION if it diverges):
#   eas secret:create --project azeebo-plus-tv --name CERT_PIN_PRODUCTION --value "sha256/cjKtHNe6yvq6vm9pFAkEFpTYRlacD03dU8CDM06zLco="
#   eas secret:create --project azeebo-plus-tv --name CERT_PIN_PRODUCTION_BACKUP --value "sha256/nWN7PSep5XDQdge5zK24CnCRXHr3KvzhKEGxsdqCX9E="
#   eas secret:create --project azeebo-plus-tv --name CERT_PIN_STAGING --value "sha256/<staging leaf>"
#   eas secret:create --project azeebo-plus-tv --name CERT_PIN_STAGING_BACKUP --value "sha256/<staging backup>"
#
# See packages/react-data/src/utils/certificatePinning.ts for the loader.

{
  "name": "@azeebo/tv",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ TV App (Android TV / Fire TV / tvOS)",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@react-native-async-storage/async-storage"
      ]
    }
  },
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:tv": "expo run:android --device tv",
    "lint": "eslint src app",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir .expo-bundle-check"
  },
  "dependencies": {
    "@azeebo/analytics-sdk": "workspace:*",
    "@azeebo/design-tokens": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/react-data": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "i18next": "^24.0.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.4.1",
    "react-native": "~0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.17",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.8.4"
  }
}

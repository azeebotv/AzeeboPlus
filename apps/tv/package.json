{
  "name": "@azeebo/tv",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ TV App (Android TV / Fire TV / tvOS)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:tv": "expo run:android --device tv",
    "lint": "eslint src app",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir .expo-bundle-check"
  },
  "dependencies": {
    "@azeebo/analytics-sdk": "workspace:*",
    "@azeebo/api-client": "workspace:*",
    "@azeebo/design-tokens": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/react-data": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-image": "~3.0.8",
    "expo-linear-gradient": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~3.0.0",
    "i18next": "^24.0.0",
    "qrcode": "1.5.4",
    "react-i18next": "^15.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "~0.85.3",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.17",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.8.4"
  }
}

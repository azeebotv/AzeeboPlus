{
  "name": "@azeebo/creator",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ Creator Dashboard",
  "main": "dist/main.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prebuild": "prisma generate",
    "build:client": "vite build --config client/vite.config.ts",
    "build": "pnpm build:client && prisma generate && tsc -p tsconfig.build.json",
    "dev:client": "vite --config client/vite.config.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint src --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:client": "vitest run --root client"
  },
  "dependencies": {
    "@azeebo/auth": "workspace:*",
    "@azeebo/design-tokens": "workspace:*",
    "@azeebo/error-handling": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/logger": "workspace:*",
    "@azeebo/security": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@azeebo/ui": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "lucide-react": "^0.511.0",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.0",
    "recharts": "^3.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@testing-library/react": "^16.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/passport-jwt": "^4.0.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "prisma": "^6.19.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@azeebo/security": [
        "../../packages/security/dist"
      ],
      "@azeebo/security/*": [
        "../../packages/security/dist/*"
      ],
      "@azeebo/shared-types": [
        "../../packages/shared-types/dist"
      ],
      "@azeebo/shared-types/*": [
        "../../packages/shared-types/dist/*"
      ],
      "@azeebo/*": [
        "../../packages/*/dist"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "strictPropertyInitialization": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}

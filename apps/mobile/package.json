{
  "name": "@azeebo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ Mobile App",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e:contract": "jest --config e2e/jest.contract.config.js",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:ios": "npm run e2e:build:ios && npm run e2e:test:ios",
    "e2e:android": "npm run e2e:build:android && npm run e2e:test:android"
  },
  "dependencies": {
    "@azeebo/analytics-sdk": "workspace:*",
    "@azeebo/api-client": "workspace:*",
    "@azeebo/design-tokens": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/react-data": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@azeebo/ui": "workspace:*",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.12",
    "expo-brightness": "~56.0.5",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.22",
    "expo-linear-gradient": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-local-authentication": "^56.0.4",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.20",
    "expo-video": "~3.0.0",
    "expo-web-browser": "~14.0.2",
    "i18next": "^24.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.4.1",
    "react-native": "~0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "~0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.17",
    "detox": "^20.33.0",
    "eslint": "^10.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  }
}

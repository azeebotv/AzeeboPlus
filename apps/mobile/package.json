{
  "name": "@azeebo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ Mobile App",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@react-native-async-storage/async-storage"
      ]
    }
  },
  "scripts": {
    "start": "expo start --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e:contract": "jest --config e2e/jest.contract.config.js",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:ios": "npm run e2e:build:ios && npm run e2e:test:ios",
    "e2e:android": "npm run e2e:build:android && npm run e2e:test:android"
  },
  "dependencies": {
    "@azeebo/analytics-sdk": "workspace:*",
    "@azeebo/api-client": "workspace:*",
    "@azeebo/design-tokens": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/react-data": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@azeebo/ui": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~57.0.30",
    "expo-brightness": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "^57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "i18next": "^24.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.4.1",
    "react-native": "~0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "~0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.17",
    "detox": "^20.33.0",
    "eslint": "^10.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  }
}

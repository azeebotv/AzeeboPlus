{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@azeebo/ui": ["../../packages/ui/src/mobile-index"],
      "@azeebo/ui/*": ["../../packages/ui/src/*"],
      "@azeebo/*": ["../../packages/*/dist"],
      "@azeebo/design-tokens": ["../../packages/design-tokens/src"]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "types/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "detox.setup.ts",
    "e2e",
    "**/__tests__/**"
  ]
}

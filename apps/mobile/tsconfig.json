{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@azeebo/react-data": [
        "../../packages/react-data/src/index.ts"
      ],
      "@azeebo/react-data/*": [
        "../../packages/react-data/src/*"
      ],
      "@azeebo/feature-flags/registries": [
        "../../packages/feature-flags/dist/registries"
      ],
      "@azeebo/ui": [
        "../../packages/ui/src/mobile-index"
      ],
      "@azeebo/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@azeebo/*": [
        "../../packages/*/dist"
      ],
      "@azeebo/design-tokens": [
        "../../packages/design-tokens/src"
      ]
    },
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "strictPropertyInitialization": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "types/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "detox.setup.ts",
    "e2e",
    "**/__tests__/**"
  ]
}

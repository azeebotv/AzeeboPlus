{
  "expo": {
    "name": "Azeebo+",
    "slug": "azeebo-plus",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "azeebo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azeebo.plus",
      "infoPlist": {
        "CFBundleURLSchemes": ["azeebo"],
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely sign in to Azeebo+."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0A0A"
      },
      "package": "com.azeebo.plus",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "azeebo"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-video",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A0A0A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to quickly and securely sign in to Azeebo+."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "iamdeprof",
    "extra": {
      "eas": {
        "projectId": "3627eb83-fb81-4f76-bae5-668a14102705"
      },
      "router": {}
    }
  }
}

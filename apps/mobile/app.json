{
  "expo": {
    "name": "Azeebo+",
    "slug": "azeebo-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "azeebo",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azeebo.plus",
      "infoPlist": {
        "CFBundleURLSchemes": [
          "azeebo"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0A0A"
      },
      "package": "com.azeebo.plus",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "azeebo"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "iamdeprof",
    "extra": {
      "apiBaseURL": "http://localhost:3013",
      "eas": {
        "projectId": "3627eb83-fb81-4f76-bae5-668a14102705"
      },
      "router": {}
    }
  }
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  password                String
  displayName             String
  avatar                  String?
  role                    String   @default("user")
  preferences             Json?
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  watchHistory   WatchHistory[]
  savedItems     SavedItem[]
  wallet         Wallet?
  notifications  Notification[]
  contentItems   ContentItem[]
  creatorProfile CreatorProfile?
  paymentIntents PaymentIntent[]
  payoutRequests PayoutRequest[]

  @@map("users")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("watch_history")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("saved_items")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0)
  bonusBalance Decimal  @default(0)
  promoBalance Decimal  @default(0)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String // credit, debit, bonus, promo, refund
  amount      Decimal
  status      String // pending, completed, failed, reversed
  description String?
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system, payment, reward, content, social
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PaymentIntent {
  id                String    @id @default(uuid())
  userId            String
  amount            Decimal
  currency          String    @default("NGN")
  status            String // pending, processing, completed, failed, refunded
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payment_intents")
}

model Refund {
  id                String   @id @default(uuid())
  paymentIntentId   String
  amount            Decimal
  reason            String
  status            String // pending, processing, completed, failed
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id                    String    @id @default(uuid())
  title                 String
  description           String?
  thumbnail             String
  mediaUrl              String?
  universeId            String
  creatorId             String
  status                String // draft, pending, published, archived
  viewCount             Int       @default(0)
  metadata              Json?
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  releaseDate           DateTime?
  theatricalReleaseDate DateTime?
  streamingReleaseDate  DateTime?
  windowEndDate         DateTime?
  windowType            String    @default("standard") // premium, standard, basic
  isExclusive           Boolean   @default(false)
  isPremiere            Boolean   @default(false)

  universe                      Universe              @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator                       User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset                    MediaAsset?
  categories                    Category[]
  tags                          Tag[]
  relationshipsAsContent        ContentRelationship[] @relation("ContentRelationshipContent")
  relationshipsAsRelatedContent ContentRelationship[] @relation("ContentRelationshipRelatedContent")

  @@map("content_items")
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model ContentRelationship {
  id               String   @id @default(uuid())
  contentId        String
  relatedContentId String
  type             String // sequel, prequel, related, series, remake, adaptation
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  content        ContentItem @relation("ContentRelationshipContent", fields: [contentId], references: [id], onDelete: Cascade)
  relatedContent ContentItem @relation("ContentRelationshipRelatedContent", fields: [relatedContentId], references: [id], onDelete: Cascade)

  @@unique([contentId, relatedContentId])
  @@map("content_relationships")
}

model PayoutRequest {
  id          String    @id @default(uuid())
  userId      String
  amount      Decimal
  currency    String    @default("NGN")
  status      String // pending, processing, completed, failed, rejected
  method      String // bank, mobile, card
  metadata    Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_requests")
}

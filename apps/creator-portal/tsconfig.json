{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@azeebo/security": ["../../packages/security/dist"],
      "@azeebo/security/*": ["../../packages/security/dist/*"],
      "@azeebo/shared-types": ["../../packages/shared-types/dist"],
      "@azeebo/shared-types/*": ["../../packages/shared-types/dist/*"],
      "@azeebo/*": ["../../packages/*/src"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}

# Admin Application
NODE_ENV=development
PORT=4016

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/azeebo_admin

JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_EXPIRES_IN=30m

API_GATEWAY_URL=http://localhost:3013

# Stale-flag sweep (StaleFlagSweepService): notifies flag owners when a
# flag's staleAfter passes. Runs at boot + every STALE_FLAG_SWEEP_INTERVAL_MS
# (default 6h); each flag is notified once (staleNotifiedAt is stamped).
#
# FLAG_OWNER_EMAILS - JSON map of owner -> email, e.g.
#   {"payments":"payments@azeebo.plus","queue":"platform@azeebo.plus"}
# STALE_FLAG_NOTIFY_EMAIL - ops digest fallback for flags without a mapped owner
# NOTIFICATION_SERVICE_URL - transactional email gateway (default http://notification-service:3006)
# ADMIN_BASE_URL - link embedded in the email (default http://localhost:4016)
FLAG_OWNER_EMAILS={}
STALE_FLAG_NOTIFY_EMAIL=
STALE_FLAG_SWEEP_INTERVAL_MS=21600000

# Nightly stale-flag pass (StaleFlagNightlyService): runs the sweep, optionally
# auto-prunes past-expiry flags (archived first), and posts a summary webhook.
# STALE_FLAG_AUTO_PRUNE - "true" to auto-prune past-expiry GLOBAL flags (default off)
# STALE_FLAG_AUTO_PRUNE_UNIVERSE - "true" to auto-prune past-expiry UNIVERSE flags (default off)
# STALE_FLAG_DRY_RUN_UNIVERSE - "true" to PREVIEW the universe prune without removing anything
# STALE_FLAG_ALLOW_PRUNE_WITHOUT_WEBHOOK - "true" to allow auto-prune even when no ops webhook is
#   configured (default off — auto-prune FAILS CLOSED without one, so removals can never be silent)
#   (reports exactly what auto-prune would remove; dry-run always wins over auto-prune)
# STALE_FLAG_OPS_WEBHOOK_URL - Slack-compatible incoming webhook for the summary
# STALE_FLAG_OPS_CHANNEL - optional channel override in the webhook payload
# STALE_FLAG_OPS_POST_EMPTY - "true" to post even when nothing is stale
STALE_FLAG_AUTO_PRUNE=false
STALE_FLAG_AUTO_PRUNE_UNIVERSE=false
STALE_FLAG_DRY_RUN_UNIVERSE=false
STALE_FLAG_ALLOW_PRUNE_WITHOUT_WEBHOOK=false
STALE_FLAG_OPS_WEBHOOK_URL=

# Prometheus for the stale-serving report (GET /admin/feature-flags/stale/metrics).
# Points at the Prometheus that scrapes the services' /metrics.
# Default for the local stack: run `docker compose up -d` in
# services/core/search-service/prometheus, then use the URL below.
# Unset => the admin UI shows "stale-serving metrics unavailable".
PROMETHEUS_URL=http://localhost:9090

# TTL for the server-side cache of the Prometheus join (stale metrics endpoint);
# default 30000ms. The dashboard polls every 30s — this cache absorbs the load.
PROMETHEUS_CACHE_TTL_MS=30000

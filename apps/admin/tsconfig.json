{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "typeRoots": [
      "../../node_modules/@types",
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@azeebo/security": ["../../packages/security/dist"],
      "@azeebo/security/*": ["../../packages/security/dist/*"],
      "@azeebo/shared-types": ["../../packages/shared-types/dist"],
      "@azeebo/shared-types/*": ["../../packages/shared-types/dist/*"],
      "@azeebo/*": ["../../packages/*/dist"],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

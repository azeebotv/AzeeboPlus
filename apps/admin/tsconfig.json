{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "target": "es2022",
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "types": ["node", "jest"],
    "paths": {
      "@azeebo/*": ["../../packages/*/dist"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

# ============================================================
# Azeebo+ Production Environment Variables
# ============================================================
# Copy this file to .env.prod and fill in all values.
# Every variable without a default MUST be set for production.
# ============================================================

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=azeebo
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=azeebo
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
GATEWAY_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING
WEBHOOK_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING

# ── Demo Mode (set true to seed test users/content on boot) ──
DEMO_MODE=false
SEED_DEMO_DATA=false

# ── Gateway ───────────────────────────────────────────────────
GATEWAY_PORT=3013

# ── Frontend Ports ────────────────────────────────────────────
WEB_PORT=4000
ADMIN_PORT=4016
CREATOR_PORT=4014

# ── Frontend URLs ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://app.azeeboplus.com
NEXT_PUBLIC_WS_URL=wss://app.azeeboplus.com
ALLOWED_ORIGINS=https://app.azeeboplus.com,https://admin.azeeboplus.com,https://creator.azeeboplus.com

# ── Payment (Paystack) ───────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME
WEBHOOK_SECRET=CHANGE_ME

# ── Payment (Flutterwave) ────────────────────────────────────
FLW_SECRET_KEY=FLWSECK_CHANGE_ME
FLW_WEBHOOK_SECRET=CHANGE_ME

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@azeeboplus.com

# ── Notifications ────────────────────────────────────────────
SENDGRID_API_KEY=SG.CHANGE_ME
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# ── AWS (S3 / Media) ─────────────────────────────────────────
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET=azeebo-media-prod

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=azeebo-platform
LOG_LEVEL=info

# ── Service-specific DB Passwords ────────────────────────────
# Defaults to POSTGRES_PASSWORD if not set
# AUTH_DB_PASSWORD=
# USER_DB_PASSWORD=
# WALLET_DB_PASSWORD=
# PAYMENT_DB_PASSWORD=

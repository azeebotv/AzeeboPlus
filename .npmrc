# Allow build scripts for trusted packages
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=@nestjs/core
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=bcrypt
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=msgpackr-extract
onlyBuiltDependencies[]=protobufjs
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver

# Hoist all deps to root node_modules so services can resolve
# transitive deps (e.g. body-parser from @nestjs/platform-express)
shamefully-hoist=true

// === From services/core/payment-service/generated/prisma/generated/prisma/client/schema.prisma ===
model Payment {
  id            String    @id @default(cuid())
  userId        String
  amount        Decimal   @db.Decimal(18, 2)
  currency      String    @default("NGN")
  status        String    @default("pending")
  type          String    @default("payment")
  provider      String?
  providerRef   String?
  failureReason String?
  refundAmount  Decimal?  @db.Decimal(18, 2)
  metadata      Json?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, providerRef])
  @@index([userId])
  @@index([status])
  @@index([providerRef])
  @@map("payments")
}
model WebhookEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  provider      String
  type          String
  payload       Json
  result        String   @default("success")
  failureReason String?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([type])
  @@index([provider])
  @@index([result])
  @@map("webhook_events")
}
model WebhookRetry {
  id          String   @id @default(cuid())
  eventId     String
  provider    String
  type        String
  payload     Json
  retryCount  Int      @default(0)
  maxRetries  Int      @default(5)
  nextRetryAt DateTime
  status      String   @default("pending") // pending, processing, failed, completed
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([provider])
  @@map("webhook_retries")
}
model PaymentIntent {
  id                String    @id @default(cuid())
  userId            String
  amount            Decimal   @db.Decimal(18, 2)
  currency          String    @default("NGN")
  status            String    @default("pending")
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  idempotencyKey    String?   @unique
  refundAmount      Decimal?  @db.Decimal(18, 2)

  refunds Refund[]

  @@index([userId])
  @@index([providerReference])
  @@index([status])
  @@index([idempotencyKey])
  @@map("payment_intents")
}
model Refund {
  id                String   @id @default(cuid())
  paymentIntentId   String
  amount            Decimal  @db.Decimal(18, 2)
  reason            String
  status            String   @default("pending")
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  idempotencyKey    String?  @unique

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("refunds")
}
model PaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  provider      String // paystack, flutterwave
  providerToken String // provider-side tokenization reference
  type          String // card, bank_account, ussd
  brand         String? // visa, mastercard, verve
  last4         String?
  expiryMonth   Int?
  expiryYear    Int?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider, providerToken])
  @@index([userId])
  @@index([provider])
  @@index([isDefault])
  @@map("payment_methods")
}


  id            String    @id @default(uuid())
  userId        String
  unlockType    String // rental, pass, screening, locked_extra
  resourceId    String
  transactionId String?
  price         Decimal?  @db.Decimal(18, 2)
  currency      String    @default("NGN")
  unlockedAt    DateTime  @default(now())
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, unlockType, resourceId])
  @@index([userId])
  @@index([unlockType])
  @@index([resourceId])
  @@map("user_unlocks")
}

model VerificationDocument {
  id          String   @id @default(uuid())
  userId      String
  documentType String
  documentUrl String
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("verification_documents")
  @@index([userId])
}

model ViewingWindow {
  id        String    @id @default(uuid())
  movieId   String
  startsAt  DateTime
  endsAt    DateTime?
  type      String // standard, premium, premiere, special
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([type])
  @@index([isActive])
  @@map("viewing_windows")
}

model Vote {
  id           String   @id @default(uuid())
  userId       String
  contestantId String
  showId       String
  episodeId    String?
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  contestant Contestant  @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  show       RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  episode    Episode?    @relation(fields: [episodeId], references: [id])

  @@unique([userId, contestantId])
  @@index([userId])
  @@index([contestantId])
  @@index([showId])
  @@index([episodeId])
  @@map("reality_votes")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @db.Decimal(18, 2) @default(0)
  bonusBalance Decimal  @db.Decimal(18, 2) @default(0)
  promoBalance Decimal  @db.Decimal(18, 2) @default(0)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletSnapshot {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallet_snapshots")
  @@index([userId])
}

model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String
  type         String
  amount       Decimal  @db.Decimal(18, 2)
  status       String
  description  String?
  reference    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([walletId, type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model WalletTransactionSnapshot {
  id          String   @id @default(uuid())
  walletId    String
  type        String   // credit, debit
  amount      Decimal  @db.Decimal(18, 2)
  description String
  reference   String?
  createdAt   DateTime @default(now())

  @@map("wallet_transaction_snapshots")
  @@index([walletId])
  @@index([type])
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watch_history")
  @@unique([userId, contentId])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@map("watchlist_items")
}

model WebhookEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  provider      String
  type          String
  payload       Json
  result        String   @default("success")
  failureReason String?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([type])
  @@index([provider])
  @@index([result])
  @@map("webhook_events")
}

model WebhookRetry {
  id          String   @id @default(cuid())
  eventId     String
  provider    String
  type        String
  payload     Json
  retryCount  Int      @default(0)
  maxRetries  Int      @default(5)
  nextRetryAt DateTime
  status      String   @default("pending") // pending, processing, failed, completed
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([nextRetryAt])
  @@index([provider])
  @@map("webhook_retries")
}

model WorldMap {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  universeId  String
  type        String   @default("geographic") // geographic, spiritual, timeline
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([slug])
  @@index([type])
  @@map("world_maps")
}


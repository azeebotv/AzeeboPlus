generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SenderType {
  USER
  AGENT
  SYSTEM
}

enum SupportTicketCategory {
  REFUND
  CHARGEBACK
  ACCOUNT_APPEAL
  CONTENT_TAKEDOWN
  PAYOUT_DISPUTE
  USER_SUSPENSION
  GENERAL
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_INFO
  RESOLVED
  CLOSED
  ESCALATED
}

enum UserRole {
  user
  creator
  admin
  super_admin
}

model Appeal {
  id               String    @id @default(uuid())
  caseId           String
  userId           String
  reason           String
  status           String // pending, in_review, successful, rejected
  resolvedBy       String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

model Artifact {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  universeId  String
  type        String   @default("physical") // physical, spiritual, ancestral
  power       String? // description of the artifact's power
  origin      String? // where the artifact came from
  status      String   @default("active")
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([slug])
  @@index([type])
  @@map("artifacts")
}

model AudienceSegment {
  id          String   @id @default(uuid())
  name        String
  description String?
  segmentType String // behavioral, demographic, firmographic
  criteria    Json
  size        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("audience_segments")
}

model AuditEvent {
  id             String    @id @default(uuid())
  action         String // create, update, delete, review, resolve, appeal, scan
  resourceType   String // content, user, report, case, appeal, scan
  resourceId     String?
  actorId        String?
  actorType      String // user, moderator, system, api
  details        Json?
  previousState  Json?
  newState       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@map("audit_events")
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorType   String   @default("user") // user, system, api
  action      String   // create, update, delete, suspend, revoke, publish, approve, reject
  targetType  String   // user, content, report, payout, etc.
  targetId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model BalanceSnapshot {
  id           String   @id @default(uuid())
  walletId     String
  balance      Decimal  @db.Decimal(18, 2)
  bonusBalance Decimal  @db.Decimal(18, 2)
  promoBalance Decimal  @db.Decimal(18, 2)
  currency     String   @default("NGN")
  capturedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([capturedAt])
  @@map("balance_snapshots")
}

model Campaign {
  id          String    @id @default(uuid())
  name        String
  templateKey String
  channel     String // push, email, sms, in_app
  audience    Json // segment criteria
  status      String    @default("draft") // draft, scheduled, running, completed, cancelled
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  triggers CampaignTrigger[]

  @@index([templateKey])
  @@index([channel])
  @@map("campaigns")
}

model CampaignTrigger {
  id         String    @id @default(uuid())
  campaignId String
  userId     String
  status     String    @default("pending") // pending, sent, failed, skipped
  sentAt     DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId])
  @@map("campaign_triggers")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model CelebrityEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  bio         String?
  coverImage  String?
  profession  String?
  nationality String?
  birthDate   DateTime?
  socialLinks String?
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  status      String   @default("draft")
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news      CelebrityNews[]

  @@index([profession])
  @@index([isFeatured])
  @@index([createdById])
}

model CelebrityNews {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  celebrityId String
  status      String   @default("draft")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  celebrity CelebrityEntry @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([celebrityId])
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String // daily, weekly, tournament
  points      Int      @default(10)
  status      String   @default("active")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("challenges")
  @@index([type])
}

model ChallengeEntry {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  contentUrl  String
  createdAt   DateTime @default(now())

  challenge CreatorChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("challenge_entries")
  @@index([userId])
}

model ChallengePrize {
  id          String   @id @default(uuid())
  challengeId String
  rank        Int
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  challenge ComedyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("challenge_prizes")
}

model ChallengeSubmission {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  content     String
  mediaUrl    String?
  status      String   @default("pending") // pending, approved, rejected
  votes       Int      @default(0)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge     Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeVotes ChallengeVote[]

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

model ChallengeVote {
  id           String   @id @default(uuid())
  userId       String
  submissionId String
  createdAt    DateTime @default(now())

  submission ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
  @@index([submissionId])
  @@index([userId])
}

model Channel {
  id          String   @id @default(uuid())
  creatorId   String
  name        String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("channels")
  @@index([creatorId])
}

model Chapter {
  id          String   @id @default(uuid())
  titleId     String
  number      Float
  name        String?
  description String?
  coverImage  String?
  content     String?
  wordCount   Int?
  status      String   @default("published")
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  title       Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@map("chapters")
}

model Character {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  role        String?
  status      String   @default("active")
  universeId  String
  birthDate   DateTime?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  locations   CharacterLocation[]
  relationshipsFrom CharacterRelationship[] @relation("CharacterFrom")
  relationshipsTo   CharacterRelationship[] @relation("CharacterTo")
  timeline    TimelineEvent[]

  @@index([universeId])
  @@index([slug])
  @@map("characters")
}

model CharacterLocation {
  id          String   @id @default(uuid())
  characterId String
  locationId  String
  role        String?
  description String?
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([characterId, locationId])
  @@index([characterId])
  @@index([locationId])
  @@map("character_locations")
}

model CharacterRelationship {
  id          String   @id @default(uuid())
  fromId      String
  toId        String
  type        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  from   Character @relation("CharacterFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Character @relation("CharacterTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([type])
  @@map("character_relationships")
}

model Chargeback {
  id              String   @id @default(uuid())
  ticketId        String   @unique
  paymentId       String
  userId          String
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   @default("NGN")
  reason          String
  status          String   @default("PENDING")
  disputeDeadline DateTime
  evidenceDue     DateTime
  chargebackRef   String?
  resolution      String?
  resolvedAt      DateTime?
  resolvedBy      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentId])
  @@map("chargebacks")
}

model ChurnRisk {
  id               String    @id @default(uuid())
  userId           String    @unique
  riskLevel        String // low, medium, high, critical
  churnProbability Float     @default(0)
  factors          Json // Contributing factors
  lastActivityAt   DateTime?
  predictedChurnAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("churn_risks")
}

model CinemaPass {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String // monthly, yearly, premium
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions CinemaPassSubscription[]

  @@map("cinema_passes")
}

model CinemaPassSubscription {
  id              String    @id @default(uuid())
  userId          String
  passId          String
  status          String    @default("active") // active, cancelled, expired
  startDate       DateTime
  endDate         DateTime
  autoRenew       Boolean   @default(true)
  paymentIntentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pass CinemaPass @relation(fields: [passId], references: [id])

  @@unique([userId, passId])
  @@index([userId])
  @@index([passId])
  @@index([paymentIntentId])
  @@map("cinema_pass_subscriptions")
}

model CityGuideEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String
  description String
  coverImage  String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  rating      Float?
  priceLevel  Int?
  hours       String?
  phone       String?
  website     String?
  amenities   String[]
  status      String   @default("draft")
  viewCount   Int      @default(0)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags      CityGuideTag[]

  @@index([type])
  @@index([city])
  @@index([createdById])
}

model CityGuideTag {
  id      String @id @default(uuid())
  name    String @unique
  slug    String @unique
  entries CityGuideEntry[]
}

model ClipComment {
  id        String   @id @default(uuid())
  userId    String
  clipId    String
  text      String
  createdAt DateTime @default(now())

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clipId])
  @@map("clip_comments")
}

model ClipLike {
  id        String   @id @default(uuid())
  userId    String
  clipId    String
  createdAt DateTime @default(now())

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([userId, clipId])
  @@index([userId])
  @@index([clipId])
  @@map("clip_likes")
}

model ClipShare {
  id        String   @id @default(uuid())
  userId    String
  clipId    String
  platform  String?
  createdAt DateTime @default(now())

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clipId])
  @@map("clip_shares")
}

model Cohort {
  id          String   @id @default(uuid())
  name        String
  description String?
  criteria    Json // JSON criteria for cohort membership
  size        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cohorts")
}

model CohortMember {
  id       String   @id @default(uuid())
  cohortId String
  userId   String
  joinedAt DateTime @default(now())

  @@unique([cohortId, userId])
  @@map("cohort_members")
}

model ComedianProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clips    ComedyClip[]
  specials ComedySpecial[]

  @@map("comedian_profiles")
}

model ComedyChallenge {
  id          String    @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prizes  ChallengePrize[]
  entries ComedyChallengeEntry[]
  @@map("comedy_challenges")
}

model ComedyChallengeEntry {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  clipUrl     String
  createdAt   DateTime @default(now())

  challenge ComedyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@map("comedy_challenge_entries")
}

model ComedyClip {
  id          String   @id @default(uuid())
  comedianId  String?
  creatorId   String
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  viewCount   Int      @default(0)
  shareCount  Int      @default(0)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comedian ComedianProfile? @relation(fields: [comedianId], references: [id], onDelete: Cascade)
  shares   ClipShare[]
  likes    ClipLike[]
  comments ClipComment[]
  trends   ComedyTrend[]

  @@index([comedianId])
  @@index([creatorId])
  @@map("comedy_clips")
}

model ComedyEpisode {
  id          String   @id @default(uuid())
  seriesId    String
  title       String
  description String?
  thumbnail   String?
  mediaUrl    String?
  duration    Int?
  viewCount   Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series ComedySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@map("comedy_episodes")
}

model ComedySeries {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  banner      String?
  creatorId   String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes ComedyEpisode[]

  @@index([creatorId])
  @@map("comedy_series")
}

model ComedySpecial {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  duration    Int?
  comedianId  String
  genre       String?
  isPremium   Boolean  @default(true)
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comedian ComedianProfile? @relation(fields: [comedianId], references: [id], onDelete: Cascade)
  likes    SpecialLike[]

  @@index([comedianId])
  @@index([isPremium])
  @@map("comedy_specials")
}

model ComedyTrend {
  id        String   @id @default(uuid())
  clipId    String
  score     Float    @default(0)
  rank      Int
  period    String   @default("daily")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([clipId, period])
  @@index([clipId])
  @@map("comedy_trends")
}

model Comment {
  id        String   @id @default(uuid())
  contentId String
  userId    String
  text      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Content {
  id        String   @id @default(uuid())
  title     String?
  type      String?
  status    String?  @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@map("contents")
}

model ContentItem {
  id            String   @id @default(uuid())
  title         String
  description   String?
  thumbnail     String
  mediaUrl      String?
  universeId    String
  creatorId     String
  status        String
  viewCount     Int      @default(0)
  metadata      Json?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  releaseDate   DateTime?
  theatricalReleaseDate DateTime?
  streamingReleaseDate DateTime?
  windowEndDate DateTime?
  windowType    String   @default("standard")
  isExclusive   Boolean  @default(false)
  isPremiere    Boolean  @default(false)

  universe    Universe    @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator     User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset?
  categories  Category[]
  tags        Tag[]
  relationshipsAsContent ContentRelationship[] @relation("ContentRelationshipContent")
  relationshipsAsRelatedContent ContentRelationship[] @relation("ContentRelationshipRelatedContent")

  @@index([creatorId])
  @@index([status])
  @@index([universeId])
  @@index([creatorId, status])
  @@index([createdAt])
  @@map("content_items")
}

model ContentRelationship {
  id            String   @id @default(uuid())
  contentId     String
  relatedContentId String
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  content       ContentItem @relation("ContentRelationshipContent", fields: [contentId], references: [id], onDelete: Cascade)
  relatedContent ContentItem @relation("ContentRelationshipRelatedContent", fields: [relatedContentId], references: [id], onDelete: Cascade)

  @@map("content_relationships")
  @@unique([contentId, relatedContentId])
}

model ContentTakedown {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  contentId   String
  reportedBy  String
  reason      String
  evidence    Json?
  status      String   @default("PENDING")
  decision    String?
  decidedAt   DateTime?
  decidedBy   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("content_takedowns")
}

model Contest {
  id          String    @id @default(uuid())
  eventId     String
  title       String
  description String?
  entryFee Decimal     @default(0) @db.Decimal(18, 2)
  prizePool Decimal  @db.Decimal(18, 2)
  status      String    @default("active")
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event   SportsEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizes  ContestPrize[]
  entries ContestEntry[]

  @@map("contests")
  @@index([eventId])
  @@index([startsAt])
  @@index([endsAt])
}

model ContestEntry {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  entryData Json
  score     Int      @default(0)
  createdAt DateTime @default(now())

  contest       Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  SportsEvent   SportsEvent? @relation(fields: [sportsEventId], references: [id])
  sportsEventId String?

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@index([score])
  @@index([sportsEventId])
  @@map("contest_entries")
}

model ContestPrize {
  id        String   @id @default(uuid())
  contestId String
  rank      Int
  amount Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("contest_prizes")
  @@index([contestId])
}

model Contestant {
  id          String   @id @default(uuid())
  showId      String
  name        String
  description String?
  thumbnail   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  show        RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  votes       Vote[]
  supervotes  Supervote[]
  predictions Prediction[]

  @@map("reality_contestants")
  @@index([showId])
}

model Conversation {
  id        String   @id @default(uuid())
  type      String   @default("direct")
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@index([createdAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

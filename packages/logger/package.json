{
  "name": "@azeebo/logger",
  "version": "1.0.0",
  "private": true,
  "description": "Structured logging utilities for Azeebo+ services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azeebo/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@opentelemetry/api": "^1.9.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/core": "^11.1.27",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27"
  }

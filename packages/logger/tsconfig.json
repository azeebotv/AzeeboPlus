{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2020"
    ],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@azeebo/shared-types": ["../shared-types/dist"],
      "@azeebo/shared-types/*": ["../shared-types/dist/*"],
      "@azeebo/security/log-redaction": ["../security/dist/log-redaction/index.d.ts"]
    },
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

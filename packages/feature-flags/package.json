{
  "name": "@azeebo/feature-flags",
  "version": "1.1.0",
  "private": true,
  "description": "Feature flag system for Azeebo+ services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./registries": {
      "types": "./dist/registries.d.ts",
      "import": "./dist/registries.js",
      "require": "./dist/registries.js",
      "default": "./dist/registries.js"
    },
    "./package.json": "./package.json",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "bash ../../scripts/build-package.sh",
    "clean": "rm -rf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint src"
  },
  "dependencies": {
    "@azeebo/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27"
  }
}

{
  "name": "@azeebo/test-utils",
  "version": "1.0.0",
  "private": true,
  "description": "Shared testing utilities for Azeebo services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/testing": "^11.1.27",
    "@prisma/client": "^6.19.0",
    "ioredis-mock": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.8.4"
  }
}

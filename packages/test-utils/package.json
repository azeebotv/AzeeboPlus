{
  "name": "@azeebo/test-utils",
  "version": "1.0.0",
  "private": true,
  "description": "Shared testing utilities for Azeebo services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "test": "jest --passWithNoTests",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "ioredis-mock": "^8.13.1"
  },
  "peerDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  }
}

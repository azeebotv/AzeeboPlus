{
  "name": "@azeebo/react-data",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ shared React Native data layer — API services, auth/flags/wallet contexts, query + storage hooks, and platform-agnostic utils. Consumed by apps/mobile and apps/tv so the two surfaces cannot drift.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bash ../../scripts/build-package.sh",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azeebo/analytics-sdk": "workspace:*",
    "@azeebo/api-client": "workspace:*",
    "@azeebo/design-tokens": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "expo-constants": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-secure-store": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "~0.85.0"
  }
}

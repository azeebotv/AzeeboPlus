{
  "name": "@azeebo/internal-clients",
  "version": "1.0.0",
  "private": true,
  "description": "Typed internal service clients with retries, timeouts, and idempotency",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "lint": "eslint src --fix",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@azeebo/http-client": "workspace:*",
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  }
}

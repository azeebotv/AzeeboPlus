{
  "name": "@azeebo/flag-metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Prometheus sinks for feature-flag observability (flag_evaluation_total / flag_toggled_total) shared by every Azeebo+ service",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bash ../../scripts/build-package.sh",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/security": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "axios": "^1.18.0",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/swagger": "^11.4.4"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  }
}

{
  "name": "@azeebo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ UI components",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/mobile-index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist"

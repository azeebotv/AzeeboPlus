    "./mobile": "./src/mobile-index.ts"
  },
  "dependencies": {
    "@azeebo/design-tokens": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react-native": "^0.76.5"
  }
}
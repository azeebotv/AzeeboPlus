generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Outbox Pattern (TAA §15, ADR-006)
// ============================================================================

/// Transactional Outbox - stores events that need to be published.
/// Business state + outbox record are written in the same transaction.
model OutboxEntry {
  id            String   @id @default(uuid())
  aggregateType String   // "user", "content", "payment", etc.
  aggregateId   String   // ID of the aggregate
  eventType     String   // "user.created", "content.published", etc.
  payload       Json     // Event payload
  metadata      Json?    // Additional metadata (correlationId, causationId, etc.)
  status        String   @default("pending") // "pending", "published", "failed"
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  createdAt     DateTime @default(now())
  publishedAt   DateTime?
  lastError     String?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_entries")
}

// ============================================================================
// Event Log - durable record of published events
// ============================================================================

/// Event Log - durable record of all published events for replay and audit.
model EventLog {
  id              String   @id @default(uuid())
  eventId         String   @unique // UUID of the event
  eventType       String
  eventVersion    Int      @default(1)
  producer        String   // Service that produced the event
  subjectId       String?  // Opaque entity/user/content key
  correlationId   String?  // Trace/business correlation
  causationId     String?  // Prior event/request ID
  payload         Json     // Minimal business data
  schemaRef       String?  // Schema/contract identifier
  aggregateType   String?  // For aggregate ordering
  aggregateId     String?  // For aggregate ordering
  sequenceNumber  Int?     // For aggregate ordering
  occurredAt      DateTime
  publishedAt     DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([aggregateType, aggregateId, sequenceNumber])
  @@index([correlationId])
  @@map("event_logs")
}

  },
  "dependencies": {
    "@azeebo/http-client": "workspace:*",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1"
  }
}

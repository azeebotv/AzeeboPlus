{
  "name": "@azeebo/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utility functions for Azeebo+",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {

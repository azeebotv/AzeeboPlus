{
  "name": "@azeebo/contract-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Pact contract tests for Azeebo+ API consumers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:contracts": "jest --testMatch='**/*.pact.spec.ts' --passWithNoTests"
  },
  "dependencies": {
    "@pact-foundation/pact": "^13.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4",
    "underscore": "^1.13.8"
  }
}

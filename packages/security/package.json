{
  "name": "@azeebo/security",
  "version": "1.0.0",
  "private": true,
  "description": "Shared security utilities for Azeebo+ services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bash ../../scripts/build-package.sh",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e:security": "RUN_SECURITY_E2E=1 jest --config jest.e2e.config.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "clean": "rm -rf dist",
    "lint": "eslint src"
  },
  "dependencies": {
    "@azeebo/shared-types": "workspace:*",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@prisma/client": "^6.12.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "prisma": "^6.12.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4"
  }
}

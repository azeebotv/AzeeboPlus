    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/passport": "^11.0.5",
    "@prisma/client": "^6.19.3",
    "ioredis": "^5.11.1",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "prisma": "^6.19.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1"

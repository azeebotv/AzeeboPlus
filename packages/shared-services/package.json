{
  "name": "@azeebo/shared-services",
  "version": "0.1.0",
  "private": true,
  "description": "Shared services for Azeebo+ backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prebuild": "prisma generate --schema=prisma/schema.prisma",
    "build": "bash ../../scripts/build-package.sh",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^6.19.3",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nestjs": "^9.47.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.0.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "twilio": "^6.0.2"

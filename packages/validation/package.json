{
  "name": "@azeebo/validation",
  "version": "1.0.0",
  "private": true,
  "description": "Shared validation utilities for Azeebo+ services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bash ../../scripts/build-package.sh",

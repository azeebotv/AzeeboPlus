{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@azeebo/*": ["./packages/*/dist"],
      "@azeebo/ui": ["./packages/ui/dist"],
      "@azeebo/ui/*": ["./packages/ui/dist/*"],
      "@azeebo/design-tokens": ["./packages/design-tokens/dist"],
      "@azeebo/design-tokens/*": ["./packages/design-tokens/dist/*"],
      "@azeebo/analytics-sdk": ["./packages/analytics-sdk/dist"],
      "@azeebo/analytics-sdk/*": ["./packages/analytics-sdk/dist/*"],
      "@azeebo/api-client": ["./packages/api-client/dist"],
      "@azeebo/api-client/*": ["./packages/api-client/dist/*"],
      "@azeebo/shared-types": ["./packages/shared-types/dist"],
      "@azeebo/shared-types/*": ["./packages/shared-types/dist/*"],
      "@azeebo/utils": ["./packages/utils/dist"],
      "@azeebo/utils/*": ["./packages/utils/dist/*"],
      "@azeebo/shared-services": ["./packages/shared-services/dist"],
      "@azeebo/shared-services/*": ["./packages/shared-services/dist/*"],
      "@azeebo/shared-queue": ["./packages/shared-queue/dist"],
      "@azeebo/auth": ["./packages/auth/dist/index.js"],
      "@azeebo/contract-tests": ["./packages/contract-tests/dist"],
      "@azeebo/security": ["./packages/security/dist/index.js"],
      "@azeebo/observability": ["./packages/observability/dist/index.js"],
      "@azeebo/opentelemetry": ["./packages/opentelemetry/dist/index.js"],
      "@azeebo/feature-flags": ["./packages/feature-flags/dist/index.js"],
      "@azeebo/http-client": ["./packages/http-client/dist/index.js"],
      "@azeebo/http-client/*": ["./packages/http-client/dist/*"],
      "@azeebo/internal-clients": ["./packages/internal-clients/dist/index.js"],
      "@azeebo/logger": ["./packages/logger/dist/index.js"],
      "@azeebo/error-handling": ["./packages/error-handling/dist/index.js"],
      "@azeebo/event-bus": ["./packages/event-bus/dist"],
      "@azeebo/validation": ["./packages/validation/dist/index.js"],
      "@azeebo/test-utils": ["./packages/test-utils/dist/index.js"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "**/*.e2e.ts",
    "**/*.e2e.tsx",
    "**/detox.setup.ts",
    "**/detox.setup.js",
    "**/e2e/**",
    "apps/web/e2e/**",
    "apps/mobile/e2e/**",
    "apps/mobile/app/**",
    "apps/mobile/src/**",
    "services/gateway/api-gateway/src/app.e2e-spec.ts"
  ]
}

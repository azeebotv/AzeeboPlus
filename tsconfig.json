{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "jsx": "react",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [],
    "paths": {
      "@azeebo/ui": ["./packages/ui/src"],
      "@azeebo/ui/*": ["./packages/ui/src/*"],
      "@azeebo/design-tokens": ["./packages/design-tokens/src"],
      "@azeebo/design-tokens/*": ["./packages/design-tokens/src/*"],
      "@azeebo/analytics-sdk": ["./packages/analytics-sdk/src"],
      "@azeebo/analytics-sdk/*": ["./packages/analytics-sdk/src/*"],
      "@azeebo/api-client": ["./packages/api-client/src"],
      "@azeebo/api-client/*": ["./packages/api-client/src/*"],
      "@azeebo/shared-types": ["./packages/shared-types/src"],
      "@azeebo/shared-types/*": ["./packages/shared-types/src/*"],
      "@azeebo/utils": ["./packages/utils/src"],
      "@azeebo/utils/*": ["./packages/utils/src/*"],
      "@azeebo/shared-services": ["./packages/shared-services/src"],
      "@azeebo/shared-services/*": ["./packages/shared-services/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "**/*.e2e.ts",
    "**/*.e2e.tsx",
    "**/detox.setup.ts",
    "**/detox.setup.js",
    "**/e2e/**",
    "apps/web/e2e/**",
    "apps/mobile/e2e/**",
    "services/gateway/api-gateway/src/app.e2e-spec.ts"
  ]
}

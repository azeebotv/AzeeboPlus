{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["multer"],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@azeebo/ui": ["./packages/ui/src"],
      "@azeebo/ui/*": ["./packages/ui/src/*"],
      "@azeebo/design-tokens": ["./packages/design-tokens/src"],
      "@azeebo/design-tokens/*": ["./packages/design-tokens/src/*"],
      "@azeebo/analytics-sdk": ["./packages/analytics-sdk/src"],
      "@azeebo/analytics-sdk/*": ["./packages/analytics-sdk/src/*"],
      "@azeebo/api-client": ["./packages/api-client/src"],
      "@azeebo/api-client/*": ["./packages/api-client/src/*"],
      "@azeebo/shared-types": ["./packages/shared-types/src"],
      "@azeebo/shared-types/*": ["./packages/shared-types/src/*"],
      "@azeebo/utils": ["./packages/utils/src"],
      "@azeebo/utils/*": ["./packages/utils/src/*"],
      "@azeebo/shared-services": ["./packages/shared-services/src"],
      "@azeebo/shared-services/*": ["./packages/shared-services/src/*"],
      "@azeebo/shared-queue": ["./packages/shared-queue/src"],
      "@azeebo/auth": ["./packages/auth/src/index.ts"],
      "@azeebo/contract-tests": ["./packages/contract-tests/src"],
      "@azeebo/security": ["./packages/security/src/index.ts"],
      "@azeebo/observability": ["./packages/observability/src/index.ts"],
      "@azeebo/opentelemetry": ["./packages/opentelemetry/src/index.ts"],
      "@azeebo/feature-flags": ["./packages/feature-flags/src/index.ts"],
      "@azeebo/http-client": ["./packages/http-client/src/index.ts"],
      "@azeebo/http-client/*": ["./packages/http-client/src/*"],
      "@azeebo/internal-clients": ["./packages/internal-clients/src/index.ts"],
      "@azeebo/logger": ["./packages/logger/src/index.ts"],
      "@azeebo/error-handling": ["./packages/error-handling/src/index.ts"],
      "@azeebo/event-bus": ["./packages/event-bus/src"],
      "@azeebo/validation": ["./packages/validation/src/index.ts"],
      "@azeebo/test-utils": ["./packages/test-utils/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "**/*.e2e.ts",
    "**/*.e2e.tsx",
    "**/detox.setup.ts",
    "**/detox.setup.js",
    "**/e2e/**",
    "apps/web/e2e/**",
    "apps/mobile/e2e/**",
    "apps/mobile/app/**",
    "apps/mobile/src/**",
    "services/gateway/api-gateway/src/app.e2e-spec.ts"
  ]
}

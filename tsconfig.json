{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ],
      "@azeebo/*": [
        "./packages/*/dist"
      ],
      "@azeebo/ui": [
        "./packages/ui/dist"
      ],
      "@azeebo/ui/*": [
        "./packages/ui/dist/*"
      ],
      "@azeebo/design-tokens": [
        "./packages/design-tokens/dist"
      ],
      "@azeebo/design-tokens/*": [
        "./packages/design-tokens/dist/*"
      ],
      "@azeebo/analytics-sdk": [
        "./packages/analytics-sdk/dist"
      ],
      "@azeebo/analytics-sdk/*": [
        "./packages/analytics-sdk/dist/*"
      ],
      "@azeebo/api-client": [
        "./packages/api-client/dist"
      ],
      "@azeebo/api-client/*": [
        "./packages/api-client/dist/*"
      ],
      "@azeebo/shared-types": [
        "./packages/shared-types/dist"
      ],
      "@azeebo/shared-types/*": [
        "./packages/shared-types/dist/*"
      ],
      "@azeebo/utils": [
        "./packages/utils/dist"
      ],
      "@azeebo/utils/*": [
        "./packages/utils/dist/*"
      ],
      "@azeebo/shared-services": [
        "./packages/shared-services/dist"
      ],
      "@azeebo/shared-services/*": [
        "./packages/shared-services/dist/*"
      ],
      "@azeebo/shared-queue": [
        "./packages/shared-queue/dist"
      ],
      "@azeebo/auth": [
        "./packages/auth/dist"
      ],
      "@azeebo/contract-tests": [
        "./packages/contract-tests/dist"
      ],
      "@azeebo/security": [
        "./packages/security/dist"
      ],
      "@azeebo/observability": [
        "./packages/observability/dist"
      ],
      "@azeebo/opentelemetry": [
        "./packages/opentelemetry/dist"
      ],
      "@azeebo/feature-flags": [
        "./packages/feature-flags/dist"
      ],
      "@azeebo/http-client": [
        "./packages/http-client/dist"
      ],
      "@azeebo/http-client/*": [
        "./packages/http-client/dist/*"
      ],
      "@azeebo/internal-clients": [
        "./packages/internal-clients/dist"
      ],
      "@azeebo/logger": [
        "./packages/logger/dist"
      ],
      "@azeebo/error-handling": [
        "./packages/error-handling/dist"
      ],
      "@azeebo/event-bus": [
        "./packages/event-bus/dist"
      ],
      "@azeebo/validation": [
        "./packages/validation/dist"
      ],
      "@azeebo/test-utils": [
        "./packages/test-utils/dist"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "**/*.e2e.ts",
    "**/*.e2e.tsx",
    "**/detox.setup.ts",
    "**/detox.setup.js",
    "**/e2e/**",
    "apps/web/e2e/**",
    "apps/mobile/e2e/**",
    "apps/mobile/app/**",
    "apps/mobile/src/**",
    "services/gateway/api-gateway/src/app.e2e-spec.ts",
    "apps/admin/client/**",
    "apps/creator/client/**",
    "prisma/seed/**"
  ]
}

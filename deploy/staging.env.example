# ============================================================
# Azeebo+ Staging Environment
# ============================================================
# WARNING: This file contains sensitive configuration.
# Never commit to version control. Use environment injection in CI/CD.
# Generated for staging deployment: 2026-07-22

# ---- Node Environment ----
NODE_ENV=staging
LOG_LEVEL=info

# ---- PostgreSQL ----
POSTGRES_USER=azeebo_staging
POSTGRES_PASSWORD=<set-via-secrets-manager>
POSTGRES_DB=azeebo_staging

# ---- Redis ----
REDIS_PASSWORD=<set-via-secrets-manager>
REDIS_URL=redis://:<set-via-secrets-manager>@redis-staging.internal:6379

# ---- Per-Service Database Passwords (26 databases) ----
AUTH_DB_PASSWORD=<set-via-secrets-manager>

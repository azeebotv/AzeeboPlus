# ---- JWT Secrets (64 characters minimum) ----
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=<set-via-secrets-manager>
JWT_REFRESH_SECRET=<set-via-secrets-manager>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Inter-Service Auth ----
INTERNAL_API_KEY=<set-via-secrets-manager>

# ---- Gateway Secret (shared between gateway and all services) ----
GATEWAY_SECRET=<set-via-secrets-manager>

# ---- Payment Gateways ----
PAYSTACK_PUBLIC_KEY=pk_test_staging_placeholder
PAYSTACK_SECRET_KEY=sk_test_staging_<set-via-secrets-manager>
PAYSTACK_WEBHOOK_SECRET=whsec_staging_<set-via-secrets-manager>
FLW_PUBLIC_KEY=FLWPUBK_TEST_staging_placeholder
FLW_SECRET_KEY=FLWSECK_TEST_staging_<set-via-secrets-manager>
FLW_WEBHOOK_SECRET=whsec_staging_<set-via-secrets-manager>

# ---- AWS / Media ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<set-via-secrets-manager>
AWS_SECRET_ACCESS_KEY=<set-via-secrets-manager>
AWS_S3_BUCKET=azeebo-media-staging
AWS_CLOUDFRONT_DISTRIBUTION=<set-via-cloudformation>

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=SG.staging_<set-via-secrets-manager>
EMAIL_FROM=noreply@staging.azeebo.ng
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<set-via-secrets-manager>

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=<set-via-secrets-manager>
TWILIO_AUTH_TOKEN=<set-via-secrets-manager>
TWILIO_PHONE_NUMBER=+1234567890

# ---- External APIs ----
YOUTUBE_API_KEY=<set-via-secrets-manager>
TWITTER_API_KEY=<set-via-secrets-manager>
TWITTER_API_SECRET=<set-via-secrets-manager>
TWITTER_ACCESS_TOKEN=<set-via-secrets-manager>
TWITTER_ACCESS_TOKEN_SECRET=<set-via-secrets-manager>

# ---- Firebase (Authentication) ----
NEXT_PUBLIC_FIREBASE_API_KEY=<set-via-secrets-manager>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=azeebo-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=azeebo-staging

# ---- Sentry (Error Tracking) ----
SENTRY_DSN=https://<set-via-secrets-manager>@sentry.io/<set-via-secrets-manager>
NEXT_PUBLIC_SENTRY_DSN=https://<set-via-secrets-manager>@sentry.io/<set-via-secrets-manager>
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- CORS Origins (Staging) ----
CORS_ORIGIN=https://staging.azeebo.ng,https://www.staging.azeebo.ng,https://admin.staging.azeebo.ng
ALLOWED_ORIGINS=https://staging.azeebo.ng,https://www.staging.azeebo.ng,https://admin.staging.azeebo.ng

# ---- API & Deployment ----
NEXT_PUBLIC_API_URL=https://api.staging.azeebo.ng
NEXT_PUBLIC_BASE_URL=https://staging.azeebo.ng
NEXT_PUBLIC_AUTH_URL=https://auth.staging.azeebo.ng
SSL_DOMAIN=staging.azeebo.ng
DEMO_MODE=false
CLEAR_DB=false

# ---- Storyworld Default ----
STORYWORLD_DEFAULT_SLUG=agbala-olodumare

# ---- Feature Flags (Staging) ----
ENABLE_REALITY_UNIVERSE=true
ENABLE_VERTICAL_UNIVERSE=true
ENABLE_LIFESTYLE_UNIVERSE=true
ENABLE_COMEDY_UNIVERSE=true
ENABLE_SPORTS_UNIVERSE=true
ENABLE_GAMES_UNIVERSE=true
ENABLE_REWARDS_UNIVERSE=true

# ---- Pricing (NGN - Staging) ----
PRICING_CURRENCY=NGN
WALLET_FUND_MINIMUM=100
WALLET_FUND_MAXIMUM=1000000
WALLET_WITHDRAW_MINIMUM=500
WALLET_WITHDRAW_MAXIMUM=500000
WALLET_TRANSFER_MINIMUM=100
WALLET_TRANSFER_MAXIMUM=100000
CONTENT_PAY_PER_VIEW=500
SUBSCRIPTION_BASIC_PRICE=2000
SUBSCRIPTION_PREMIUM_PRICE=5000
SUBSCRIPTION_VIP_PRICE=10000
UNIVERSE_COMEDY_PRICE=300
UNIVERSE_REALITY_PRICE=500
UNIVERSE_MOVIE_PRICE=1000
UNIVERSE_SPORTS_PRICE=200
UNIVERSE_GAMES_PRICE=150
UNIVERSE_LIFESTYLE_PRICE=400
UNIVERSE_MUSIC_PRICE=250
SUPER_VOTE_PRICE=100
SUPER_VOTE_1_PRICE=100
SUPER_VOTE_5_PRICE=450
SUPER_VOTE_10_PRICE=800
SUPER_VOTE_50_PRICE=3500
PREDICTION_MIN_BET=100
PREDICTION_MAX_BET=100000

# ---- Service URLs (Internal) ----
ANALYTICS_SERVICE_URL=http://analytics-service.staging.internal:3008
SEARCH_SERVICE_URL=http://search-service.staging.internal:3005
NOTIFICATION_SERVICE_URL=http://notification-service.staging.internal:3006
RECOMMENDATION_SERVICE_URL=http://recommendation-service.staging.internal:3009
MEDIA_SERVICE_URL=http://media-service.staging.internal:3019
CONTENT_SERVICE_URL=http://content-service.staging.internal:3004

# ---- Infrastructure ----
DOCKER_REGISTRY=registry.azeebo.ng
DOCKER_IMAGE_PREFIX=azeebo
DEPLOY_ENV=staging

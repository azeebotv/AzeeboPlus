{
  "name": "@azeebo/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ API Gateway Service",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint 'src/**/*.ts' --fix",

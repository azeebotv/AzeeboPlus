# API Gateway Service
PORT=3000

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
WALLET_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
CONTENT_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
REWARD_SERVICE_URL=http://localhost:3007
SEARCH_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3009
MODERATION_SERVICE_URL=http://localhost:3010
RECOMMENDATION_SERVICE_URL=http://localhost:3011
CREATOR_SERVICE_URL=http://localhost:3012
LIFESTYLE_SERVICE_URL=http://localhost:3013
VERTICAL_SERVICE_URL=http://localhost:3014
QUEUE_SERVICE_URL=http://localhost:3015

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true
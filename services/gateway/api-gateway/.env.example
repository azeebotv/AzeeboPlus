# =============================================================================
# API Gateway Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_plus_dev
NODE_ENV=development
PORT=3013
SERVICE_NAME=api-gateway

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=rediss://localhost:6380

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Must match auth-service JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_AUDIENCE=azeebo-api
JWT_ISSUER=azeebo-auth

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
CONTENT_SERVICE_URL=http://localhost:3004
MEDIA_SERVICE_URL=http://localhost:3019
SEARCH_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
REWARD_SERVICE_URL=http://localhost:3007
ANALYTICS_SERVICE_URL=http://localhost:3008
RECOMMENDATION_SERVICE_URL=http://localhost:3009
CREATOR_SERVICE_URL=http://localhost:3018
CREATOR_APP_URL=http://localhost:4014
COMEDY_SERVICE_URL=http://localhost:3012
GAMES_SERVICE_URL=http://localhost:3014
LIFESTYLE_SERVICE_URL=http://localhost:3016
MOVIE_SERVICE_URL=http://localhost:3011
REALITY_SERVICE_URL=http://localhost:3010
SPORTS_SERVICE_URL=http://localhost:3021
VERTICAL_SERVICE_URL=http://localhost:3017
MODERATION_SERVICE_URL=http://localhost:3022
SUPPORT_SERVICE_URL=http://localhost:3028
QUEUE_SERVICE_URL=http://localhost:3015
MESSAGING_SERVICE_URL=http://localhost:3024
REFERRAL_SERVICE_URL=http://localhost:3025
ENGAGEMENT_SERVICE_URL=http://localhost:3023
SUBSCRIPTION_SERVICE_URL=http://localhost:3026
LIVE_EVENT_SERVICE_URL=http://localhost:3027
KNOWLEDGE_SERVICE_URL=http://localhost:3020
ADMIN_SERVICE_URL=http://localhost:4016
CREATOR_PORTAL_SERVICE_URL=http://localhost:4014

# -----------------------------------------------------------------------------
# Upstream Proxy
# -----------------------------------------------------------------------------
# AUD-21: per-request timeout for proxied internal calls (ms). Defaults to
# 5000 so a hung upstream cannot pin gateway workers for 30s; raise here for
# known-slow routes. Flows into the circuit-breaker budget.
UPSTREAM_TIMEOUT=5000

# -----------------------------------------------------------------------------
# Rate-limit failure posture (auth endpoints)
# -----------------------------------------------------------------------------
# AUD-20: fail-closed is the DEFAULT — when REDIS_URL is configured but Redis
# is unreachable, auth requests (login/register/otp/forgot/reset) are rejected
# instead of degrading to per-instance in-memory buckets (limit × replica count).
# Set to false to restore fail-open degradation. No REDIS_URL = in-memory store
# is used as before (dev/single-instance unaffected).
RATE_LIMIT_FAIL_CLOSED=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4016,http://localhost:4014

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# Gateway shared secret (must match gateway's GATEWAY_SECRET)
# Generate with: openssl rand -base64 48
GATEWAY_SECRET=

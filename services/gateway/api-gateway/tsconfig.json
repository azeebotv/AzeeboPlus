{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "types": ["jest", "node", "supertest"],
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "paths": {
      "@azeebo/*": ["../../../packages/*/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
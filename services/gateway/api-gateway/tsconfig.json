{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "jest",
      "node",
      "supertest"
    ],
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "paths": {
      "@azeebo/*": [
        "../../../packages/*/dist"
      ]
    },
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "Node16"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

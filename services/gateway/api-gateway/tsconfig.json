{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "jest",
      "node",
      "supertest"
    ],
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

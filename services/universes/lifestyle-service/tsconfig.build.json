{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@azeebo/*": [
        "../../../packages/*/dist"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "rootDir": "src",
    "incremental": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

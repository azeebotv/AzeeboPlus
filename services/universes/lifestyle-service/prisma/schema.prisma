generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

// Stub model for cross-service references
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model CultureStory {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  categoryId  String?
  authorId    String
  status      String   @default("draft")
  viewCount   Int      @default(0)
  readTime    Int?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    StoryCategory? @relation(fields: [categoryId], references: [id])
  comments    StoryComment[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
}

model StoryCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  description String?
  stories   CultureStory[]

  @@index([slug])
}

model StoryComment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  storyId   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story     CultureStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parent    StoryComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   StoryComment[] @relation("CommentReplies")

  @@index([storyId])
  @@index([authorId])
  @@index([parentId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  coverImage  String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  venue        String?
  isOnline    Boolean  @default(false)
  onlineLink  String?
  maxAttendees Int?
  status      String   @default("draft")
  categoryId  String?
  creatorId   String
  viewCount   Int      @default(0)
  rsvpCount   Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    EventCategory? @relation(fields: [categoryId], references: [id])
  rsvps       EventRsvp[]

  @@index([categoryId])
  @@index([creatorId])
  @@index([status])
  @@index([startDate])
}

model EventCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  events      Event[]

  @@index([slug])
}

model EventRsvp {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  status    String   @default("attending")
  guests    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  itemType  String
  itemId    String
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([itemType, itemId])
}

model ShareRecord {
  id        String   @id @default(uuid())
  userId    String
  itemType  String
  itemId    String
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemType, itemId])
}

model CityGuideEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String
  description String
  coverImage  String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  rating      Float?
  priceLevel  Int?
  hours       String?
  phone       String?
  website     String?
  amenities   String[]
  status      String   @default("draft")
  viewCount   Int      @default(0)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags      CityGuideTag[]

  @@index([type])
  @@index([city])
  @@index([status])
  @@index([createdById])
}

model CityGuideTag {
  id      String @id @default(uuid())
  name    String @unique
  slug    String @unique
  entries CityGuideEntry[]
}

model MusicEntry {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  type        String
  description String?
  coverImage  String?
  artistName  String?
  albumName   String?
  duration    Int?
  genre       String?
  trackUrl    String?
  isPremium   Boolean  @default(false)
  playCount   Int      @default(0)
  status      String   @default("draft")
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([genre])
  @@index([status])
  @@index([createdById])
}

model CelebrityEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  bio         String?
  coverImage  String?
  profession  String?
  nationality String?
  birthDate   DateTime?
  socialLinks String?
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  status      String   @default("draft")
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news      CelebrityNews[]

  @@index([profession])
  @@index([status])
  @@index([isFeatured])
  @@index([createdById])
}

model CelebrityNews {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  celebrityId String
  status      String   @default("draft")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  celebrity CelebrityEntry @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([celebrityId])
  @@index([status])
}

model NightlifeEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String
  description String
  coverImage  String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  hours       String?
  dressCode   String?
  coverCharge Float?
  rating      Float?
  status      String   @default("draft")
  viewCount   Int      @default(0)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([city])
  @@index([status])
  @@index([createdById])
}

model InfluencerEntry {
  id            String   @id @default(uuid())
  userId        String
  slug          String   @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  coverImage    String?
  category      String?
  followerCount Int      @default(0)
  followingCount Int     @default(0)
  postCount     Int      @default(0)
  isVerified    Boolean  @default(false)
  socialLinks   String?
  collaborationCount Int @default(0)
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collaborations InfluencerCollaboration[]

  @@index([category])
  @@index([status])
  @@index([isVerified])
  @@index([userId])
}

model InfluencerCollaboration {
  id            String   @id @default(uuid())
  influencerId  String
  brandName     String
  campaignName  String
  description   String?
  coverImage    String?
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("active")
  createdAt     DateTime @default(now())

  influencer InfluencerEntry @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@index([status])
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  coverImage  String?
  type        String   // photo, video, quiz, poll
  startDate   DateTime
  endDate     DateTime
  prize       String?
  rules       String?
  status      String   @default("draft") // draft, active, completed, cancelled
  participantCount Int @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions  ChallengeSubmission[]

  @@index([type])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdById])
}

model ChallengeSubmission {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  content     String
  mediaUrl    String?
  status      String   @default("pending") // pending, approved, rejected
  votes       Int      @default(0)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@index([status])
}

model Poll {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  status      String   @default("draft") // draft, active, closed
  totalVotes  Int      @default(0)
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options   PollOption[]
  votes     PollVote[]

  @@index([status])
  @@index([createdById])
}

model PollOption {
  id          String   @id @default(uuid())
  pollId      String
  text        String
  imageUrl    String?
  voteCount   Int      @default(0)
  createdAt   DateTime @default(now())

  poll        Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes       PollVote[]

  @@index([pollId])
}

model PollVote {
  id          String   @id @default(uuid())
  pollId      String
  optionId    String
  userId      String
  votedAt     DateTime @default(now())

  poll        Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  category    String?
  difficulty  String   @default("easy") // easy, medium, hard
  timeLimit   Int?
  status      String   @default("draft") // draft, published, archived
  playCount   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
  @@index([createdById])
}

model QuizQuestion {
  id          String   @id @default(uuid())
  quizId      String
  question    String
  options     String[]
  correctAnswer Int
  explanation String?
  points      Int      @default(10)
  order       Int

  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([order])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int      @default(0)
  totalQuestions Int
  answers     Json?
  completedAt DateTime?
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([startedAt])
}

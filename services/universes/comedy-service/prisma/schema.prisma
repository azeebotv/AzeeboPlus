generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ComedyClip {
  id          String   @id @default(uuid())
  comedianId  String?
  creatorId   String
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  viewCount   Int      @default(0)
  shareCount  Int      @default(0)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comedian ComedianProfile? @relation(fields: [comedianId], references: [id], onDelete: Cascade)
  shares   ClipShare[]
  likes    ClipLike[]
  comments ClipComment[]
  trends   ComedyTrend[]

  @@index([comedianId])
  @@index([creatorId])
  @@map("comedy_clips")
}

model ComedianProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clips    ComedyClip[]
  specials ComedySpecial[]

  @@map("comedian_profiles")
}

model ClipShare {
  id        String   @id @default(uuid())
  userId    String
  clipId    String
  platform  String?
  createdAt DateTime @default(now())

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clipId])
  @@map("clip_shares")
}

model ClipLike {
  id        String   @id @default(uuid())
  userId    String
  clipId    String
  createdAt DateTime @default(now())

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([userId, clipId])
  @@index([userId])
  @@index([clipId])
  @@map("clip_likes")
}

model ClipComment {
  id        String   @id @default(uuid())
  userId    String
  clipId    String
  text      String
  createdAt DateTime @default(now())

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clipId])
  @@map("clip_comments")
}

model ComedySeries {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  banner      String?
  creatorId   String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes ComedyEpisode[]

  @@index([creatorId])
  @@index([status])
  @@map("comedy_series")
}

model ComedyEpisode {
  id          String   @id @default(uuid())
  seriesId    String
  title       String
  description String?
  thumbnail   String?
  mediaUrl    String?
  duration    Int?
  viewCount   Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series ComedySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@map("comedy_episodes")
}

model ComedyChallenge {
  id          String    @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prizes  ChallengePrize[]
  entries ComedyChallengeEntry[]

  @@index([status])
  @@map("comedy_challenges")
}

model ChallengePrize {
  id          String   @id @default(uuid())
  challengeId String
  rank        Int
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  challenge ComedyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("challenge_prizes")
}

model ComedyChallengeEntry {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  clipUrl     String
  createdAt   DateTime @default(now())

  challenge ComedyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@map("comedy_challenge_entries")
}

model ComedySpecial {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  duration    Int?
  comedianId  String
  genre       String?
  isPremium   Boolean  @default(true)
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comedian ComedianProfile? @relation(fields: [comedianId], references: [id], onDelete: Cascade)
  likes    SpecialLike[]

  @@index([comedianId])
  @@index([isPremium])
  @@map("comedy_specials")
}

model SpecialLike {
  id        String   @id @default(uuid())
  userId    String
  specialId String
  createdAt DateTime @default(now())

  special ComedySpecial @relation(fields: [specialId], references: [id], onDelete: Cascade)

  @@unique([userId, specialId])
  @@index([userId])
  @@index([specialId])
  @@map("special_likes")
}

model ComedyTrend {
  id        String   @id @default(uuid())
  clipId    String
  score     Float    @default(0)
  rank      Int
  period    String   @default("daily")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clip ComedyClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([clipId, period])
  @@index([clipId])
  @@map("comedy_trends")
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@map("tips")
  @@index([fromUserId])
  @@index([toUserId])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  creatorId        String
  creatorProfileId String?
  tier             String    @default("free")
  status           String    @default("active")
  startDate        DateTime  @default(now())
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
  @@index([creatorProfileId])
  @@index([status])
  @@map("subscriptions")
}

model CreatorEarning {
  id               String    @id @default(uuid())
  creatorId        String
  creatorProfileId String?
  amount           Decimal  @db.Decimal(18, 2)
  type             String
  referenceId      String?
  status           String    @default("pending")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@map("creator_earnings")
  @@index([creatorId])
  @@index([creatorProfileId])
  @@index([status])
}

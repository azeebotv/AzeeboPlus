{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@prisma/client": [
        "./src/prisma/client"
      ],
      "@azeebo/*": [
        "../../../packages/*/dist"
      ],
      "@movie/*": [
        "./*"
      ]
    },
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

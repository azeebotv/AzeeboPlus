generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  banner      String?
  mediaUrl    String?
  universeId  String
  creatorId   String
  status      String // draft, published, archived
  viewCount   Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rentals        Rental[]
  watchlistItems WatchlistItem[]
  viewingWindows ViewingWindow[]
  Premiere       Premiere?

  @@map("movies")
  @@index([universeId])
  @@index([creatorId])
  @@index([status])
}

model Rental {
  id        String    @id @default(uuid())
  userId    String
  movieId   String
  status    String    @default("active")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@map("rentals")
}

model Premiere {
  id        String    @id @default(uuid())
  movieId   String    @unique
  startsAt  DateTime
  endsAt    DateTime?
  status    String    @default("scheduled")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("premieres")
  @@index([status])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@map("watchlist_items")
}

model ViewingWindow {
  id        String    @id @default(uuid())
  movieId   String
  startsAt  DateTime
  endsAt    DateTime?
  type      String // standard, premium, premiere, special
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([type])
  @@index([isActive])
  @@map("viewing_windows")
}

model CinemaPass {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String // monthly, yearly, premium
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions CinemaPassSubscription[]

  @@map("cinema_passes")
}

model CinemaPassSubscription {
  id              String    @id @default(uuid())
  userId          String
  passId          String
  status          String    @default("active") // active, cancelled, expired
  startDate       DateTime
  endDate         DateTime
  autoRenew       Boolean   @default(true)
  paymentIntentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pass CinemaPass @relation(fields: [passId], references: [id])

  @@unique([userId, passId])
  @@index([userId])
  @@index([passId])
  @@index([status])
  @@index([paymentIntentId])
  @@map("cinema_pass_subscriptions")
}

model FilmmakerProject {
  id            String   @id @default(uuid())
  filmmakerId   String
  title         String
  description   String?
  thumbnail     String?
  status        String   @default("development") // development, production, post_production, completed
  fundingGoal   Decimal? @db.Decimal(18, 2)
  fundingRaised Decimal    @default(0) @db.Decimal(18, 2)
  targetDate    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  updates       FilmmakerUpdate[]
  backers       FilmmakerBacker[]

  @@index([filmmakerId])
  @@index([status])
  @@map("filmmaker_projects")
}

model FilmmakerUpdate {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  content     String
  createdAt   DateTime @default(now())

  project FilmmakerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("filmmaker_updates")
}

model FilmmakerBacker {
  id          String    @id @default(uuid())
  projectId   String
  userId      String
  amount      Decimal   @db.Decimal(18, 2)
  status      String    @default("active") // active, refunded
  createdAt   DateTime  @default(now())

  project FilmmakerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("filmmaker_backers")
}

model CreatorEarning {
  id          String    @id @default(uuid())
  creatorId   String
  amount      Decimal   @db.Decimal(18, 2)
  type        String // tip, subscription, rental, payout
  referenceId String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("creator_earnings")
  @@index([creatorId])
  @@index([status])
}
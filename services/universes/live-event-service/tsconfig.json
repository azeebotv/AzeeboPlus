{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "types": ["jest", "node"],
    "paths": {
      "@azeebo/security/log-redaction": ["../../../packages/security/dist/log-redaction"],
      "@azeebo/*": ["../../../packages/*/dist"]
    },
    "forceConsistentCasingInFileNames": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

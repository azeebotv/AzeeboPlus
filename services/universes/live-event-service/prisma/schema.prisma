generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl   = env("DIRECT_DATABASE_URL")
}

model LiveEvent {
  id            String   @id @default(uuid())
  title         String
  description   String?
  thumbnail     String
  organizerId   String
  scheduledAt   DateTime
  duration      Int
  status        String   @default("scheduled")
  ticketPrice   Decimal  @db.Decimal(10, 2)
  currency      String   @default("NGN")
  maxViewers    Int?
  currentViewers Int     @default(0)
  streamUrl     String?
  replayUrl     String?
  chatEnabled   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tickets LiveEventTicket[]

  @@map("live_events")
  @@index([status])
  @@index([scheduledAt])
  @@index([organizerId])
}

model LiveEventTicket {
  id          String   @id @default(uuid())
  eventId     String
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("NGN")
  status      String   @default("purchased")
  purchasedAt DateTime @default(now())
  usedAt      DateTime?
  refundedAt  DateTime?

  event LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("live_event_tickets")
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model WatchPartyRoom {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  contentId    String?
  hostUserId   String
  isActive     Boolean  @default(true)
  playbackTime Float    @default(0.0)
  isPlaying    Boolean  @default(false)
  participants Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     WatchPartyMessage[]

  @@map("watch_party_rooms")
  @@index([code])
  @@index([isActive])
}

model WatchPartyMessage {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  userName  String
  message   String
  createdAt DateTime @default(now())

  room      WatchPartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("watch_party_messages")
  @@index([roomId])
  @@index([createdAt])
}

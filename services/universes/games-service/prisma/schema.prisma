generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stub model for cross-service references
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String // daily, weekly, tournament
  points      Int      @default(10)
  status      String   @default("active")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  sessions  GameSession[]

  @@map("challenges")
  @@index([type])
  @@index([status])
}

model Question {
  id          String   @id @default(uuid())
  challengeId String
  question    String
  answer      String
  options     Json?
  points      Int      @default(10)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sessions  GameSession[]
  answers   GameAnswer[]

  @@index([challengeId])
  @@map("questions")
}

model GameSession {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  questionId  String?
  status      String // active, completed, failed
  score       Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  question  Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([questionId])
  @@map("game_sessions")
}

model ScoreEntry {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("score_entries")
  @@index([userId])
}

model Tournament {
  id          String    @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  entryFee Decimal     @default(0) @db.Decimal(18, 2)
  prizePool Decimal  @db.Decimal(18, 2)
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prizes  TournamentPrize[]
  entries TournamentEntry[]
  matches TournamentMatch[]

  @@map("tournaments")
  @@index([status])
  @@index([startsAt])
}

model TournamentPrize {
  id           String   @id @default(uuid())
  tournamentId String
  rank         Int
  amount Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_prizes")
}

model TournamentEntry {
  id           String   @id @default(uuid())
  userId       String
  tournamentId String
  score        Int      @default(0)
  enteredAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@map("tournament_entries")
}

model Game {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  thumbnail   String?
  category    String
  difficulty  String   @default("medium")
  playCount   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions GameQuestion[]
  sessions  GamePlaySession[]

  @@index([category])
  @@index([isActive])
  @@map("games")
}

model GameQuestion {
  id          String   @id @default(uuid())
  gameId      String
  question    String
  answer      String
  options     Json?
  points      Int      @default(10)
  order       Int      @default(0)
  timeLimit   Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_questions")
}

model GameAnswer {
  id          String   @id @default(uuid())
  sessionId   String
  questionId  String
  answer      String
  isCorrect   Boolean
  timeTaken   Int
  pointsEarned Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session    GamePlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([questionId])
  @@map("game_answers")
}

model GamePlaySession {
  id          String    @id @default(uuid())
  userId      String
  gameId      String
  score       Int       @default(0)
  correctCount Int      @default(0)
  status      String    @default("active") // active, completed, abandoned
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers GameAnswer[]

  @@index([userId])
  @@index([gameId])
  @@map("game_play_sessions")
}

model TournamentMatch {
  id            String   @id @default(uuid())
  tournamentId  String
  player1Id    String
  player2Id    String
  player1Score Int      @default(0)
  player2Score Int      @default(0)
  round        Int
  status       String   @default("pending") // pending, in_progress, completed
  winnerId     String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([status])
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
  @@map("tournament_matches")
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tips")
  @@index([fromUserId])
  @@index([toUserId])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  creatorId String
  creatorProfileId String?
  tier      String    @default("free")
  status    String    @default("active")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
  @@index([creatorProfileId])
  @@index([status])
  @@map("subscriptions")
}

model CreatorEarning {
  id          String    @id @default(uuid())
  creatorId   String
  creatorProfileId String?
  amount Decimal  @db.Decimal(18, 2)
  type        String // tip, subscription, rental, payout
  referenceId String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("creator_earnings")
  @@index([creatorId])
  @@index([creatorProfileId])
  @@index([status])
}

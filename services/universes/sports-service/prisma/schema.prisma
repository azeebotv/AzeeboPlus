generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  directUrl   = env("DIRECT_DATABASE_URL")
}

model SportsEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  sport       String // football, basketball, tennis, etc.
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("upcoming")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teams            EventTeam[]
  predictions      PredictionEntry[]
  fanBoards        FanBoard[]
  contests         ContestEntry[]
  PredictionMarket PredictionMarket?
  Highlight        Highlight[]
  Contest          Contest[]
  fixtureMetadata  FixtureMetadata?
  predictionReward PredictionReward?

  @@map("sports_events")
  @@index([sport])
  @@index([status])
  @@index([startsAt])
}

model EventTeam {
  id      String  @id @default(uuid())
  eventId String
  name    String
  logo    String?
  score   Int     @default(0)
  order   Int     @default(0)

  event SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_teams")
  @@index([eventId])
}

model PredictionEntry {
  id         String   @id @default(uuid())
  userId     String
  eventId    String
  prediction Json
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event              SportsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  PredictionMarket   PredictionMarket? @relation(fields: [predictionMarketId], references: [id])
  predictionMarketId String?

  @@map("prediction_entries")
  @@index([userId])
  @@index([eventId])
  @@index([eventId, userId])
  @@index([predictionMarketId])
  @@index([createdAt])
}

model Highlight {
  id          String   @id @default(uuid())
  eventId     String
  creatorId   String
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   SportsEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator CreatorProfile?  @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@map("highlights")
  @@index([eventId])
  @@index([creatorId])
  @@index([createdAt])
  @@index([viewCount])
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fanBoards       FanBoard[]
  fanBoardComments FanBoardComment[]
  predictionEntries PredictionEntry[]
  contestEntries  ContestEntry[]
  tipsGiven       Tip[] @relation("TipFrom")
  tipsReceived    Tip[] @relation("TipTo")
  subscriptions   Subscription[]

  @@map("users")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  highlights  Highlight[]
  earnings    CreatorEarning[]
  subscriptions Subscription[]

  @@map("creator_profiles")
}

model FanBoard {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    SportsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  comments FanBoardComment[]

  @@map("fan_boards")
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
  @@index([likes])
}

model FanBoardComment {
  id         String   @id @default(uuid())
  fanBoardId String
  userId     String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fanBoard FanBoard @relation(fields: [fanBoardId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("fan_board_comments")
  @@index([fanBoardId])
  @@index([userId])
  @@index([createdAt])
}

model Contest {
  id          String    @id @default(uuid())
  eventId     String
  title       String
  description String?
  entryFee Decimal     @default(0) @db.Decimal(18, 2)
  prizePool Decimal  @db.Decimal(18, 2)
  status      String    @default("active")
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event   SportsEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizes  ContestPrize[]
  entries ContestEntry[]

  @@map("contests")
  @@index([eventId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model ContestPrize {
  id        String   @id @default(uuid())
  contestId String
  rank      Int
  amount Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("contest_prizes")
  @@index([contestId])
}

model ContestEntry {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  entryData Json
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contest       Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  SportsEvent   SportsEvent? @relation(fields: [sportsEventId], references: [id])
  sportsEventId String?

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@index([score])
  @@index([sportsEventId])
  @@map("contest_entries")
}

model PredictionMarket {
  id            String   @id @default(uuid())
  eventId       String   @unique
  question      String
  options       Json
  odds          Json?
  totalPool   Decimal @default(0) @db.Decimal(18, 2)
  status        String   @default("active")
  settlementType String? // automatic, manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event   SportsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries PredictionEntry[]

  @@map("prediction_markets")
  @@index([status])
}

model FixtureMetadata {
  id          String   @id @default(uuid())
  eventId     String   @unique
  venue       String?
  referee     String?
  weather     String?
  temperature Int?
  attendance  Int?
  broadcast   String[]
  stats       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("fixture_metadata")
}

model PredictionReward {
  id          String   @id @default(uuid())
  eventId     String   @unique
  correctPredictions Int @default(0)
  rewardPoints Int     @default(0)
  bonusPool Decimal @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("prediction_rewards")
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User @relation("TipFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User @relation("TipTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@map("tips")
  @@index([fromUserId])
  @@index([toUserId])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  creatorId String
  tier      String    @default("free")
  status    String    @default("active")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  creator CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
  @@index([status])
  @@map("subscriptions")
}

model CreatorEarning {
  id          String    @id @default(uuid())
  creatorId   String
  amount Decimal  @db.Decimal(18, 2)
  type        String // tip, subscription, rental, payout
  referenceId String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId])
  @@index([status])
  @@map("creator_earnings")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

/// NOTE: This User model is duplicated from auth-service for local relation support.
/// Consider removing this and using userId: String references instead (see creator-service pattern).
/// The canonical User definition is in packages/shared-types/prisma/user.prisma
model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  password                String
  displayName             String
  avatar                  String?
  role                    String   @default("user")
  preferences             Json?
  notificationPreferences Json?
  trustScore              Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  watchHistory              WatchHistory[]
  savedItems                SavedItem[]
  wallet                    Wallet?
  notifications             Notification[]
  contentItems              ContentItem[]
  creatorProfile            CreatorProfile?
  rewardAccount             RewardAccount?
  userSearches              UserSearch[]
  productEvents             ProductEvent[]
  reportsAsReporter         Report[]            @relation("Reporter")
  reportsAsReported         Report[]            @relation("Reported")
  moderationCases           ModerationCase[]    @relation("ModerationUser")
  resolvedModerationCases   ModerationCase[]    @relation("ResolvedBy")
  appeals                   Appeal[]
  tipsAsSender              Tip[]               @relation("Sender")
  tipsAsReceiver            Tip[]               @relation("Receiver")
  subscriptionsAsSubscriber Subscription[]      @relation("Subscriber")
  subscriptionsAsCreator    Subscription[]      @relation("Creator")
  creatorEarnings           CreatorEarning[]
  sportsPredictions         PredictionEntry[]
  fanBoards                 FanBoard[]
  contestEntries            ContestEntry[]
  PaymentIntent             PaymentIntent[]
  MissionCompletion         MissionCompletion[]
  RewardRedemption          RewardRedemption[]
  PointsLedger              PointsLedger[]
  Highlight                 Highlight[]
  FanBoardComment           FanBoardComment[]

  @@map("users")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@map("watch_history")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@map("saved_items")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance Decimal    @default(0) @db.Decimal(18, 2)
  bonusBalance Decimal    @default(0) @db.Decimal(18, 2)
  promoBalance Decimal    @default(0) @db.Decimal(18, 2)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String // credit, debit, bonus, promo, refund
  amount Decimal  @db.Decimal(18, 2)
  status      String // pending, completed, failed, reversed
  description String?
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system, payment, reward, content, social
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model PaymentIntent {
  id                String    @id @default(uuid())
  userId            String
  amount Decimal  @db.Decimal(18, 2)
  currency          String    @default("NGN")
  status            String // pending, processing, completed, failed, refunded
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payment_intents")
}

model Refund {
  id                String   @id @default(uuid())
  paymentIntentId   String
  amount Decimal  @db.Decimal(18, 2)
  reason            String
  status            String // pending, processing, completed, failed
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  mediaUrl    String?
  universeId  String
  creatorId   String
  status      String // draft, pending, published, archived
  viewCount   Int       @default(0)
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  universe         Universe        @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset?
  categories       Category[]
  tags             Tag[]
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?
  Report           Report[]

  @@map("content_items")
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  subscribers  Subscription[]
  earnings     CreatorEarning[]

  @@map("creator_profiles")
}

model RewardAccount {
  id            String    @id @default(uuid())
  userId        String    @unique
  points        Int       @default(0)
  levelId       String
  streak        Int       @default(0)
  lastLoginAt   DateTime  @default(now())
  lastCheckInAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  Level   @relation(fields: [levelId], references: [id])
  badges Badge[]

  @@map("reward_accounts")
}

model Level {
  id        String   @id @default(uuid())
  name      String
  rank      Int      @unique
  minPoints Int
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("levels")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  points      Int
  type        String // daily, weekly, monthly, one-time
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards     MissionReward[]
  completions MissionCompletion[]

  @@map("missions")
}

model MissionReward {
  id        String   @id @default(uuid())
  missionId String
  rewardId  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@map("mission_rewards")
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_completions")
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        String // points, bonus, promo
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions   RewardRedemption[]
  MissionReward MissionReward[]

  @@map("rewards")
}

model RewardRedemption {
  id         String   @id @default(uuid())
  userId     String
  rewardId   String
  pointsCost Int
  redeemedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  type      String // credit, debit
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
}

model SearchQueryLog {
  id           String   @id @default(uuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearchAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userSearches UserSearch[]

  @@map("search_query_logs")
}

model UserSearch {
  id           String   @id @default(uuid())
  userId       String
  queryId      String
  resultsCount Int
  createdAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query SearchQueryLog @relation(fields: [queryId], references: [id])

  @@map("user_searches")
}

model ProductEvent {
  id        String   @id @default(uuid())
  type      String // content_view, play_start, play_complete, etc.
  userId    String?
  sessionId String?
  metadata  Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_events")
}

model Report {
  id               String    @id @default(uuid())
  reportingUserId  String
  type             String // harassment, hate_speech, violence, sexual_content, copyright, spam, other
  contentId        String?
  userId           String?
  reason           String
  status           String // pending, in_review, resolved, dismissed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reportingUser  User?           @relation("Reporter", fields: [reportingUserId], references: [id], onDelete: Cascade)
  reportedUser   User?           @relation("Reported", fields: [userId], references: [id], onDelete: Cascade)
  content        ContentItem?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ModerationCase ModerationCase?

  @@map("reports")
}

model ModerationCase {
  id               String    @id @default(uuid())
  reportId         String    @unique
  userId           String
  status           String // pending, in_review, resolved, appealed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user           User     @relation("ModerationUser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedByUser User?    @relation("ResolvedBy", fields: [resolvedBy], references: [id])
  Appeal         Appeal[]

  @@map("moderation_cases")
}

model Appeal {
  id               String    @id @default(uuid())
  caseId           String
  userId           String
  reason           String
  status           String // pending, in_review, successful, rejected
  resolvedBy       String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  fromUser User @relation("Sender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("Receiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("tips")
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  creatorId String
  tier      String    @default("free")
  status    String    @default("active")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user             User            @relation("Subscriber", fields: [userId], references: [id], onDelete: Cascade)
  creator          User            @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?

  @@unique([userId, creatorId])
  @@map("subscriptions")
}

model CreatorEarning {
  id          String    @id @default(uuid())
  creatorId   String
  amount Decimal  @db.Decimal(18, 2)
  type        String // tip, subscription, rental, payout
  referenceId String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?

  @@map("creator_earnings")
}

model SportsEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  sport       String // football, basketball, tennis, etc.
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("upcoming")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teams            EventTeam[]
  predictions      PredictionEntry[]
  fanBoards        FanBoard[]
  contests         ContestEntry[]
  PredictionMarket PredictionMarket?
  Highlight        Highlight[]
  Contest          Contest[]
  fixtureMetadata  FixtureMetadata?
  predictionReward PredictionReward?

  @@map("sports_events")
  @@index([sport])
  @@index([status])
  @@index([startsAt])
}

model EventTeam {
  id      String  @id @default(uuid())
  eventId String
  name    String
  logo    String?
  score   Int     @default(0)
  order   Int     @default(0)

  event SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_teams")
}

model PredictionEntry {
  id         String   @id @default(uuid())
  userId     String
  eventId    String
  prediction Json
  points     Int      @default(0)
  createdAt  DateTime @default(now())

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event              SportsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  PredictionMarket   PredictionMarket? @relation(fields: [predictionMarketId], references: [id])
  predictionMarketId String?

  @@map("prediction_entries")
  @@index([userId])
  @@index([eventId])
  @@index([predictionMarketId])
  @@index([createdAt])
}

model Highlight {
  id          String   @id @default(uuid())
  eventId     String
  creatorId   String
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("highlights")
  @@index([eventId])
  @@index([creatorId])
  @@index([createdAt])
  @@index([viewCount])
}

model FanBoard {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    SportsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments FanBoardComment[]

  @@map("fan_boards")
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
  @@index([likes])
}

model FanBoardComment {
  id         String   @id @default(uuid())
  fanBoardId String
  userId     String
  text       String
  createdAt  DateTime @default(now())

  fanBoard FanBoard @relation(fields: [fanBoardId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fan_board_comments")
  @@index([fanBoardId])
  @@index([userId])
  @@index([createdAt])
}

model Contest {
  id          String    @id @default(uuid())
  eventId     String
  title       String
  description String?
  entryFee Decimal     @default(0) @db.Decimal(18, 2)
  prizePool Decimal  @db.Decimal(18, 2)
  status      String    @default("active")
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event   SportsEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizes  ContestPrize[]
  entries ContestEntry[]

  @@map("contests")
  @@index([eventId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model ContestPrize {
  id        String   @id @default(uuid())
  contestId String
  rank      Int
  amount Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("contest_prizes")
}

model ContestEntry {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  entryData Json
  score     Int      @default(0)
  createdAt DateTime @default(now())

  contest       Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  SportsEvent   SportsEvent? @relation(fields: [sportsEventId], references: [id])
  sportsEventId String?

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@index([score])
  @@map("contest_entries")
}

model PredictionMarket {
  id            String   @id @default(uuid())
  eventId       String   @unique
  question      String
  options       Json
  odds          Json?
  totalPool   Decimal @default(0) @db.Decimal(18, 2)
  status        String   @default("active")
  settlementType String? // automatic, manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event   SportsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries PredictionEntry[]

  @@map("prediction_markets")
}

model FixtureMetadata {
  id          String   @id @default(uuid())
  eventId     String   @unique
  venue       String?
  referee     String?
  weather     String?
  temperature Int?
  attendance  Int?
  broadcast   String[]
  stats       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("fixture_metadata")
}

model PredictionReward {
  id          String   @id @default(uuid())
  eventId     String   @unique
  correctPredictions Int @default(0)
  rewardPoints Int     @default(0)
  bonusPool Decimal @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  event SportsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("prediction_rewards")
}

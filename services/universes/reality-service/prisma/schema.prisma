generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RealityShow {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  banner      String?
  universeId  String
  status      String // draft, published, archived
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seasons     Season[]
  contestants Contestant[]
  episodes    Episode[]
  votes       Vote[]
  supervotes  Supervote[]
  predictions Prediction[]
  clips       RealityClip[]

  @@map("reality_shows")
  @@index([universeId])
  @@index([status])
}

model Season {
  id          String    @id @default(uuid())
  showId      String
  title       String
  number      Int
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  show     RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@map("reality_seasons")
  @@index([showId])
}

model Episode {
  id          String    @id @default(uuid())
  showId      String
  seasonId    String?
  title       String
  number      Int
  description String?
  thumbnail   String?
  mediaUrl    String?
  airedAt     DateTime?
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  show        RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  season      Season?     @relation(fields: [seasonId], references: [id])
  votes       Vote[]
  predictions Prediction[]

  @@map("reality_episodes")
  @@index([showId])
  @@index([seasonId])
  @@index([airedAt])
}

model Contestant {
  id          String   @id @default(uuid())
  showId      String
  name        String
  description String?
  thumbnail   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  show        RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  votes       Vote[]
  supervotes  Supervote[]
  predictions Prediction[]

  @@map("reality_contestants")
  @@index([showId])
}

model Vote {
  id           String   @id @default(uuid())
  userId       String
  contestantId String
  showId       String
  episodeId    String?
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  contestant Contestant  @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  show       RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  episode    Episode?    @relation(fields: [episodeId], references: [id])

  @@unique([userId, contestantId])
  @@index([userId])
  @@index([contestantId])
  @@index([showId])
  @@index([episodeId])
  @@map("reality_votes")
}

model Supervote {
  id           String   @id @default(uuid())
  userId       String
  contestantId String
  showId       String
  amount       Decimal  @default(10) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  contestant Contestant  @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  show       RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, contestantId])
  @@index([userId])
  @@index([contestantId])
  @@index([showId])
  @@map("reality_supervotes")
}

model Prediction {
  id            String   @id @default(uuid())
  userId        String
  showId        String
  prediction    Json
  episodeId     String?
  contestantId  String?
  createdAt     DateTime @default(now())

  show         RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  episode      Episode?    @relation(fields: [episodeId], references: [id])
  contestant   Contestant? @relation(fields: [contestantId], references: [id])

  @@map("reality_predictions")
  @@index([userId])
  @@index([showId])
  @@index([episodeId])
  @@index([contestantId])
}

model RealityClip {
  id          String   @id @default(uuid())
  showId      String
  creatorId   String
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  show RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@map("reality_clips")
  @@index([showId])
  @@index([creatorId])
}

model PremiumPurchase {
  id          String   @id @default(uuid())
  userId      String
  extraId     String
  extraName   String
  extraType   String
  price       Decimal  @db.Decimal(18, 2)
  duration    Int?
  purchaseId  String   @unique
  purchasedAt DateTime @default(now())
  expiresAt   DateTime?
  status      String   @default("active") // active, expired, cancelled

  @@map("reality_premium_purchases")
  @@index([userId])
  @@index([extraId])
  @@index([purchaseId])
  @@index([status])
}

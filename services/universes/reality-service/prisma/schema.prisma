generator client {
  provider = "prisma-client-js"
  output = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

/// NOTE: This User model is duplicated from auth-service for local relation support.
/// Consider removing this and using userId: String references instead (see creator-service pattern).
/// The canonical User definition is in packages/shared-types/prisma/user.prisma
model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  password                String
  displayName             String
  avatar                  String?
  role                    String   @default("user")
  preferences             Json?
  notificationPreferences Json?
  trustScore              Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  watchHistory            WatchHistory[]
  savedItems              SavedItem[]
  wallet                  Wallet?
  notifications           Notification[]
  contentItems            ContentItem[]
  creatorProfile          CreatorProfile?
  rewardAccount           RewardAccount?
  userSearches            UserSearch[]
  productEvents           ProductEvent[]
  reportsAsReporter       Report[]            @relation("Reporter")
  reportsAsReported       Report[]            @relation("Reported")
  moderationCases         ModerationCase[]    @relation("ModerationUser")
  resolvedModerationCases ModerationCase[]    @relation("ResolvedBy")
  appeals                 Appeal[]
  votes                   Vote[]
  supervotes              Supervote[]
  predictions             Prediction[]
  clips                   RealityClip[]
  PaymentIntent           PaymentIntent[]
  MissionCompletion       MissionCompletion[]
  RewardRedemption        RewardRedemption[]
  PointsLedger            PointsLedger[]

  @@map("users")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@map("watch_history")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@map("saved_items")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance Decimal    @default(0) @db.Decimal(18, 2)
  bonusBalance Decimal    @default(0) @db.Decimal(18, 2)
  promoBalance Decimal    @default(0) @db.Decimal(18, 2)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String // credit, debit, bonus, promo, refund
  amount Decimal  @db.Decimal(18, 2)
  status      String // pending, completed, failed, reversed
  description String?
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system, payment, reward, content, social
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model PaymentIntent {
  id                String    @id @default(uuid())
  userId            String
  amount Decimal  @db.Decimal(18, 2)
  currency          String    @default("NGN")
  status            String // pending, processing, completed, failed, refunded
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payment_intents")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([providerReference])
}

model Refund {
  id                String   @id @default(uuid())
  paymentIntentId   String
  amount Decimal  @db.Decimal(18, 2)
  reason            String
  status            String // pending, processing, completed, failed
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
  @@index([paymentIntentId])
  @@index([status])
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]
  RealityShow  RealityShow[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  mediaUrl    String?
  universeId  String
  creatorId   String
  status      String // draft, pending, published, archived
  viewCount   Int       @default(0)
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  universe         Universe        @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset?
  categories       Category[]
  tags             Tag[]
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?
  Report           Report[]

  @@map("content_items")
  @@index([universeId])
  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
  @@index([viewCount])
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@map("creator_profiles")
  @@index([userId])
  @@index([verified])
}

model RewardAccount {
  id            String    @id @default(uuid())
  userId        String    @unique
  points        Int       @default(0)
  levelId       String
  streak        Int       @default(0)
  lastLoginAt   DateTime  @default(now())
  lastCheckInAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  Level   @relation(fields: [levelId], references: [id])
  badges Badge[]

  @@map("reward_accounts")
  @@index([userId])
  @@index([levelId])
}

model Level {
  id        String   @id @default(uuid())
  name      String
  rank      Int      @unique
  minPoints Int
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("levels")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  points      Int
  type        String // daily, weekly, monthly, one-time
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards     MissionReward[]
  completions MissionCompletion[]

  @@map("missions")
  @@index([type])
  @@index([isActive])
}

model MissionReward {
  id        String   @id @default(uuid())
  missionId String
  rewardId  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@map("mission_rewards")
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
  @@map("mission_completions")
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        String // points, bonus, promo
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions   RewardRedemption[]
  MissionReward MissionReward[]

  @@map("rewards")
}

model RewardRedemption {
  id         String   @id @default(uuid())
  userId     String
  rewardId   String
  pointsCost Int
  redeemedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
  @@index([userId])
  @@index([rewardId])
  @@index([redeemedAt])
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  type      String // credit, debit
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SearchQueryLog {
  id           String   @id @default(uuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearchAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userSearches UserSearch[]

  @@map("search_query_logs")
  @@index([query])
  @@index([lastSearchAt])
}

model UserSearch {
  id           String   @id @default(uuid())
  userId       String
  queryId      String
  resultsCount Int
  createdAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query SearchQueryLog @relation(fields: [queryId], references: [id])

  @@map("user_searches")
  @@index([userId])
  @@index([queryId])
}

model ProductEvent {
  id        String   @id @default(uuid())
  type      String // content_view, play_start, play_complete, etc.
  userId    String?
  sessionId String?
  metadata  Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_events")
  @@index([type])
  @@index([userId])
  @@index([timestamp])
}

model Report {
  id               String    @id @default(uuid())
  reportingUserId  String
  type             String // harassment, hate_speech, violence, sexual_content, copyright, spam, other
  contentId        String?
  userId           String?
  reason           String
  status           String // pending, in_review, resolved, dismissed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reportingUser  User?           @relation("Reporter", fields: [reportingUserId], references: [id], onDelete: Cascade)
  reportedUser   User?           @relation("Reported", fields: [userId], references: [id], onDelete: Cascade)
  content        ContentItem?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ModerationCase ModerationCase?

  @@map("reports")
  @@index([reportingUserId])
  @@index([userId])
  @@index([contentId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model ModerationCase {
  id               String    @id @default(uuid())
  reportId         String    @unique
  userId           String
  status           String // pending, in_review, resolved, appealed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user           User     @relation("ModerationUser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedByUser User?    @relation("ResolvedBy", fields: [resolvedBy], references: [id])
  Appeal         Appeal[]

  @@map("moderation_cases")
  @@index([userId])
  @@index([status])
  @@index([resolvedBy])
  @@index([createdAt])
}

model Appeal {
  id               String    @id @default(uuid())
  caseId           String
  userId           String
  reason           String
  status           String // pending, in_review, successful, rejected
  resolvedBy       String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeals")
  @@index([caseId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model RealityShow {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  banner      String?
  universeId  String
  status      String // draft, published, archived
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    Universe      @relation(fields: [universeId], references: [id], onDelete: Cascade)
  seasons     Season[]
  contestants Contestant[]
  episodes    Episode[]
  votes       Vote[]
  supervotes  Supervote[]
  predictions Prediction[]
  clips       RealityClip[]

  @@map("reality_shows")
  @@index([universeId])
  @@index([status])
}

model Season {
  id          String    @id @default(uuid())
  showId      String
  title       String
  number      Int
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  show     RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@map("reality_seasons")
  @@index([showId])
}

model Episode {
  id          String    @id @default(uuid())
  showId      String
  seasonId    String?
  title       String
  number      Int
  description String?
  thumbnail   String?
  mediaUrl    String?
  airedAt     DateTime?
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  show        RealityShow  @relation(fields: [showId], references: [id], onDelete: Cascade)
  season      Season?      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  votes       Vote[]
  predictions Prediction[]

  @@map("reality_episodes")
  @@index([showId])
  @@index([seasonId])
  @@index([airedAt])
}

model Contestant {
  id          String   @id @default(uuid())
  showId      String
  name        String
  description String?
  thumbnail   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  show        RealityShow  @relation(fields: [showId], references: [id], onDelete: Cascade)
  votes       Vote[]
  supervotes  Supervote[]
  predictions Prediction[]

  @@map("reality_contestants")
}

model Vote {
  id           String   @id @default(uuid())
  userId       String
  contestantId String
  showId       String
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestant Contestant  @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  show       RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  Episode    Episode?    @relation(fields: [episodeId], references: [id])
  episodeId  String?

  @@unique([userId, contestantId])
  @@index([userId])
  @@index([contestantId])
  @@index([showId])
  @@index([episodeId])
  @@map("reality_votes")
}

model Supervote {
  id           String   @id @default(uuid())
  userId       String
  contestantId String
  showId       String
  amount       Decimal  @default(10) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestant Contestant  @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  show       RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, contestantId])
  @@index([userId])
  @@index([contestantId])
  @@index([showId])
  @@map("reality_supervotes")
}

model Prediction {
  id         String   @id @default(uuid())
  userId     String
  showId     String
  prediction Json
  createdAt  DateTime @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  show         RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  Episode      Episode?    @relation(fields: [episodeId], references: [id])
  episodeId    String?
  Contestant   Contestant? @relation(fields: [contestantId], references: [id])
  contestantId String?

  @@map("reality_predictions")
  @@index([userId])
  @@index([showId])
  @@index([episodeId])
  @@index([contestantId])
}

model RealityClip {
  id          String   @id @default(uuid())
  showId      String
  creatorId   String
  title       String
  description String?
  thumbnail   String
  mediaUrl    String
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  show    RealityShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("reality_clips")
}

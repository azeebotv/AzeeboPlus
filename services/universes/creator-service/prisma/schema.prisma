generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  earnings     CreatorEarning[]
  subscriptions Subscription[]
  channels     Channel[]
  challenges   CreatorChallenge[]
  payoutRequests PayoutRequest[]

  @@map("creator_profiles")
}

model CreatorEarning {
  id          String   @id @default(uuid())
  creatorId   String
  amount      Decimal
  type        String   // tip, subscription, rental, payout
  referenceId String?
  status      String   @default("pending")
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_earnings")
  @@index([creatorId])
  @@index([type])
  @@index([status])
}

model Channel {
  id          String   @id @default(uuid())
  creatorId   String
  name        String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("channels")
  @@index([creatorId])
}

model CreatorChallenge {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  description String
  prize       String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entries ChallengeEntry[]

  @@map("creator_challenges")
  @@index([creatorId])
  @@index([status])
}

model ChallengeEntry {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  contentUrl  String
  createdAt   DateTime @default(now())

  challenge CreatorChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("challenge_entries")
  @@index([userId])
}

model PayoutRequest {
  id             String   @id @default(uuid())
  creatorId      String
  amount         Decimal
  method         String
  accountDetails Json
  status         String   @default("pending")
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("payout_requests")
  @@index([creatorId])
  @@index([status])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  creatorId String
  tier      String   @default("free")
  status    String   @default("active")
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@map("subscriptions")
  @@index([userId])
  @@index([creatorId])
  @@index([status])
}

model Tip {
  id        String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount    Decimal
  createdAt DateTime @default(now())

  @@map("tips")
  @@index([fromUserId])
  @@index([toUserId])
}

model VerificationDocument {
  id          String   @id @default(uuid())
  userId      String
  documentType String
  documentUrl String
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("verification_documents")
  @@index([userId])
  @@index([status])
}

model MediaUpload {
  id        String   @id @default(uuid())
  userId    String
  fileName  String
  mimeType  String
  size      BigInt
  status    String   @default("pending")
  uploadId  String   @unique
  assetId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media_uploads")
  @@index([userId])
  @@index([uploadId])
  @@index([status])
}

model ContentItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  mediaUrl    String
  universeId  String
  creatorId   String
  status      String   @default("pending")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_items")
  @@index([creatorId])
  @@index([universeId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
  @@index([userId])
  @@index([type])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
  @@index([userId])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String   // credit, debit
  amount      Decimal
  description String
  reference   String?
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
  @@index([walletId])
  @@index([type])
}
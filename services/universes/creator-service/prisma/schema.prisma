generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  directUrl   = env("DIRECT_DATABASE_URL")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  banner      String?
  socialLinks   Json?
  settings      Json?
  payoutMethod  String?
  minimumPayout Decimal? @db.Decimal(18, 2)
  tipEnabled    Boolean? @default(true)
  tipMin        Decimal? @default(1) @db.Decimal(18, 2)
  tipMax        Decimal? @default(100) @db.Decimal(18, 2)
  verified      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  earnings     CreatorEarning[]
  subscriptions Subscription[]
  channels     Channel[]
  challenges   CreatorChallenge[]
  payoutRequests PayoutRequest[]
  exclusiveContent ExclusiveContent[]
  contentItems ContentItem[]

  @@map("creator_profiles")
}

model CreatorEarning {
  id          String   @id @default(uuid())
  creatorId   String
  amount      Decimal  @db.Decimal(18, 2)
  type        String   // tip, subscription, rental, payout
  referenceId String?
  status      String   @default("pending")
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_earnings")
  @@index([creatorId])
  @@index([type])
  @@index([status])
}

model Channel {
  id          String   @id @default(uuid())
  creatorId   String
  name        String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("channels")
  @@index([creatorId])
}

model CreatorChallenge {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  description String
  prize       String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entries ChallengeEntry[]

  @@map("creator_challenges")
  @@index([creatorId])
  @@index([status])
}

model ChallengeEntry {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  contentUrl  String
  // Review lifecycle: pending → under_review → winner | rejected.
  // 'rejected' is terminal; 'winner' may still be overturned by re-review.
  status      String   @default("pending")
  reviewedAt  DateTime?
  reviewedBy  String?
  // Moderator's note to the participant (why it was rejected, what to
  // improve, …). Surfaced to the creator in the portal submissions view.
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge CreatorChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("challenge_entries")
  @@index([userId])
  @@index([status])
}

model PayoutRequest {
  id             String   @id @default(uuid())
  creatorId      String
  userId         String?
  amount         Decimal  @db.Decimal(18, 2)
  currency       String?  @default("NGN")
  method         String
  accountDetails Json?
  metadata       Json?
  status         String   @default("pending")
  processedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("payout_requests")
  @@index([creatorId])
  @@index([status])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  creatorId String
  tier      String   @default("free")
  status    String   @default("active")
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, creatorId])
  @@map("subscriptions")
  @@index([userId])
  @@index([creatorId])
  @@index([status])
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  creatorId  String
  amount    Decimal  @db.Decimal(18, 2)
  currency  String   @default("NGN")
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("TipFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User @relation("TipTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@map("tips")
  @@index([fromUserId])
  @@index([toUserId])
  @@index([creatorId])
  @@index([createdAt])
}

model TipLeaderboard {
  id          String   @id @default(uuid())
  creatorId   String
  userId      String
  totalAmount Decimal  @db.Decimal(18, 2) @default(0)
  tier        String   @default("")
  lastTipAt   DateTime @default(now())

  @@unique([creatorId, userId])
  @@map("tip_leaderboard")
  @@index([creatorId])
  @@index([creatorId, totalAmount])
}

model ExclusiveContent {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  description String?
  mediaUrl    String
  minTier     String   @default("gold")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("exclusive_content")
  @@index([creatorId])
  @@index([minTier])
}

model VerificationDocument {
  id          String   @id @default(uuid())
  userId      String
  documentType String
  documentUrl String
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("verification_documents")
  @@index([userId])
  @@index([status])
}

model MediaUpload {
  id        String   @id @default(uuid())
  userId    String
  fileName  String
  mimeType  String
  size      BigInt
  status    String   @default("pending")
  uploadId  String   @unique
  assetId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("media_uploads")
  @@index([userId])
  @@index([uploadId])
  @@index([status])
}

model ContentItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  mediaUrl    String
  universeId  String
  creatorId   String
  status      String   @default("pending")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  universe Universe?      @relation(fields: [universeId], references: [id], onDelete: Restrict)

  @@map("content_items")
  @@index([creatorId])
  @@index([universeId])
  @@index([status])
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  icon        String?
  isEnabled   Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("universes")
  @@index([name])
  @@index([isEnabled])
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  verificationDocuments VerificationDocument[]
  mediaUploads          MediaUpload[]
  notifications         Notification[]
  tipsGiven             Tip[] @relation("TipFrom")
  tipsReceived          Tip[] @relation("TipTo")
  subscriptions         Subscription[]

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([type])
}

// Reference-only: canonical Wallet/WalletTransaction owned by wallet-service.
// Use wallet-service API for wallet operations; these are denormalized snapshots.
model WalletSnapshot {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransactionSnapshot[]

  @@map("wallet_snapshots")
  @@index([userId])
}

model WalletTransactionSnapshot {
  id          String   @id @default(uuid())
  walletId    String
  type        String   // credit, debit
  amount      Decimal  @db.Decimal(18, 2)
  description String
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet WalletSnapshot? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transaction_snapshots")
  @@index([walletId])
  @@index([type])
}

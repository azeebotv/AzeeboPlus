generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model UniverseMap {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  data        Json?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters  Character[]
  locations   Location[]
  timeline    TimelineEvent[]
  titles      Title[]
  loreEntries LoreEntry[]
  realms      Realm[]
  orisaFiles  OrisaFile[]
  artifacts   Artifact[]
  prophecies  Prophecy[]
  worldMaps   WorldMap[]
  rooms       Room[]

  @@index([slug])
  @@index([status])
  @@map("universe_maps")
}

model Location {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  universeId  String
  parentId    String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  parent      Location?   @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[]  @relation("LocationHierarchy")
  characters  CharacterLocation[]
  timeline    TimelineEvent[]

  @@index([universeId])
  @@index([parentId])
  @@map("locations")
}

model Character {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  role        String?
  status      String   @default("active")
  universeId  String
  birthDate   DateTime?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  locations   CharacterLocation[]
  relationshipsFrom CharacterRelationship[] @relation("CharacterFrom")
  relationshipsTo   CharacterRelationship[] @relation("CharacterTo")
  timeline    TimelineEvent[]

  @@index([universeId])
  @@index([slug])
  @@map("characters")
}

model CharacterLocation {
  id          String   @id @default(uuid())
  characterId String
  locationId  String
  role        String?
  description String?
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([characterId, locationId])
  @@index([characterId])
  @@index([locationId])
  @@map("character_locations")
}

model CharacterRelationship {
  id          String   @id @default(uuid())
  fromId      String
  toId        String
  type        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  from   Character @relation("CharacterFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Character @relation("CharacterTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([type])
  @@map("character_relationships")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String
  importance  String   @default("normal")
  universeId  String
  characterId String?
  locationId  String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  character   Character?  @relation(fields: [characterId], references: [id])
  location    Location?   @relation(fields: [locationId], references: [id])

  @@index([universeId])
  @@index([characterId])
  @@index([date])
  @@map("timeline_events")
}

model Title {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String
  description String?
  coverImage  String?
  releaseYear Int?
  endYear     Int?
  status      String   @default("ongoing")
  rating      Float?
  universeId  String
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  recaps      Recap[]
  crossovers  CrossoverTitle[]
  chapters    Chapter[]

  @@index([universeId])
  @@index([status])
  @@map("titles")
}

model Chapter {
  id          String   @id @default(uuid())
  titleId     String
  number      Float
  name        String?
  description String?
  coverImage  String?
  content     String?
  wordCount   Int?
  status      String   @default("published")
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  title       Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@map("chapters")
}

model LoreEntry {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String
  content     String
  excerpt     String?
  coverImage  String?
  importance  String   @default("normal")
  universeId  String
  viewCount   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([category])
  @@map("lore_entries")
}

model Crossover {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("announced")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  titles      CrossoverTitle[]

  @@index([status])
  @@map("crossovers")
}

model CrossoverTitle {
  id          String   @id @default(uuid())
  crossoverId String
  titleId     String

  crossover   Crossover @relation(fields: [crossoverId], references: [id], onDelete: Cascade)
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([crossoverId, titleId])
  @@index([crossoverId])
  @@index([titleId])
  @@map("crossover_titles")
}

model Recap {
  id          String   @id @default(uuid())
  titleId     String
  season      Int?
  episode     Int?
  name        String?
  content     String
  coverImage  String?
  isSpoiler   Boolean  @default(false)
  viewCount   Int      @default(0)
  status      String   @default("published")
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  title       Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@map("recaps")
}

model Realm {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  universeId  String
  type        String   @default("physical") // physical, spiritual, ancestral, divine
  parentId    String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  parent      Realm?      @relation("RealmHierarchy", fields: [parentId], references: [id])
  children    Realm[]     @relation("RealmHierarchy")

  @@index([universeId])
  @@index([slug])
  @@index([type])
  @@map("realms")
}

model OrisaFile {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  title       String
  description String?
  imageUrl    String?
  universeId  String
  domain      String? // wind, iron, love, justice, etc.
  symbols     String[] // thunderstone, mirror, etc.
  status      String   @default("active")
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([slug])
  @@index([domain])
  @@map("orisa_files")
}

model Artifact {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  universeId  String
  type        String   @default("physical") // physical, spiritual, ancestral
  power       String? // description of the artifact's power
  origin      String? // where the artifact came from
  status      String   @default("active")
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([slug])
  @@index([type])
  @@map("artifacts")
}

model Prophecy {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  content     String
  excerpt     String?
  imageUrl    String?
  universeId  String
  source      String? // who or what delivered the prophecy
  status      String   @default("active") // active, fulfilled, broken
  fulfilledAt DateTime?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([slug])
  @@index([status])
  @@map("prophecies")
}

model WorldMap {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  universeId  String
  type        String   @default("geographic") // geographic, spiritual, timeline
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([slug])
  @@index([type])
  @@map("world_maps")
}

model Room {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  universeId  String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    UniverseMap @relation(fields: [universeId], references: [id], onDelete: Cascade)
  posts       RoomPost[]

  @@index([universeId])
  @@index([slug])
  @@map("rooms")
}

model RoomPost {
  id          String   @id @default(uuid())
  roomId      String
  content     String
  authorId    String
  authorName  String
  authorAvatar String?
  spoilerLevel String  @default("none")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([authorId])
  @@map("room_posts")
}

model Theory {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  authorId    String
  authorName  String
  spoilerLevel String  @default("none")
  accessLevel String   @default("public") // public, followers, premium
  status      String   @default("published")
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([slug])
  @@index([status])
  @@index([accessLevel])
  @@map("theories")
}

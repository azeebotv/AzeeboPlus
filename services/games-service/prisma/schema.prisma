generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// NOTE: This User model is duplicated from auth-service for local relation support.
/// Consider removing this and using userId: String references instead (see creator-service pattern).
/// The canonical User definition is in packages/shared-types/prisma/user.prisma
model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  password                String
  displayName             String
  avatar                  String?
  role                    String   @default("user")
  preferences             Json?
  notificationPreferences Json?
  trustScore              Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  watchHistory              WatchHistory[]
  savedItems                SavedItem[]
  wallet                    Wallet?
  notifications             Notification[]
  contentItems              ContentItem[]
  creatorProfile            CreatorProfile?
  rewardAccount             RewardAccount?
  userSearches              UserSearch[]
  productEvents             ProductEvent[]
  reportsAsReporter         Report[]            @relation("Reporter")
  reportsAsReported         Report[]            @relation("Reported")
  moderationCases           ModerationCase[]    @relation("ModerationUser")
  resolvedModerationCases   ModerationCase[]    @relation("ResolvedBy")
  appeals                   Appeal[]
  tipsAsSender              Tip[]               @relation("Sender")
  tipsAsReceiver            Tip[]               @relation("Receiver")
  subscriptionsAsSubscriber Subscription[]      @relation("Subscriber")
  subscriptionsAsCreator    Subscription[]      @relation("Creator")
  creatorEarnings           CreatorEarning[]
  gameSessions              GameSession[]
  gamePlaySessions          GamePlaySession[]
  scoreEntries              ScoreEntry[]
  tournamentEntries         TournamentEntry[]
  PaymentIntent             PaymentIntent[]
  MissionCompletion         MissionCompletion[]
  RewardRedemption          RewardRedemption[]
  PointsLedger              PointsLedger[]

  @@map("users")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("watch_history")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("saved_items")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance Decimal    @default(0)
  bonusBalance Decimal    @default(0)
  promoBalance Decimal    @default(0)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String // credit, debit, bonus, promo, refund
  amount Decimal
  status      String // pending, completed, failed, reversed
  description String?
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system, payment, reward, content, social
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PaymentIntent {
  id                String    @id @default(uuid())
  userId            String
  amount Decimal
  currency          String    @default("NGN")
  status            String // pending, processing, completed, failed, refunded
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payment_intents")
}

model Refund {
  id                String   @id @default(uuid())
  paymentIntentId   String
  amount Decimal
  reason            String
  status            String // pending, processing, completed, failed
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  mediaUrl    String?
  universeId  String
  creatorId   String
  status      String // draft, pending, published, archived
  viewCount   Int       @default(0)
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  universe         Universe        @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset?
  categories       Category[]
  tags             Tag[]
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?
  Report           Report[]

  @@map("content_items")
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  subscribers  Subscription[]
  earnings     CreatorEarning[]

  @@map("creator_profiles")
}

model RewardAccount {
  id            String    @id @default(uuid())
  userId        String    @unique
  points        Int       @default(0)
  levelId       String
  streak        Int       @default(0)
  lastLoginAt   DateTime  @default(now())
  lastCheckInAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  Level   @relation(fields: [levelId], references: [id])
  badges Badge[]

  @@map("reward_accounts")
}

model Level {
  id        String   @id @default(uuid())
  name      String
  rank      Int      @unique
  minPoints Int
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("levels")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  points      Int
  type        String // daily, weekly, monthly, one-time
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards     MissionReward[]
  completions MissionCompletion[]

  @@map("missions")
}

model MissionReward {
  id        String   @id @default(uuid())
  missionId String
  rewardId  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@map("mission_rewards")
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_completions")
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        String // points, bonus, promo
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions   RewardRedemption[]
  MissionReward MissionReward[]

  @@map("rewards")
}

model RewardRedemption {
  id         String   @id @default(uuid())
  userId     String
  rewardId   String
  pointsCost Int
  redeemedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  type      String // credit, debit
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
}

model SearchQueryLog {
  id           String   @id @default(uuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearchAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userSearches UserSearch[]

  @@map("search_query_logs")
}

model UserSearch {
  id           String   @id @default(uuid())
  userId       String
  queryId      String
  resultsCount Int
  createdAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query SearchQueryLog @relation(fields: [queryId], references: [id])

  @@map("user_searches")
}

model ProductEvent {
  id        String   @id @default(uuid())
  type      String // content_view, play_start, play_complete, etc.
  userId    String?
  sessionId String?
  metadata  Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_events")
}

model Report {
  id               String    @id @default(uuid())
  reportingUserId  String
  type             String // harassment, hate_speech, violence, sexual_content, copyright, spam, other
  contentId        String?
  userId           String?
  reason           String
  status           String // pending, in_review, resolved, dismissed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reportingUser  User?           @relation("Reporter", fields: [reportingUserId], references: [id], onDelete: Cascade)
  reportedUser   User?           @relation("Reported", fields: [userId], references: [id], onDelete: Cascade)
  content        ContentItem?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ModerationCase ModerationCase?

  @@map("reports")
}

model ModerationCase {
  id               String    @id @default(uuid())
  reportId         String    @unique
  userId           String
  status           String // pending, in_review, resolved, appealed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user           User     @relation("ModerationUser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedByUser User?    @relation("ResolvedBy", fields: [resolvedBy], references: [id])
  Appeal         Appeal[]

  @@map("moderation_cases")
}

model Appeal {
  id               String    @id @default(uuid())
  caseId           String
  userId           String
  reason           String
  status           String // pending, in_review, successful, rejected
  resolvedBy       String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount Decimal
  createdAt  DateTime @default(now())

  fromUser User @relation("Sender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("Receiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("tips")
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  creatorId String
  tier      String    @default("free")
  status    String    @default("active")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user             User            @relation("Subscriber", fields: [userId], references: [id], onDelete: Cascade)
  creator          User            @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?

  @@unique([userId, creatorId])
  @@map("subscriptions")
}

model CreatorEarning {
  id          String    @id @default(uuid())
  creatorId   String
  amount Decimal
  type        String // tip, subscription, rental, payout
  referenceId String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?

  @@map("creator_earnings")
}

model GameSession {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  questionId  String?
  status      String // active, completed, failed
  score       Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question  Question? @relation(fields: [questionId], references: [id])

  @@map("game_sessions")
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String // daily, weekly, tournament
  points      Int      @default(10)
  status      String   @default("active")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  sessions  GameSession[]

  @@map("challenges")
}

model Question {
  id          String   @id @default(uuid())
  challengeId String
  question    String
  answer      String
  options     Json?
  points      Int      @default(10)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sessions  GameSession[]

  @@map("questions")
}

model ScoreEntry {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("score_entries")
}

model Tournament {
  id          String    @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  entryFee Decimal     @default(0)
  prizePool Decimal
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prizes  TournamentPrize[]
  entries TournamentEntry[]
  matches TournamentMatch[]

  @@map("tournaments")
}

model TournamentPrize {
  id           String   @id @default(uuid())
  tournamentId String
  rank         Int
  amount Decimal
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_prizes")
}

model TournamentEntry {
  id           String   @id @default(uuid())
  userId       String
  tournamentId String
  score        Int      @default(0)
  enteredAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@map("tournament_entries")
}

model Game {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  thumbnail   String?
  category    String
  difficulty  String   @default("medium")
  playCount   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions GameQuestion[]
  sessions  GamePlaySession[]

  @@index([category])
  @@index([isActive])
  @@map("games")
}

model GameQuestion {
  id          String   @id @default(uuid())
  gameId      String
  question    String
  answer      String
  options     Json?
  points      Int      @default(10)
  order       Int      @default(0)
  timeLimit   Int      @default(30)
  createdAt   DateTime @default(now())

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessions GameAnswer[]

  @@index([gameId])
  @@map("game_questions")
}

model GameAnswer {
  id          String   @id @default(uuid())
  sessionId   String
  questionId  String
  answer      String
  isCorrect   Boolean
  timeTaken   Int
  pointsEarned Int     @default(0)
  createdAt   DateTime @default(now())

  session  GamePlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question GameQuestion    @relation(fields: [questionId], references: [id])

  @@index([sessionId])
  @@map("game_answers")
}

model GamePlaySession {
  id          String    @id @default(uuid())
  userId      String
  gameId      String
  score       Int       @default(0)
  correctCount Int      @default(0)
  status      String    @default("active") // active, completed, abandoned
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers  GameAnswer[]

  @@index([userId])
  @@index([gameId])
  @@map("game_play_sessions")
}

model TournamentMatch {
  id            String   @id @default(uuid())
  tournamentId  String
  player1Id    String
  player2Id    String
  player1Score Int      @default(0)
  player2Score Int      @default(0)
  round        Int
  status       String   @default("pending") // pending, in_progress, completed
  winnerId     String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([status])
  @@map("tournament_matches")
}

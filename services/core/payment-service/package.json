{
  "name": "@azeebo/payment-service",
  "version": "0.1.0",
  "private": true,
  "description": "Azeebo+ Payment Service",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "bash start-dev.sh",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e:failover": "RUN_PAYMENT_FAILOVER_E2E=1 jest payments.failover.e2e --runInBand",
    "test:cov": "jest --coverage",
    "test:mutate": "stryker run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@azeebo/error-handling": "workspace:*",
    "@azeebo/feature-flags": "workspace:*",
    "@azeebo/observability": "workspace:*",
    "@azeebo/opentelemetry": "workspace:*",
    "@azeebo/logger": "workspace:*",
    "@azeebo/security": "workspace:*",
    "@azeebo/shared-services": "workspace:*",
    "@azeebo/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.18.0",
    "body-parser": "^2.3.0",
    "check-disk-space": "^3.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@azeebo/utils": "workspace:*",
    "@azeebo/flag-metrics": "workspace:*"

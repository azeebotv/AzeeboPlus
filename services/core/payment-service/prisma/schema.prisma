generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  directUrl   = env("DIRECT_DATABASE_URL")
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  amount        Decimal  @db.Decimal(18, 2)
  currency      String    @default("NGN")
  status        String    @default("pending")
  type          String    @default("payment")
  provider      String?
  providerRef   String?
  failureReason String?
  refundAmount  Decimal? @db.Decimal(18, 2)
  metadata      Json?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("payments")
  @@index([userId])
  @@index([status])
  @@index([providerRef])
  @@unique([provider, providerRef])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  eventId       String    @unique
  provider      String
  type          String
  payload       Json
  result        String    @default("success")
  failureReason String?
  processedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("webhook_events")
  @@index([eventId])
  @@index([type])
  @@index([provider])
  @@index([result])
}

model WebhookRetry {
  id              String    @id @default(cuid())
  eventId         String
  provider        String
  type            String
  payload         Json
  retryCount      Int       @default(0)
  maxRetries      Int       @default(5)
  nextRetryAt     DateTime
  status          String    @default("pending") // pending, processing, failed, completed
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("webhook_retries")
  @@index([eventId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([provider])
}

model PaymentIntent {
  id               String    @id @default(cuid())
  userId           String
  amount           Decimal  @db.Decimal(18, 2)
  currency         String    @default("NGN")
  status           String    @default("pending")
  description      String?
  providerReference String?
  metadata         Json?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  idempotencyKey   String?   @unique
  refundAmount     Decimal? @db.Decimal(18, 2)
  version          Int       @default(0)

  refunds Refund[]

  @@map("payment_intents")
  @@index([userId])
  @@index([providerReference])
  @@index([status])
  @@index([idempotencyKey])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  voucherCode String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CartItem[]

  @@map("carts")
  @@index([userId])
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  itemType    String   // 'pass' | 'coins' | 'subscription'
  itemId      String
  name        String
  description String?
  price       Decimal  @db.Decimal(18, 2)
  quantity    Int      @default(1)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_items")
  @@index([cartId])
}

model Refund {
  id               String    @id @default(cuid())
  paymentIntentId  String
  amount           Decimal  @db.Decimal(18, 2)
  reason           String
  status           String    @default("pending")
  providerReference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  idempotencyKey   String?   @unique

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
  @@index([paymentIntentId])
  @@index([status])
  @@index([idempotencyKey])
}

// Category A migration: tokenized payment methods stored locally for
// user-facing card management. Sensitive card data stays at the provider;
// this table stores only the token, brand, last4, and expiry for display.
model PaymentMethod {
  id              String   @id @default(cuid())
  userId          String
  provider        String   // paystack, flutterwave
  providerToken   String   // provider-side tokenization reference
  type            String   // card, bank_account, ussd
  brand           String?  // visa, mastercard, verve
  last4           String?
  expiryMonth     Int?
  expiryYear      Int?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("payment_methods")
  @@index([userId])
  @@index([provider])
  @@index([isDefault])
  @@unique([userId, provider, providerToken])
}

model CoinPackage {
  id          String   @id @default(uuid())
  name        String
  description String?
  coins       Int
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("NGN")
  bonus       Int      @default(0)
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("coin_packages")
}


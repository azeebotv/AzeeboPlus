generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  directUrl   = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  user
  creator
  moderator
  admin
  super_admin
}

enum LinkStatus {
  pending
  confirmed
  denied
  expired
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String   @default("")
  displayName     String
  avatar          String?
  role            UserRole @default(user)
  preferences     Json?
  isVerified      Boolean  @default(false)
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?
  mfaBackupCodes  String?
  // Admin-owned fields: written by apps/admin through the federated
  // azeebo_admin.users foreign table; auth-service never reads them.
  isSuspended           Boolean   @default(false)
  suspendedAt           DateTime?
  suspendedBy           String?
  suspendedUntil        DateTime?
  suspensionReason      String?
  notificationPreferences Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions Session[]
  otps     Otp[]
  socialAccounts SocialAccount[]
  devices  RegisteredDevice[]
  deviceLinkCodes DeviceLinkCode[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model RegisteredDevice {
  id            String   @id @default(uuid())
  userId        String
  deviceName    String
  deviceType    String   // "mobile", "web", "desktop", "tablet"
  os            String?
  browser       String?
  fingerprint   String?  // Device fingerprint hash
  isTrusted     Boolean  @default(false)
  lastActiveAt  DateTime @default(now())
  registeredAt  DateTime @default(now())
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isTrusted])
  @@map("registered_devices")
}

model DeviceLinkCode {
  id            String     @id @default(uuid())
  deviceCode    String     @unique // HMAC-SHA256 of the high-entropy device credential — only the TV holds it
  code          String     @unique // HMAC-SHA256 of the short on-screen code — never store plaintext
  status        LinkStatus @default(pending)
  userId        String?
  deviceName    String?
  deviceType    String     @default("tv")
  intervalSec   Int        @default(5) // RFC 8628 device_authorization_endpoint style polling hint
  attempts      Int        @default(0) // Failed confirmation attempts (wrong code on /link)
  tokenIssued   Boolean    @default(false) // Set once the TV has claimed the tokens (poll-once semantics)
  expiresAt     DateTime
  lastPolledAt  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([userId])
  @@map("device_link_codes")
}

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  socialId    String
  accessToken String?  // Not stored — always empty string in application code
  refreshToken String? // Hashed with bcrypt before storage (see social.service.ts)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([socialId, provider])
  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@map("social_accounts")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique // Hashed with bcrypt at write time — never store plaintext
  expiresAt    DateTime
  deviceName   String?
  deviceType   String?
  os           String?
  browser      String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Otp {
  id          String   @id @default(uuid())
  userId      String   @unique
  code        String   // Hashed with bcrypt at write time — never store plaintext
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("otps")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id           String   @id @default(uuid())
  actor        String?
  action       String
  resourceType String?
  resourceId   String?
  result       String
  error        String?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([actor])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

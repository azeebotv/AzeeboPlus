# =============================================================================
# Authentication Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SERVICE_NAME=auth-service

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_auth?schema=public&sslmode=require
# Migration-time only (Prisma directUrl - bypasses PgBouncer for migrations).
# The generated client never reads this at boot; safe to leave as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_auth?schema=public&sslmode=require


# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=rediss://localhost:6380

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production

# Device-link TV sign-in (RFC 8628-style). Optional: defaults derive the code
# hashing secret from JWT_ACCESS_SECRET and set the TV poll interval to 5s.
# DEVICE_LINK_HASH_SECRET=change-me-in-production
# DEVICE_LINK_POLL_INTERVAL=5
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
GATEWAY_SECRET=change-me-gateway-secret-min-32-chars
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_AUDIENCE=azeebo-api
JWT_ISSUER=azeebo-auth

# Token expiration times
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Minimum length for JWT secrets (must be >= 32)
JWT_SECRET_MIN_LENGTH=32

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for OTP, password reset)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@azeeboplus.com

# -----------------------------------------------------------------------------
# SMS Configuration (Optional - for OTP)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Monitoring & Metrics
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Social Auth (Google / Apple) — see docs/product/prd-social-login.md
# -----------------------------------------------------------------------------
# The authorize endpoints redirect to the provider and the web app completes the
# callback. Setting these is what makes the login buttons work; unset ones answer
# 503 instead of minting a URL with an empty client_id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MUST be the WEB app callback, e.g. http://localhost:4000/auth/callback
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
# Apple has no static client secret: the secret is a short-lived ES256 JWT
# signed with these. APPLE_PRIVATE_KEY is the .p8 contents — secret store only.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
# There is deliberately no APPLE_CLIENT_SECRET: the client secret is minted at
# request time as an ES256 JWT from APPLE_TEAM_ID / APPLE_KEY_ID /
# APPLE_PRIVATE_KEY (see social/apple-client-secret.service.ts).
# The legacy SOCIAL_AUTH_ALLOWED_REDIRECT_HOSTS allowlist is gone — the return
# target now travels in the server-side OAuth state record instead.

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_MFA=true
ENABLE_SOCIAL_AUTH=true
ENABLE_OTP=true

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
ANALYTICS_SERVICE_URL=http://analytics-service:3008

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]
  passes       Pass[]
  featureFlags UniverseFeatureFlag[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id            String   @id @default(uuid())
  title         String
  description   String?
  thumbnail     String
  mediaUrl      String?
  universeId    String
  creatorId     String
  status        String   // draft, pending, published, archived
  viewCount     Int      @default(0)
  metadata      Json?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  releaseDate   DateTime?
  theatricalReleaseDate DateTime?
  streamingReleaseDate DateTime?
  windowEndDate DateTime?
  windowType    String   @default("standard") // premium, standard, basic
  isExclusive   Boolean  @default(false)
  isPremiere    Boolean  @default(false)
  // Geo restriction fields
  allowedCountries String[] // ISO country codes; empty = worldwide
  blockedCountries String[] // Countries where content is blocked
  contentRating    String?  // "G", "PG", "PG-13", "R", "NC-17", "18+"
  minAge           Int?     // Minimum age requirement

  universe    Universe    @relation(fields: [universeId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset?
  categories  Category[]
  tags        Tag[]
  comments    Comment[]
  rentals     Rental[]
  screenings  Screening[]
  lockedExtras LockedExtra[]
  watchHistory WatchHistory[]
  relationshipsAsContent ContentRelationship[] @relation("ContentRelationshipContent")
  relationshipsAsRelatedContent ContentRelationship[] @relation("ContentRelationshipRelatedContent")

  @@map("content_items")
  @@index([universeId])
  @@index([creatorId])
  @@index([status])
  @@index([viewCount])
  @@index([publishedAt])
  @@index([releaseDate])
  @@index([isExclusive])
  @@index([isPremiere])
  @@index([universeId, status])
  @@index([creatorId, status])
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int // Max ~2GB; use BigInt if larger files are needed
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model ContentRelationship {
  id            String   @id @default(uuid())
  contentId     String
  relatedContentId String
  type          String   // sequel, prequel, related, series, remake, adaptation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  content       ContentItem @relation("ContentRelationshipContent", fields: [contentId], references: [id], onDelete: Cascade)
  relatedContent ContentItem @relation("ContentRelationshipRelatedContent", fields: [relatedContentId], references: [id], onDelete: Cascade)

  @@map("content_relationships")
  @@unique([contentId, relatedContentId])
  @@index([contentId])
  @@index([relatedContentId])
  @@index([type])
}

model Comment {
  id           String   @id @default(uuid())
  contentId    String
  userId       String
  text         String
  parentId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parent       Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]   @relation("CommentReplies")

  @@map("comments")
  @@index([contentId])
  @@index([userId])
  @@index([parentId])
}

model Rental {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  startTime   DateTime @default(now())
  endTime     DateTime
  status      String   @default("active") // active, expired, cancelled
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  transactionId String?  // No FK — server-side validation against payment-service required
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("rentals")
  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([status])
  @@index([endTime])
}

model Pass {
  id          String   @id @default(uuid())
  userId      String
  passType    String   // daily, weekly, monthly, yearly
  universeId  String?
  status      String   @default("active") // active, expired, cancelled, suspended
  startTime   DateTime @default(now())
  endTime     DateTime
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  transactionId String?
  autoRenew   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    Universe? @relation(fields: [universeId], references: [id], onDelete: SetNull)

  @@map("passes")
  @@index([userId])
  @@index([universeId])
  @@index([status])
  @@index([endTime])
}

model Screening {
  id            String   @id @default(uuid())
  contentId     String
  screeningTime DateTime
  endTime       DateTime
  location      String?
  streamUrl     String?
  status        String   @default("scheduled") // scheduled, live, ended, cancelled
  maxViewers    Int?
  currentViewers Int     @default(0) // Use Prisma's `increment` for atomic updates (PostgreSQL row-level lock)
  price         Decimal? @db.Decimal(18, 2)
  currency      String   @default("NGN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  content       ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("screenings")
  @@index([contentId])
  @@index([screeningTime])
  @@index([status])
}

model LockedExtra {
  id          String   @id @default(uuid())
  contentId   String
  extraType   String   // behind_paywall, bonus_content, director_commentary, deleted_scene, extended_version
  title       String
  description String?
  thumbnail   String?
  mediaUrl    String?
  price       Decimal? @db.Decimal(18, 2)
  currency    String   @default("NGN")
  unlockType  String   @default("purchase") // purchase, rental, pass, subscription
  isUnlocked  Boolean  @default(false) // Should be computed at query time from UserUnlock, not stored
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("locked_extras")
  @@index([contentId])
  @@index([extraType])
}

model UserUnlock {
  id          String   @id @default(uuid())
  userId      String
  unlockType  String   // rental, pass, screening, locked_extra
  resourceId  String
  transactionId String?
  price       Decimal? @db.Decimal(18, 2)
  currency    String   @default("NGN")
  unlockedAt  DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_unlocks")
  @@unique([userId, unlockType, resourceId])
  @@index([userId])
  @@index([unlockType])
  @@index([resourceId])
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  progress    Int      @default(0)
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("watch_history")
  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([watchedAt])
}

model UniverseFeatureFlag {
  id          String   @id @default(uuid())
  universeId  String
  featureKey  String   // e.g., "voting_enabled", "predictions_enabled", "live_chat_enabled"
  isEnabled   Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe    Universe  @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@map("universe_feature_flags")
  @@unique([universeId, featureKey])
  @@index([universeId])
  @@index([featureKey])
}

model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "site_name", "site_description", "seo_title"
  value       Json     // Flexible JSON value for different setting types
  category    String   @default("general") // general, seo, social, email, etc.
  description String?
  isPublic    Boolean  @default(false) // If true, can be accessed by non-admin users
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
  @@index([category])
  @@index([isPublic])
}

model GeoRestriction {
  id              String   @id @default(uuid())
  countryCode     String   // ISO 3166-1 alpha-2
  countryName     String
  isActive        Boolean  @default(true)
  blockedContent  String[] // Content IDs or categories blocked in this country
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("geo_restrictions")
  @@unique([countryCode])
  @@index([countryCode])
  @@index([isActive])
}

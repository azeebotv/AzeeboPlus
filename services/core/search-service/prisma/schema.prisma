generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Category A migration: admin-managed suggestion entries for the search
// autocomplete. When present, these are merged with aggregate-driven
// suggestions from SearchQueryLog.
model Suggestion {
  id          String   @id @default(uuid())
  term        String   @unique
  type        String   // trending, promoted, category, manual
  universe    String?  // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  weight      Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("suggestions")
  @@index([type])
  @@index([universe])
  @@index([isActive])
  @@index([weight])
}

// Category A migration: deterministic, admin-managed ranking rules applied
// at query time alongside engine-side relevance scoring.
model RankingRule {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  signal      String   // recency, popularity, boost_universe, demote_status
  weight      Decimal  @default(1)
  conditions  Json     // e.g. { universe: "movie", status: "published" }
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ranking_rules")
  @@index([signal])
  @@index([isActive])
  @@index([priority])
}

model UserSearch {
  id            String   @id @default(uuid())
  userId        String
  query         String
  filters       Json?
  resultCount   Int      @default(0)
  clickedId     String?
  lastSearchAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("user_searches")
  @@index([userId])
  @@index([query])
  @@index([createdAt])
  @@index([lastSearchAt])
}

model SearchQueryLog {
  id          String   @id @default(uuid())
  query       String
  userId      String?
  resultCount Int      @default(0)
  clickedId   String?
  session     String?
  createdAt   DateTime @default(now())

  @@map("search_query_logs")
  @@index([query])
  @@index([userId])
  @@index([createdAt])
}

model ContentItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  universeId  String
  universe    String
  contentType String
  status      String   @default("published")
  viewCount   Int      @default(0)
  creatorId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_items")
  @@index([universeId])
  @@index([universe])
  @@index([contentType])
  @@index([status])
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  avatar      String?
  bio         String?
  universe    String?
  email       String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("creator_profiles")
  @@index([userId])
  @@index([universe])
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  icon        String?
  isEnabled   Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("universes")
  @@index([name])
  @@index([isEnabled])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  universeId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
  @@index([name])
  @@index([universeId])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tags")
  @@index([name])
}

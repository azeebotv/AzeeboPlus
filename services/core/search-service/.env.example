# =============================================================================
# Search Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3005
SERVICE_NAME=search-service

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_search?schema=public&sslmode=require

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=rediss://localhost:6380

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Must match auth-service JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
GATEWAY_SECRET=change-me-gateway-secret-min-32-chars
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_AUDIENCE=azeebo-api
JWT_ISSUER=azeebo-auth

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
SEARCH_RESULTS_PER_PAGE=20
MAX_SEARCH_RESULTS=100

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
ANALYTICS_SERVICE_URL=http://analytics-service:3008

# -----------------------------------------------------------------------------
# Index Population (scheduled denormalization from the content DB)
# -----------------------------------------------------------------------------
# The content-service database the population job reads from. The search index
# lives in DATABASE_URL (azeebo_search); this is the *source* (azeebo_content).
CONTENT_DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_content?schema=public
# Cron expression for the population job (default: every 5 minutes).
SEARCH_INDEX_POPULATION_CRON=*/5 * * * *
# Rows fetched + upserted per keyset page.
SEARCH_INDEX_POPULATION_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Index Repair (self-healing GIN trigram indexes)
# -----------------------------------------------------------------------------
# Cron expression for the missing-index repair job (default: every 5 minutes,
# matching the SearchPgTrgmIndexesMissing alert's `for: 5m`).
SEARCH_INDEX_REPAIR_CRON=*/5 * * * *
# Minimum gap between repair attempts in ms (also rate-limits failures).
SEARCH_INDEX_REPAIR_COOLDOWN_MS=300000

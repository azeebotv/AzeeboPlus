# =============================================================================
# Knowledge Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3020
SERVICE_NAME=knowledge-service

# Swagger docs at /api are mounted only when NODE_ENV != production AND
# SWAGGER_ENABLED=true (mirrors the API gateway's /docs posture).
SWAGGER_ENABLED=false

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_knowledge?schema=public&sslmode=require
# Migration-time only (Prisma directUrl - bypasses PgBouncer for migrations).
# The generated client never reads this at boot; safe to leave as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_knowledge?schema=public&sslmode=require


# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
GATEWAY_SECRET=change-me-gateway-secret-min-32-chars
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
JWT_AUDIENCE=azeebo-api
JWT_ISSUER=azeebo-auth

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
CONTENT_SERVICE_URL=http://content-service:3004
USER_SERVICE_URL=http://user-service:3001

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
INTERNAL_API_KEY=your-internal-api-key-change-in-production

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  bonusBalance Decimal  @default(0) @db.Decimal(18, 2)
  promoBalance Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(0)

  transactions     WalletTransaction[]
  balanceSnapshots BalanceSnapshot[]
  ledgerEntries    WalletLedger[]

  @@map("wallets")
}

model WalletTransaction {
  id              String   @id @default(uuid())
  walletId        String
  type            String   // credit, debit, bonus, promo, refund
  amount          Decimal  @db.Decimal(18, 2)
  status          String   // pending, completed, failed, reversed
  description     String?
  reference       String?
  provider        String?  // paystack, flutterwave, internal
  providerRef     String?  // Unique provider reference (e.g., Paystack transaction ID)
  metadata        Json?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@index([provider])
  @@index([reference])
  @@unique([provider, providerRef])
  @@index([walletId, createdAt])
}

// Category A migration: point-in-time balance snapshots for reporting.
// Populated by a scheduled job; wallet-service remains the single source
// of truth for the live balance fields on Wallet.
model BalanceSnapshot {
  id           String   @id @default(uuid())
  walletId     String
  balance      Decimal  @db.Decimal(18, 2)
  bonusBalance Decimal  @db.Decimal(18, 2)
  promoBalance Decimal  @db.Decimal(18, 2)
  currency     String   @default("NGN")
  capturedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([capturedAt])
  @@map("balance_snapshots")
}

// Append-only audit ledger (wallet_ledger_v2 flag). Every completed money
// movement writes an immutable entry with the balance after the operation, so
// auditors can reconcile without trusting wallet_transactions (which can be
// reversed). Written by WalletService.writeLedgerEntry when the flag is on.
model WalletLedger {
  id            String   @id @default(uuid())
  walletId      String
  userId        String
  operationType String // credit, debit, withdraw, transfer_out, transfer_in, bonus, promo, refund, charge, reverse
  amount        Decimal  @db.Decimal(18, 2)
  balanceAfter  Decimal  @db.Decimal(18, 2)
  reference     String?
  idempotencyKey String?
  metadata      Json?
  createdAt     DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([operationType])
  @@index([createdAt])
  @@map("wallet_ledger")
}

generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  avatar      String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
  @@index([role])
  @@index([createdAt])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  location    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
  @@index([userId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      String
  grantedBy String
  createdAt DateTime @default(now())

  @@map("user_roles")
  @@unique([userId, role])
  @@index([userId])
}

model UserPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  darkMode        Boolean  @default(false)
  notifications   Json?    @default("{}")
  contentPreferences Json?  @default("[]")
  privacySettings Json?    @default("{\"isPrivate\":false,\"showActivity\":true,\"allowMessages\":true,\"twoFactorEnabled\":false}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_preferences")
  @@index([userId])
}

model WatchHistory {
  id         String   @id @default(uuid())
  userId     String
  contentId  String
  contentType String
  universe   String   @default("unknown")
  watchedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("watch_history")
  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([contentType])
  @@index([watchedAt])
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  @@map("saved_items")
  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([createdAt])
}

model Following {
  id           String   @id @default(uuid())
  followerId   String
  followingId  String
  createdAt    DateTime @default(now())

  @@map("following")
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  planType       String   // basic, standard, premium
  status         String   // active, canceled, expired, paused
  startDate      DateTime @default(now())
  endDate        DateTime?
  nextBillingDate DateTime?
  paymentMethod  String?
  providerId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("subscriptions")
  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([endDate])
}

model UserUniverseAffinity {
  id            String   @id @default(uuid())
  userId        String
  universeId    String
  affinityScore Float    @default(0)
  lastEngaged   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_universe_affinity")
  @@unique([userId, universeId])
  @@index([userId])
  @@index([universeId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  details    Json?    @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([actorId])
  @@index([actorRole])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

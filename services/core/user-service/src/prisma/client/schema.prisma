generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  avatar      String?
  role        String   @default("user")
  preferences Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model UserPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  darkMode           Boolean  @default(false)
  notifications      Json?    @default("{}")
  contentPreferences Json?    @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@map("user_preferences")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  universe    String   @default("unknown")
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([contentType])
  @@index([watchedAt])
  @@map("watch_history")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([createdAt])
  @@map("saved_items")
}

model Following {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("following")
}

model Subscription {
  id              String    @id @default(uuid())
  userId          String
  planType        String // basic, standard, premium
  status          String // active, canceled, expired, paused
  startDate       DateTime  @default(now())
  endDate         DateTime?
  nextBillingDate DateTime?
  paymentMethod   String?
  providerId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([endDate])
  @@map("subscriptions")
}

model UserUniverseAffinity {
  id            String   @id @default(uuid())
  userId        String
  universeId    String
  affinityScore Float    @default(0)
  lastEngaged   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, universeId])
  @@index([userId])
  @@index([universeId])
  @@map("user_universe_affinity")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  details    Json?    @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([actorRole])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("audit_logs")
}

# =============================================================================
# Media Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3019
SERVICE_NAME=media-service

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_media?schema=public&sslmode=require
# Migration-time only (Prisma directUrl - bypasses PgBouncer for migrations).
# The generated client never reads this at boot; safe to leave as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_media?schema=public&sslmode=require


# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=rediss://localhost:6380

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Must match auth-service JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
GATEWAY_SECRET=change-me-gateway-secret-min-32-chars
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_AUDIENCE=azeebo-api
JWT_ISSUER=azeebo-auth

# -----------------------------------------------------------------------------
# AWS S3 Configuration
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=azeebo-media
# Optional: S3-compatible endpoint (MinIO, R2, LocalStack) for dev/self-hosted.
# When set, bucket addressing switches to path-style automatically.
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Upload Configuration
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=50

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
ANALYTICS_SERVICE_URL=http://analytics-service:3008

# -----------------------------------------------------------------------------
# CDN Cache TTLs (seconds) — per-content-type Cache-Control max-age when
# media_cdn_edge_cache is on. Defaults: images immutable 1y, videos 1d,
# audio/documents 7d, unknown 1h. Values must be positive; invalid/unset
# entries fall back to the defaults below.
# -----------------------------------------------------------------------------
MEDIA_CACHE_TTL_IMAGE=31536000
MEDIA_CACHE_TTL_VIDEO=86400
MEDIA_CACHE_TTL_AUDIO=604800
MEDIA_CACHE_TTL_DOCUMENT=604800
MEDIA_CACHE_TTL_DEFAULT=3600

# -----------------------------------------------------------------------------
# CDN Flag Watcher — how often (ms) media_cdn_edge_cache is polled for on→off
# transitions. On a flip-off, a full-prefix purge job (/uploads/*) is queued
# automatically so previously cached uploads are evicted without manual calls
# to POST /admin/cdn/purge. Defaults to 30000 (matches the flag cache TTL).
# -----------------------------------------------------------------------------
MEDIA_CDN_FLAG_POLL_MS=30000

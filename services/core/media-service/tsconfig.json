{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "types": ["jest", "node", "supertest", "multer"],
    "paths": {
      "@azeebo/security/log-redaction": ["../../../packages/security/dist/log-redaction"],
      "@azeebo/*": ["../../../packages/*/dist"],
      "@media/*": ["./*"]
    },
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "strictPropertyInitialization": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "types": [
      "jest",
      "node",
      "supertest",
      "multer"
    ],
    "paths": {
      "@azeebo/*": ["../../../packages/*/src"],
      "@media/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

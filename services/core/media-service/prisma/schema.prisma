// =============================================================================
// Media Service — Prisma Schema
// =============================================================================
// NOTE: This service primarily uses S3 for file storage and Redis for
// transcoding job tracking. This schema provides persistent metadata
// storage for media assets and upload audit trails.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl   = env("DIRECT_DATABASE_URL")
}

model MediaUpload {
  id            String   @id @default(uuid())
  userId        String
  fileName      String
  originalName  String
  mimeType      String
  size          BigInt
  key           String
  cdnUrl        String?
  folder        String
  status        String   @default("uploaded") // uploaded, processing, completed, failed
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("media_uploads")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Compensating queue for CDN invalidations that failed or were skipped at
/// delete time. Rows are retried by the nightly reconcile/drain job and
/// dead-lettered after CDN_INVALIDATION_MAX_ATTEMPTS.
model CdnInvalidationQueue {
  id          String   @id @default(uuid())
  key         String
  reason      String   @default("failed") // failed, skipped
  attempts    Int      @default(0)
  lastError   String?
  status      String   @default("pending") // pending, done, dead
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cdn_invalidation_queue")
  @@index([status])
}

model TranscodingJob {
  id            String   @id @default(uuid())
  uploadId      String?
  sourceKey     String
  status        String   @default("pending") // pending, processing, completed, failed
  progress      Int      @default(0)
  outputKeys    Json?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("transcoding_jobs")
  @@index([status])
  @@index([uploadId])
}

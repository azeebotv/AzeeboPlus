# =============================================================================
# Support Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3028
SERVICE_NAME=support-service

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_support?schema=public&sslmode=require
# Migration-time only (Prisma directUrl - bypasses PgBouncer for migrations).
# The generated client never reads this at boot; safe to leave as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/azeebo_support?schema=public&sslmode=require


# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=rediss://localhost:6380

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Must match auth-service JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
GATEWAY_SECRET=change-me-gateway-secret-min-32-chars
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_AUDIENCE=azeebo-api
JWT_ISSUER=azeebo-auth

# -----------------------------------------------------------------------------
# Ticket Configuration
# -----------------------------------------------------------------------------
DEFAULT_TICKET_PRIORITY=medium
AUTO_ASSIGN_TICKETS=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
ANALYTICS_SERVICE_URL=http://analytics-service:3008

# Service URLs (service-to-service calls)
CONTENT_SERVICE_URL=http://content-service:3099

# Service URLs (service-to-service calls)
MODERATION_SERVICE_URL=http://moderation-service:3099

# Service URLs (service-to-service calls)
NOTIFICATION_SERVICE_URL=http://notification-service:3099

# Service URLs (service-to-service calls)
PAYMENT_SERVICE_URL=http://payment-service:3099

# Service URLs (service-to-service calls)
USER_SERVICE_URL=http://user-service:3099

# Service URLs (service-to-service calls)
WALLET_SERVICE_URL=http://wallet-service:3099

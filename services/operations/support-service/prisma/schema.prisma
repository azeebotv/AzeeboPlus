generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_INFO
  RESOLVED
  CLOSED
  ESCALATED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketCategory {
  REFUND
  CHARGEBACK
  ACCOUNT_APPEAL
  CONTENT_TAKEDOWN
  PAYOUT_DISPUTE
  USER_SUSPENSION
  GENERAL
}

model SupportTicket {
  id          String               @id @default(uuid())
  userId      String
  orderId     String?
  ticketId    String               @unique @default(uuid()) // Kept for backwards compatibility; prefer using `id` for internal references
  category    SupportTicketCategory
  priority    SupportTicketPriority @default(MEDIUM)
  status      SupportTicketStatus   @default(OPEN)
  subject     String
  description String
  metadata    Json?
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  messages    SupportMessage[]
  refund      Refund?
  chargeback  Chargeback?
  appeal      Appeal?
  takedown    ContentTakedown?
  dispute     PayoutDispute?
  suspension  UserSuspension?

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([assignedTo])
  @@map("support_tickets")
}

enum SenderType {
  USER
  AGENT
  SYSTEM
}

model SupportMessage {
  id         String     @id @default(uuid())
  ticketId   String
  senderId   String
  senderType SenderType
  message   String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("support_messages")
}

model Refund {
  id              String   @id @default(uuid())
  ticketId        String   @unique
  paymentId       String
  userId          String
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   @default("NGN")
  reason          String
  status          String   @default("PENDING")
  refundReference String?
  processedAt     DateTime?
  processedBy     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model Chargeback {
  id              String   @id @default(uuid())
  ticketId        String   @unique
  paymentId       String
  userId          String
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   @default("NGN")
  reason          String
  status          String   @default("PENDING")
  disputeDeadline DateTime
  evidenceDue     DateTime
  chargebackRef   String?
  resolution      String?
  resolvedAt      DateTime?
  resolvedBy      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentId])
  @@index([status])
  @@map("chargebacks")
}

model Appeal {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  userId      String
  appealType  String
  resourceId  String
  resourceType String
  originalDecision String
  reason      String
  evidence    Json?
  status      String   @default("PENDING")
  decision    String?
  decidedAt   DateTime?
  decidedBy   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("appeals")
}

model ContentTakedown {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  contentId   String
  reportedBy  String
  reason      String
  evidence    Json?
  status      String   @default("PENDING")
  decision    String?
  decidedAt   DateTime?
  decidedBy   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([status])
  @@map("content_takedowns")
}

model PayoutDispute {
  id            String   @id @default(uuid())
  ticketId      String   @unique
  creatorId     String
  payoutId      String
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @default("NGN")
  reason        String
  evidence      Json?
  status        String   @default("PENDING")
  resolution    String?
  resolvedAt    DateTime?
  resolvedBy    String?
  compensation  Decimal? @db.Decimal(18, 2)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([payoutId])
  @@index([status])
  @@map("payout_disputes")
}

model UserSuspension {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  userId      String
  reason      String
  suspendedBy  String
  status      String   @default("ACTIVE")
  suspendedAt DateTime @default(now())
  expiresAt   DateTime?
  reinstatedAt DateTime?
  reinstatedBy String?
  evidence    Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("user_suspensions")
}

model WebhookEvent {
  id          String   @id
  type        String
  payload     Json
  provider    String
  processedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider])
  @@index([type])
  @@map("webhook_events")
}

model SupportAnalyticsEvent {
  id        String   @id @default(uuid())
  event     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([event])
  @@index([createdAt])
  @@map("support_analytics_events")
}

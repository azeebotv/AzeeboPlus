generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

// Queue-service owns only the job ledger (observability/retry tracking).
// The runtime queue is backed by Redis (BullMQ); these SQL models mirror
// job state for querying, retries, and dead-letter management.
// Per CLAUDE.md § Cross-Service Model Duplication, this service references
// `userId` as a plain string — it does NOT duplicate the User model or any
// other service's canonical data.

model Job {
  id           String    @id @default(uuid())
  type         String
  payload      Json
  status       String    @default("pending") // pending | processing | completed | failed | retrying
  priority     Int       @default(0)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  nextRetryAt  DateTime?
  lockedAt     DateTime?
  lockedBy     String?
  result       Json?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  retries         JobRetry[]
  deadLetterEntry DeadLetterEntry?

  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@index([status, priority])
  @@map("jobs")
}

model JobRetry {
  id         String   @id @default(uuid())
  jobId      String
  attempt    Int
  error      String
  stackTrace String?
  retriedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([retriedAt])
  @@map("job_retries")
}

model JobSchedule {
  id        String    @id @default(uuid())
  type      String
  cron      String
  payload   Json
  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@index([nextRunAt])
  @@map("job_schedules")
}

model DeadLetterEntry {
  id        String   @id @default(uuid())
  jobId     String   @unique
  type      String
  payload   Json
  error     String
  attempts  Int
  movedAt   DateTime @default(now())
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([movedAt])
  @@map("dead_letter_entries")
}

// Category A migration (persisted on behalf of media-service, which remains
// stateless). media-service enqueues transcoding jobs and creates upload
// sessions via queue-service; these tables give durable queryable state.
// Per CLAUDE.md § Cross-Service Model Duplication, `userId` is a plain
// string reference — the User model is NOT duplicated here.

model TranscodingJob {
  id            String   @id @default(uuid())
  userId        String
  mediaAssetId  String?  // reference to content-service MediaAsset (if linked)
  sourceUrl     String
  outputUrl     String?
  format        String   // mp4, hls, dash
  status        String   @default("pending") // pending | processing | completed | failed
  progress      Int      @default(0)         // 0-100
  profiles      Json     // array of rendition specs {resolution, bitrate, codec}
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([mediaAssetId])
  @@index([createdAt])
  @@map("transcoding_jobs")
}

model UploadSession {
  id            String   @id @default(uuid())
  userId        String
  fileName      String
  fileSize      Int
  fileType      String
  uploadId      String   @unique // S3 multipart upload ID
  bucket        String
  key           String
  parts         Json?    // [{ partNumber, etag, size }]
  totalParts    Int      @default(1)
  completedParts Int     @default(0)
  status        String   @default("pending") // pending | in_progress | completed | aborted | expired
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([uploadId])
  @@index([expiresAt])
  @@map("upload_sessions")
}

{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "types": [
      "node",
      "jest"
    ],
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "paths": {
      "@azeebo/*": ["../../../packages/*/src"],
      "@queue/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts"
  ]
}

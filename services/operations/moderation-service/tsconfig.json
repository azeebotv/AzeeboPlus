{
  "extends": "../../../tsconfig.json"
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": "./",
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@azeebo/*": ["../../../packages/*/src"]
      "@moderation/*": ["./*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
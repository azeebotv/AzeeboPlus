{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@azeebo/*": ["../../../packages/*/dist"],
      "@prisma/client": [
        "./src/prisma/client"
      ],
      "@moderation/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl   = env("DIRECT_DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  avatar      String?
  role        String   @default("user")
  trustScore  Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moderationCases ModerationCase[] @relation("CaseUser")
  resolvedCases   ModerationCase[] @relation("CaseResolver")
  reportedReports Report[]         @relation("ReportReporter")
  reportsAgainst  Report[]         @relation("ReportedUser")
  appeals         Appeal[]
  trustHistory    TrustScoreHistory[] @relation("TrustHistory")
  safetyActions   SafetyAction[]   @relation("ModeratorActions")
  reviewAssignments ReviewerAssignment[] @relation("Reviewer")
  assignedByActions ReviewerAssignment[] @relation("AssignedBy")

  @@map("users")
}

model Content {
  id        String   @id @default(uuid())
  title     String?
  type      String?
  status    String?  @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@map("contents")
}

model Report {
  id               String    @id @default(uuid())
  reportingUserId  String
  type             String // harassment, hate_speech, violence, sexual_content, copyright, spam, other
  contentId        String?
  userId           String?
  reason           String
  status           String // pending, in_review, resolved, dismissed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ModerationCase ModerationCase?
  reportingUser  User?    @relation("ReportReporter", fields: [reportingUserId], references: [id])
  reportedUser   User?    @relation("ReportedUser", fields: [userId], references: [id])
  content        Content? @relation(fields: [contentId], references: [id])

  @@map("reports")
  @@index([reportingUserId])
  @@index([userId])
  @@index([contentId])
  @@index([status])
}

model ModerationCase {
  id               String    @id @default(uuid())
  reportId         String    @unique
  userId           String
  status           String // pending, in_review, resolved, appealed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolution       String?
  notes            String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  report              Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user                User?                 @relation("CaseUser", fields: [userId], references: [id])
  resolvedByUser      User?                 @relation("CaseResolver", fields: [resolvedBy], references: [id])
  Appeal              Appeal[]
  reviewerAssignments ReviewerAssignment[]

  @@map("moderation_cases")
  @@index([reportId])
  @@index([userId])
  @@index([resolvedBy])
  @@index([status])
}

model Appeal {
  id               String    @id @default(uuid())
  caseId           String
  userId           String
  reason           String
  status           String // pending, in_review, successful, rejected
  resolvedBy       String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("appeals")
  @@index([caseId])
  @@index([userId])
  @@index([status])
}

model SafetyScan {
  id              String    @id @default(uuid())
  contentId       String?
  mediaUrl        String
  scanType        String // malware, content_safety, copyright
  status          String // pending, scanning, completed, failed
  result          String // clean, flagged, blocked
  details         Json?
  threatLevel     String? // low, medium, high, critical
  categories      Json?   // list of detected categories
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  scanDurationMs  Int?

  @@map("safety_scans")
  @@index([contentId])
  @@index([status])
  @@index([scanType])
}

model SafetyAction {
  id           String    @id @default(uuid())
  type         String // remove, hide, warn, suspend, ban, shadow_ban
  targetId     String
  targetType   String // content, user
  reason       String
  moderatorId  String
  duration     Int?    // in seconds, for temporary actions
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moderator User? @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@map("safety_actions")
  @@index([targetId, targetType])
  @@index([moderatorId])
  @@index([type])
  @@index([createdAt])
}

model TrustScoreHistory {
  id        String   @id @default(uuid())
  userId    String
  oldScore  Int
  newScore  Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation("TrustHistory", fields: [userId], references: [id], onDelete: Restrict)

  @@map("trust_score_history")
  @@index([userId])
  @@index([createdAt])
}

model AuditEvent {
  id             String    @id @default(uuid())
  action         String // create, update, delete, review, resolve, appeal, scan
  resourceType   String // content, user, report, case, appeal, scan
  resourceId     String?
  actorId        String?
  actorType      String // user, moderator, system, api
  details        Json?
  previousState  Json?
  newState       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("audit_events")
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
}

model ReviewerAssignment {
  id           String    @id @default(uuid())
  caseId       String
  reviewerId   String
  assignedBy   String?
  status       String // active, completed, reassigned
  assignedAt   DateTime @default(now())
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case     ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer User? @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assigner User?          @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@map("reviewer_assignments")
  @@index([caseId])
  @@index([reviewerId])
  @@index([assignedBy])
  @@index([status])
}

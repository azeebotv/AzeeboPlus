generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  password                String
  displayName             String
  avatar                  String?
  role                    String   @default("user")
  preferences             Json?
  notificationPreferences Json?
  trustScore              Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  watchHistory              WatchHistory[]
  savedItems                SavedItem[]
  wallet                    Wallet?
  notifications             Notification[]
  contentItems              ContentItem[]
  creatorProfile            CreatorProfile?
  rewardAccount             RewardAccount?
  userSearches              UserSearch[]
  productEvents             ProductEvent[]
  reportsAsReporter         Report[]            @relation("ReportsByReporter")
  reportsAsReported         Report[]            @relation("ReportsByReported")
  moderationCasesAsSubject  ModerationCase[]    @relation("ModerationCaseSubject")
  moderationCasesAsResolver ModerationCase[]    @relation("ModerationCaseResolver")
  appeals                   Appeal[]
  PaymentIntent             PaymentIntent[]
  MissionCompletion         MissionCompletion[]
  RewardRedemption          RewardRedemption[]
  PointsLedger              PointsLedger[]
  trustScoreHistory         TrustScoreHistory[]
  reviewerAssignments       ReviewerAssignment[] @relation("ReviewerUser")
  assignedReviewers         ReviewerAssignment[] @relation("AssignerUser")

  @@map("users")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("watch_history")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("saved_items")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  bonusBalance Decimal  @default(0) @db.Decimal(18, 2)
  promoBalance Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String // credit, debit, bonus, promo, refund
  amount      Decimal  @db.Decimal(18, 2)
  status      String // pending, completed, failed, reversed
  description String?
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system, payment, reward, content, social
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PaymentIntent {
  id                String    @id @default(uuid())
  userId            String
  amount            Decimal  @db.Decimal(18, 2)
  currency          String    @default("NGN")
  status            String // pending, processing, completed, failed, refunded
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payment_intents")
}

model Refund {
  id                String   @id @default(uuid())
  paymentIntentId   String
  amount            Decimal  @db.Decimal(18, 2)
  reason            String
  status            String // pending, processing, completed, failed
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  thumbnail   String
  mediaUrl    String?
  universeId  String
  creatorId   String
  status      String // draft, pending, published, archived
  viewCount   Int       @default(0)
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  universe         Universe        @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset?
  categories       Category[]
  tags             Tag[]
  CreatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?
  Report           Report[]

  @@map("content_items")
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CreatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  banner      String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@map("creator_profiles")
}

model RewardAccount {
  id            String    @id @default(uuid())
  userId        String    @unique
  points        Int       @default(0)
  levelId       String
  streak        Int       @default(0)
  lastLoginAt   DateTime  @default(now())
  lastCheckInAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  Level   @relation(fields: [levelId], references: [id])
  badges Badge[]

  @@map("reward_accounts")
}

model Level {
  id        String   @id @default(uuid())
  name      String
  rank      Int      @unique
  minPoints Int
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("levels")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  points      Int
  type        String // daily, weekly, monthly, one-time
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards     MissionReward[]
  completions MissionCompletion[]

  @@map("missions")
}

model MissionReward {
  id        String   @id @default(uuid())
  missionId String
  rewardId  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@map("mission_rewards")
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_completions")
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        String // points, bonus, promo
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions   RewardRedemption[]
  MissionReward MissionReward[]

  @@map("rewards")
}

model RewardRedemption {
  id         String   @id @default(uuid())
  userId     String
  rewardId   String
  pointsCost Int
  redeemedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  type      String // credit, debit
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
}

model SearchQueryLog {
  id           String   @id @default(uuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearchAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userSearches UserSearch[]

  @@map("search_query_logs")
}

model UserSearch {
  id           String   @id @default(uuid())
  userId       String
  queryId      String
  resultsCount Int
  createdAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query SearchQueryLog @relation(fields: [queryId], references: [id])

  @@map("user_searches")
}

model ProductEvent {
  id        String   @id @default(uuid())
  type      String // content_view, play_start, play_complete, etc.
  userId    String?
  sessionId String?
  metadata  Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_events")
}

model Report {
  id               String    @id @default(uuid())
  reportingUserId  String
  type             String // harassment, hate_speech, violence, sexual_content, copyright, spam, other
  contentId        String?
  userId           String?
  reason           String
  status           String // pending, in_review, resolved, dismissed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reportingUser  User?           @relation("ReportsByReporter", fields: [reportingUserId], references: [id], onDelete: Cascade)
  reportedUser   User?           @relation("ReportsByReported", fields: [userId], references: [id], onDelete: Cascade)
  content        ContentItem?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ModerationCase ModerationCase?

  @@map("reports")
}

model ModerationCase {
  id               String    @id @default(uuid())
  reportId         String    @unique
  userId           String
  status           String // pending, in_review, resolved, appealed
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user           User     @relation("ModerationCaseSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedByUser User?    @relation("ModerationCaseResolver", fields: [resolvedBy], references: [id])
  Appeal         Appeal[]
  reviewerAssignments ReviewerAssignment[]

  @@map("moderation_cases")
}

model Appeal {
  id               String    @id @default(uuid())
  caseId           String
  userId           String
  reason           String
  status           String // pending, in_review, successful, rejected
  resolvedBy       String?
  resolutionReason String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

model SafetyScan {
  id              String    @id @default(uuid())
  contentId       String?
  mediaUrl        String
  scanType        String // malware, content_safety, copyright
  status          String // pending, scanning, completed, failed
  result          String // clean, flagged, blocked
  details         Json?
  threatLevel     String? // low, medium, high, critical
  categories      Json?   // list of detected categories
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  scanDurationMs  Int?

  @@map("safety_scans")
  @@index([contentId])
  @@index([status])
  @@index([scanType])
}

model SafetyAction {
  id           String    @id @default(uuid())
  type         String // remove, hide, warn, suspend, ban, shadow_ban
  targetId     String
  targetType   String // content, user
  reason       String
  moderatorId  String
  duration     Int?    // in seconds, for temporary actions
  metadata     Json?
  createdAt    DateTime @default(now())

  @@map("safety_actions")
  @@index([targetId, targetType])
  @@index([moderatorId])
  @@index([type])
  @@index([createdAt])
}

model TrustScoreHistory {
  id        String   @id @default(uuid())
  userId    String
  oldScore  Int
  newScore  Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_score_history")
  @@index([userId])
  @@index([createdAt])
}

model AuditEvent {
  id             String    @id @default(uuid())
  action         String // create, update, delete, review, resolve, appeal, scan
  resourceType   String // content, user, report, case, appeal, scan
  resourceId     String?
  actorId        String?
  actorType      String // user, moderator, system, api
  details        Json?
  previousState  Json?
  newState       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@map("audit_events")
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
}

model ReviewerAssignment {
  id           String    @id @default(uuid())
  caseId       String
  reviewerId   String
  assignedBy   String?
  status       String // active, completed, reassigned
  assignedAt   DateTime @default(now())
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  case        ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer    User           @relation("ReviewerUser", fields: [reviewerId], references: [id])
  assignedByUser User?       @relation("AssignerUser", fields: [assignedBy], references: [id])

  @@map("reviewer_assignments")
  @@index([caseId])
  @@index([reviewerId])
  @@index([status])
}

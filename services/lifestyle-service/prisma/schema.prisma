generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CultureStory {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  categoryId  String?
  authorId    String
  status      String   @default("draft")
  viewCount   Int      @default(0)
  readTime    Int?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    StoryCategory? @relation(fields: [categoryId], references: [id])
  author      User          @relation(fields: [authorId], references: [id])
  comments    StoryComment[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
}

model StoryCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  description String?
  stories   CultureStory[]

  @@index([slug])
}

model StoryComment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  storyId   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User          @relation(fields: [authorId], references: [id])
  story     CultureStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parent    StoryComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   StoryComment[] @relation("CommentReplies")

  @@index([storyId])
  @@index([authorId])
  @@index([parentId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  coverImage  String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  venue        String?
  isOnline    Boolean  @default(false)
  onlineLink  String?
  maxAttendees Int?
  status      String   @default("draft")
  categoryId  String?
  creatorId   String
  viewCount   Int      @default(0)
  rsvpCount   Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    EventCategory? @relation(fields: [categoryId], references: [id])
  creator     User           @relation(fields: [creatorId], references: [id])
  rsvps       EventRsvp[]

  @@index([categoryId])
  @@index([creatorId])
  @@index([status])
  @@index([startDate])
}

model EventCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  events      Event[]

  @@index([slug])
}

model EventRsvp {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  status    String   @default("attending")
  guests    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  displayName   String?
  avatarUrl     String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stories           CultureStory[]
  storyComments     StoryComment[]
  events            Event[]
  eventRsvps        EventRsvp[]
  savedItems        SavedItem[]
  shareRecords      ShareRecord[]
  cityGuideEntries  CityGuideEntry[]
  musicEntries      MusicEntry[]
  celebrityEntries  CelebrityEntry[]
  nightlifeEntries  NightlifeEntry[]
  influencerEntries InfluencerEntry[]
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  itemType  String
  itemId    String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([itemType, itemId])
}

model ShareRecord {
  id        String   @id @default(uuid())
  userId    String
  itemType  String
  itemId    String
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemType, itemId])
}

model CityGuideEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String
  description String
  coverImage  String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  rating      Float?
  priceLevel  Int?
  hours       String?
  phone       String?
  website     String?
  amenities   String[]
  status      String   @default("draft")
  viewCount   Int      @default(0)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User   @relation(fields: [createdById], references: [id])
  tags      CityGuideTag[]

  @@index([type])
  @@index([city])
  @@index([status])
}

model CityGuideTag {
  id      String @id @default(uuid())
  name    String @unique
  slug    String @unique
  entries CityGuideEntry[]
}

model MusicEntry {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  type        String
  description String?
  coverImage  String?
  artistName  String?
  albumName   String?
  duration    Int?
  genre       String?
  trackUrl    String?
  isPremium   Boolean  @default(false)
  playCount   Int      @default(0)
  status      String   @default("draft")
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([type])
  @@index([genre])
  @@index([status])
}

model CelebrityEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  bio         String?
  coverImage  String?
  profession  String?
  nationality String?
  birthDate   DateTime?
  socialLinks String?
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  status      String   @default("draft")
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User    @relation(fields: [createdById], references: [id])
  news      CelebrityNews[]

  @@index([profession])
  @@index([status])
  @@index([isFeatured])
}

model CelebrityNews {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  celebrityId String
  status      String   @default("draft")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  celebrity CelebrityEntry @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([celebrityId])
  @@index([status])
}

model NightlifeEntry {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String
  description String
  coverImage  String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  hours       String?
  dressCode   String?
  coverCharge Float?
  rating      Float?
  status      String   @default("draft")
  viewCount   Int      @default(0)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([type])
  @@index([city])
  @@index([status])
}

model InfluencerEntry {
  id            String   @id @default(uuid())
  userId        String
  slug          String   @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  coverImage    String?
  category      String?
  followerCount Int      @default(0)
  followingCount Int     @default(0)
  postCount     Int      @default(0)
  isVerified    Boolean  @default(false)
  socialLinks   String?
  collaborationCount Int @default(0)
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collaborations InfluencerCollaboration[]

  @@index([category])
  @@index([status])
  @@index([isVerified])
}

model InfluencerCollaboration {
  id            String   @id @default(uuid())
  influencerId  String
  brandName     String
  campaignName  String
  description   String?
  coverImage    String?
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("active")
  createdAt     DateTime @default(now())

  influencer InfluencerEntry @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@index([status])
}
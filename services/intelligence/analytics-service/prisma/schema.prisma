generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  displayName           String
  avatar                String?
  role                  String   @default("user")
  preferences           Json?
  notificationPreferences Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  watchHistory WatchHistory[]
  savedItems   SavedItem[]
  wallet       Wallet?
  notifications Notification[]
  contentItems ContentItem[]
  creatorProfile CreatorProfile?
  rewardAccount RewardAccount?
  userSearches UserSearch[]
  productEvents ProductEvent[]
  paymentIntents PaymentIntent[]
  missionCompletions MissionCompletion[]
  rewardRedemptions RewardRedemption[]
  pointsLedgers PointsLedger[]

  @@map("users")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  contentType String
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watch_history")
  @@unique([userId, contentId])
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_items")
  @@unique([userId, contentId])
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance Decimal    @default(0) @db.Decimal(18, 2)
  bonusBalance Decimal    @default(0) @db.Decimal(18, 2)
  promoBalance Decimal    @default(0) @db.Decimal(18, 2)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String
  type         String   // credit, debit, bonus, promo, refund
  amount Decimal  @db.Decimal(18, 2)
  status       String   // pending, completed, failed, reversed
  description  String?
  reference    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // system, payment, reward, content, social
  title       String
  message     String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PaymentIntent {
  id                String   @id @default(uuid())
  userId            String
  amount Decimal  @db.Decimal(18, 2)
  currency          String   @default("NGN")
  status            String   // pending, processing, completed, failed, refunded
  description       String?
  providerReference String?
  metadata          Json?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds  Refund[]

  @@map("payment_intents")
}

model Refund {
  id                String   @id @default(uuid())
  paymentIntentId   String
  amount Decimal  @db.Decimal(18, 2)
  reason            String
  status            String   // pending, processing, completed, failed
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Universe {
  id          String   @id @default(uuid())
  name        String   @unique // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  displayName String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("universes")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]

  @@map("tags")
}

model ContentItem {
  id            String   @id @default(uuid())
  title         String
  description   String?
  thumbnail     String
  mediaUrl      String?
  universeId    String
  creatorId     String
  status        String   // draft, pending, published, archived
  viewCount     Int      @default(0)
  metadata      Json?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  universe    Universe    @relation(fields: [universeId], references: [id], onDelete: Cascade)
  creator     User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset?
  categories  Category[]
  tags        Tag[]

  @@map("content_items")
}

model MediaAsset {
  id            String   @id @default(uuid())
  contentItemId String   @unique
  originalUrl   String
  thumbnailUrl  String?
  format        String
  size          Int
  duration      Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CreatorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  banner          String?
  socialLinks     Json?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model RewardAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  points        Int      @default(0)
  levelId       String
  streak        Int      @default(0)
  lastLoginAt   DateTime @default(now())
  lastCheckInAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  Level  @relation(fields: [levelId], references: [id])
  badges Badge[]

  @@map("reward_accounts")
}

model Level {
  id        String   @id @default(uuid())
  name      String
  rank      Int      @unique
  minPoints Int
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("levels")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  points      Int
  type        String   // daily, weekly, monthly, one-time
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards MissionReward[]
  completions MissionCompletion[]

  @@map("missions")
}

model MissionReward {
  id          String   @id @default(uuid())
  missionId   String
  rewardId    String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@map("mission_rewards")
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_completions")
  @@unique([userId, missionId])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        String   // points, bonus, promo
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]
  missionRewards MissionReward[]

  @@map("rewards")
}

model RewardRedemption {
  id          String   @id @default(uuid())
  userId      String
  rewardId    String
  pointsCost  Int
  redeemedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
}

model PointsLedger {
  id          String   @id @default(uuid())
  userId      String
  points      Int
  type        String   // credit, debit
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
}

model SearchQueryLog {
  id            String   @id @default(uuid())
  query         String   @unique
  count         Int      @default(1)
  lastSearchAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userSearches UserSearch[]

  @@map("search_query_logs")
}

model UserSearch {
  id           String   @id @default(uuid())
  userId       String
  queryId      String
  resultsCount Int
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  query  SearchQueryLog @relation(fields: [queryId], references: [id])

  @@map("user_searches")
}

model ProductEvent {
  id          String   @id @default(uuid())
  eventName   String   // screen_view, content_impression, payment_success, etc.
  userId      String?
  sessionId   String?
  platform    String?  // web, mobile, tablet
  universe    String?  // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  deviceInfo    DeviceInfo?
  appVersion   String?
  experimentFlags Json?
  metadata     Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventName])
  @@index([userId])
  @@index([sessionId])
  @@index([universe])
  @@index([timestamp])
  @@map("product_events")
}

model DeviceInfo {
  id            String   @id @default(uuid())
  productEventId String @unique
  deviceType    String?  // mobile, desktop, tablet, tv
  os            String?  // iOS, Android, Windows, macOS, Linux
  osVersion     String?
  browser       String?
  browserVersion String?
  appVersion    String?
  screenWidth   Int?
  screenHeight  Int?
  language      String?
  timezone      String?
  userAgent     String?

  event ProductEvent @relation(fields: [productEventId], references: [id], onDelete: Cascade)

  @@map("device_info")
}

model Funnel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  steps       Json    // Array of event names in order
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funnelSteps FunnelStep[]

  @@map("funnels")
}

model FunnelStep {
  id        String   @id @default(uuid())
  funnelId  String
  stepOrder Int
  eventName String
  createdAt DateTime @default(now())

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, stepOrder])
  @@map("funnel_steps")
}

model FunnelCompletion {
  id            String   @id @default(uuid())
  funnelId      String
  userId        String
  completedSteps Int      @default(0)
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@unique([funnelId, userId])
  @@map("funnel_completions")
}

model Cohort {
  id          String   @id @default(uuid())
  name        String
  description String?
  criteria    Json     // JSON criteria for cohort membership
  size        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cohorts")
}

model CohortMember {
  id        String   @id @default(uuid())
  cohortId  String
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([cohortId, userId])
  @@map("cohort_members")
}

model AudienceSegment {
  id            String   @id @default(uuid())
  name          String
  description   String?
  segmentType   String   // behavioral, demographic, firmographic
  criteria      Json
  size          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("audience_segments")
}

model CreatorScore {
  id            String   @id @default(uuid())
  creatorId     String   @unique
  engagementScore Float   @default(0)
  growthScore   Float    @default(0)
  monetizationScore Float @default(0)
  overallScore  Float    @default(0)
  lastUpdated   DateTime @default(now())

  @@map("creator_scores")
}

model ChurnRisk {
  id              String   @id @default(uuid())
  userId          String   @unique
  riskLevel       String   // low, medium, high, critical
  churnProbability Float   @default(0)
  factors         Json     // Contributing factors
  lastActivityAt  DateTime?
  predictedChurnAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("churn_risks")
}

model FraudDetection {
  id            String   @id @default(uuid())
  userId        String?
  eventType     String
  severity      String   // low, medium, high, critical
  details       Json
  status        String   @default("pending") // pending, reviewed, confirmed, cleared
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@map("fraud_detections")
}

model CustomReport {
  id            String   @id @default(uuid())
  name          String
  description   String?
  category      String   @default("general")
  createdBy     String
  metrics       Json     // Array of metric configurations
  dimensions    Json     // Array of dimension configurations
  filters       Json     @default("[]") // Array of filter configurations
  dateField     String   @default("createdAt")
  dateRange     String   @default("30d")
  startDate     DateTime?
  endDate       DateTime?
  isPublic      Boolean  @default(false)
  chartConfig   Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  executions    ReportExecution[]

  @@index([createdBy])
  @@index([category])
  @@map("custom_reports")
}

model ReportExecution {
  id            String   @id @default(uuid())
  reportId      String
  executedBy    String
  executionTime Int      // in milliseconds
  rowCount      Int
  parameters    Json     // Execution parameters used
  executedAt    DateTime @default(now())

  report        CustomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([executedBy])
  @@index([executedAt])
  @@map("report_executions")
}

// Category A migration: registry of allowed events with schema validation.
// Replaces code-only validation in the analytics SDK + CI lint.
model EventSchema {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. screen_view, content_impression
  description String?
  properties  Json     // JSON schema for event properties
  required    Json     // array of required property names
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("event_schemas")
  @@index([name])
  @@index([isActive])
}

// Category A migration: A/B experiment assignment + outcome tracking.
// Replaces the Json experimentFlags field on ProductEvent for structured
// experiment analysis.
model ExperimentEvent {
  id            String   @id @default(uuid())
  experimentKey String   // e.g. feed_ranking_v2
  userId        String?
  variant       String   // control, treatment_a, treatment_b
  assignmentAt  DateTime @default(now())
  outcome       String?  // converted, dropped, no_outcome
  outcomeAt     DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@map("experiment_events")
  @@index([experimentKey])
  @@index([userId])
  @@index([variant])
  @@index([assignmentAt])
  @@index([outcome])
}

// Category A migration: named conversion definitions for funnel tracking.
// Replaces ad-hoc funnel definitions with admin-managed conversion metrics.
model ConversionMetric {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  funnelId      String?  // optional link to Funnel
  triggerEvent  String   // the event that marks conversion
  conditions    Json     // additional property conditions
  windowMinutes Int?     // attribution window
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("conversion_metrics")
  @@index([name])
  @@index([triggerEvent])
  @@index([isActive])
}

// Category A migration: materialized per-session rollups.
// Replaces on-read computation from ProductEvent.sessionId groupings.
model SessionSummary {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  userId          String?
  platform        String?
  universe        String?
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int      @default(0)
  screenViews     Int      @default(0)
  eventsCount     Int      @default(0)
  conversions     Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("session_summaries")
  @@index([sessionId])
  @@index([userId])
  @@index([platform])
  @@index([universe])
  @@index([startedAt])
}

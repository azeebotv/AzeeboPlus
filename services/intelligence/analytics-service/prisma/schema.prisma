generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductEvent {
  id          String   @id @default(uuid())
  eventName   String   // screen_view, content_impression, payment_success, etc.
  userId      String?
  sessionId   String?
  platform    String?  // web, mobile, tablet
  universe    String?  // reality, creator, lifestyle, vertical, movie, games, comedy, sports
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  deviceInfo    DeviceInfo?
  appVersion   String?
  experimentFlags Json?
  metadata     Json?

  @@index([eventName])
  @@index([userId])
  @@index([sessionId])
  @@index([universe])
  @@index([timestamp])
  @@map("product_events")
}

model DeviceInfo {
  id            String   @id @default(uuid())
  productEventId String @unique
  deviceType    String?  // mobile, desktop, tablet, tv
  os            String?  // iOS, Android, Windows, macOS, Linux
  osVersion     String?
  browser       String?
  browserVersion String?
  appVersion    String?
  screenWidth   Int?
  screenHeight  Int?
  language      String?
  timezone      String?
  userAgent     String?

  event ProductEvent @relation(fields: [productEventId], references: [id], onDelete: Cascade)

  @@index([productEventId])
  @@map("device_info")
}

model Funnel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  steps       Json    // Array of event names in order
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funnelSteps FunnelStep[]

  @@map("funnels")
}

model FunnelStep {
  id        String   @id @default(uuid())
  funnelId  String
  stepOrder Int
  eventName String
  createdAt DateTime @default(now())

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, stepOrder])
  @@index([funnelId])
  @@map("funnel_steps")
}

model FunnelCompletion {
  id            String   @id @default(uuid())
  funnelId      String
  userId        String
  completedSteps Int      @default(0)
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@unique([funnelId, userId])
  @@index([funnelId])
  @@index([userId])
  @@map("funnel_completions")
}

model Cohort {
  id          String   @id @default(uuid())
  name        String
  description String?
  criteria    Json     // JSON criteria for cohort membership
  size        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cohorts")
}

model CohortMember {
  id        String   @id @default(uuid())
  cohortId  String
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
  @@map("cohort_members")
}

model AudienceSegment {
  id            String   @id @default(uuid())
  name          String
  description   String?
  segmentType   String   // behavioral, demographic, firmographic
  criteria      Json
  size          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("audience_segments")
}

model CreatorScore {
  id            String   @id @default(uuid())
  creatorId     String   @unique
  engagementScore Float   @default(0)
  growthScore   Float    @default(0)
  monetizationScore Float @default(0)
  overallScore  Float    @default(0)
  lastUpdated   DateTime @default(now())

  @@index([creatorId])
  @@map("creator_scores")
}

model ChurnRisk {
  id              String   @id @default(uuid())
  userId          String   @unique
  riskLevel       String   // low, medium, high, critical
  churnProbability Float   @default(0)
  factors         Json     // Contributing factors
  lastActivityAt  DateTime?
  predictedChurnAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("churn_risks")
}

model FraudDetection {
  id            String   @id @default(uuid())
  userId        String?
  eventType     String
  severity      String   // low, medium, high, critical
  details       Json
  status        String   @default("pending") // pending, reviewed, confirmed, cleared
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([userId])
  @@index([reviewedBy])
  @@map("fraud_detections")
}

model CustomReport {
  id            String   @id @default(uuid())
  name          String
  description   String?
  category      String   @default("general")
  createdBy     String
  metrics       Json     // Array of metric configurations
  dimensions    Json     // Array of dimension configurations
  filters       Json     @default("[]") // Array of filter configurations
  dateField     String   @default("createdAt")
  dateRange     String   @default("30d")
  startDate     DateTime?
  endDate       DateTime?
  isPublic      Boolean  @default(false)
  chartConfig   Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  executions    ReportExecution[]

  @@index([createdBy])
  @@index([category])
  @@map("custom_reports")
}

model ReportExecution {
  id            String   @id @default(uuid())
  reportId      String
  executedBy    String
  executionTime Int      // in milliseconds
  rowCount      Int
  parameters    Json     // Execution parameters used
  executedAt    DateTime @default(now())

  report        CustomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([executedBy])
  @@index([executedAt])
  @@map("report_executions")
}

// Category A migration: registry of allowed events with schema validation.
// Replaces code-only validation in the analytics SDK + CI lint.
model EventSchema {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. screen_view, content_impression
  description String?
  properties  Json     // JSON schema for event properties
  required    Json     // array of required property names
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("event_schemas")
  @@index([name])
  @@index([isActive])
}

// Category A migration: A/B experiment assignment + outcome tracking.
// Replaces the Json experimentFlags field on ProductEvent for structured
// experiment analysis.
model ExperimentEvent {
  id            String   @id @default(uuid())
  experimentKey String   // e.g. feed_ranking_v2
  userId        String?
  variant       String   // control, treatment_a, treatment_b
  assignmentAt  DateTime @default(now())
  outcome       String?  // converted, dropped, no_outcome
  outcomeAt     DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@map("experiment_events")
  @@index([experimentKey])
  @@index([userId])
  @@index([variant])
  @@index([assignmentAt])
  @@index([outcome])
}

// Category A migration: named conversion definitions for funnel tracking.
// Replaces ad-hoc funnel definitions with admin-managed conversion metrics.
model ConversionMetric {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  funnelId      String?  // optional link to Funnel
  triggerEvent  String   // the event that marks conversion
  conditions    Json     // additional property conditions
  windowMinutes Int?     // attribution window
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("conversion_metrics")
  @@index([name])
  @@index([triggerEvent])
  @@index([isActive])
}

// Category A migration: materialized per-session rollups.
// Replaces on-read computation from ProductEvent.sessionId groupings.
model SessionSummary {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  userId          String?
  platform        String?
  universe        String?
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int      @default(0)
  screenViews     Int      @default(0)
  eventsCount     Int      @default(0)
  conversions     Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("session_summaries")
  @@index([sessionId])
  @@index([userId])
  @@index([platform])
  @@index([universe])
  @@index([startedAt])
}

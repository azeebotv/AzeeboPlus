generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model ReferralCode {
  id            String   @id @default(uuid())
  userId        String
  code          String   @unique
  isActive      Boolean  @default(true)
  maxUses       Int?
  currentUses   Int      @default(0)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrals     Referral[]

  @@map("referral_codes")
  @@index([userId])
  @@index([code])
  @@index([isActive])
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  referredId    String
  referralCodeId String
  status        String   @default("pending") // pending, completed, expired
  rewardAmount  Decimal? @default(0) @db.Decimal(18, 2)
  rewardStatus  String   @default("pending") // pending, credited, failed
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referralCode  ReferralCode @relation(fields: [referralCodeId], references: [id])

  @@map("referrals")
  @@index([referrerId])
  @@index([referredId])
  @@index([referralCodeId])
  @@index([status])
  @@index([createdAt])
  @@index([referrerId, createdAt])
}

model ReferralReward {
  id            String   @id @default(uuid())
  referralId    String   @unique
  userId        String
  amount        Decimal  @db.Decimal(18, 2)
  type          String   // signup, first_purchase, milestone
  status        String   @default("pending") // pending, credited, failed
  creditedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("referral_rewards")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ReferralConfig {
  id            String   @id @default(uuid())
  key           String   @unique
  value         Decimal  @db.Decimal(18, 2)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("referral_configs")
}

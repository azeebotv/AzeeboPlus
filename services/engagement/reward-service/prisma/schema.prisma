generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl   = env("DIRECT_DATABASE_URL")
}

model RewardAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  points        Int      @default(0)
  levelId       String
  streak        Int      @default(0)
  lastLoginAt   DateTime @default(now())
  lastCheckInAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  level  Level  @relation(fields: [levelId], references: [id])
  badges Badge[]

  @@map("reward_accounts")
  @@index([userId])
  @@index([levelId])
}

model Level {
  id        String   @id @default(uuid())
  name      String
  rank      Int      @unique
  minPoints Int
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("levels")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardAccounts RewardAccount[]

  @@map("badges")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String?
  points      Int
  type        String   // daily, weekly, monthly, one-time
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards     MissionReward[]
  completions MissionCompletion[]

  @@map("missions")
  @@index([type])
  @@index([isActive])
}

model MissionReward {
  id          String   @id @default(uuid())
  missionId   String
  rewardId    String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@map("mission_rewards")
  @@index([missionId])
  @@index([rewardId])
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_completions")
  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
  @@index([completedAt])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        String   // points, bonus, promo
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions     RewardRedemption[]
  missionRewards  MissionReward[]

  @@map("rewards")
}

model RewardRedemption {
  id          String   @id @default(uuid())
  userId      String
  rewardId    String
  pointsCost  Int
  redeemedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
  @@index([userId])
  @@index([rewardId])
  @@index([redeemedAt])
}

model PointsLedger {
  id          String   @id @default(uuid())
  userId      String
  points      Int
  type        String   // credit, debit
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("points_ledger")
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  directUrl   = env("DIRECT_DATABASE_URL")
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  userId      String
  displayName String
  avatar      String?
  score       Int      @default(0)
  rank        Int      @default(0)
  category    String   @default("all")
  timePeriod  String   @default("weekly")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, timePeriod])
  @@index([score])
  @@index([rank])
  @@index([category])
  @@index([timePeriod])
  @@map("leaderboard_entries")
}

model Prediction {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  prediction  String
  category    String?  // prediction category (e.g., "winner", "score", "event")
  metadata    Json?    // additional prediction data
  points      Int      @default(0)
  isCorrect   Boolean?
  result      String?
  status      String   @default("active") // active, resolved, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([contentId])
  @@index([isCorrect])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("predictions")
}

model RankingHistory {
  id          String   @id @default(uuid())
  userId      String
  category    String
  score       Int      @default(0)
  rank        Int      @default(0)
  period      String
  recordedAt  DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([period])
  @@index([recordedAt])
  @@map("ranking_history")
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String
  displayName String
  avatar      String?
  category    String
  score       Int      @default(0)
  rank        Int      @default(0)
  period      String   @default("all")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, period])
  @@index([category])
  @@index([score])
  @@index([rank])
  @@map("rankings")
}

generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  userId      String
  displayName String
  avatar      String?
  score       Int      @default(0)
  rank        Int      @default(0)
  category    String   @default("all")
  timePeriod  String   @default("weekly")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, timePeriod])
  @@index([score])
  @@index([rank])
  @@index([category])
  @@index([timePeriod])
  @@map("leaderboard_entries")
}

model Prediction {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  prediction  String
  points      Int      @default(0)
  isCorrect   Boolean?
  result      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([contentId])
  @@index([isCorrect])
  @@map("predictions")
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String
  displayName String
  avatar      String?
  category    String
  score       Int      @default(0)
  rank        Int      @default(0)
  period      String   @default("all")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, period])
  @@index([category])
  @@index([score])
  @@index([rank])
  @@map("rankings")
}

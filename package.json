{
  "name": "@azeebo/monorepo",
  "version": "1.0.0",
  "description": "Automation scripts for Azeebo+ platform",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "lint": "pnpm -r run lint",
    "check:flags": "node scripts/check-flag-conventions.mjs",
    "sweep:flags": "node scripts/sweep-flag-usage.mjs",
    "generate:flags:docs": "node scripts/generate-flag-registry-table.mjs",
    "check:flags:docs": "node scripts/generate-flag-registry-table.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "docs-sync": "ts-node --project tsconfig.scripts.json scripts/docs-sync.ts",
    "docs-sync:watch": "nodemon --watch services --exec ts-node --project tsconfig.scripts.json scripts/docs-sync.ts",
    "coverage-analyze": "ts-node --project tsconfig.scripts.json scripts/coverage-analyzer.ts",
    "contracts": "pnpm --filter @azeebo/contract-tests test:contracts",
    "contracts:watch": "pnpm --filter @azeebo/contract-tests test:watch",
    "test:flags:redis": "docker compose -f docker-compose.test.yml up -d --wait redis-test && pnpm --filter @azeebo/admin test:redis && docker compose -f docker-compose.test.yml down",
    "test:payments:failover": "docker compose -f docker-compose.test.yml up -d --wait redis-test postgres-test paystack-mock flutterwave-mock && pnpm --filter @azeebo/payment-service test:e2e:failover && docker compose -f docker-compose.test.yml down",
    "test:e2e:pgtrgm": "docker compose -f docker-compose.test.yml up -d --wait redis-test postgres-test && pnpm --filter @azeebo/search-service test:e2e:pgtrgm && docker compose -f docker-compose.test.yml down"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "ajv": "6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "typescript",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "prisma",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "@swc/core"
    ],
    "overrides": {
      "protobufjs": ">=8.6.0",
      "underscore": ">=1.13.8",
      "tmp": ">=0.2.6",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "@opentelemetry/sdk-trace-base": ">=2.7.1",
      "@opentelemetry/sdk-trace-node": ">=2.7.1",
      "@opentelemetry/context-async-hooks": ">=2.7.1",
      "@opentelemetry/resources": ">=2.7.1",
      "@babel/core": ">=7.29.6",
      "multer": ">=2.2.0",
      "js-yaml@>=4.0.0": ">=4.2.0",
      "js-yaml@<4.0.0": ">=3.15.0"
    }
  }
}

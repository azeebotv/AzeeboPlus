{
  "name": "@azeebo/scripts",
  "version": "1.0.0",
  "description": "Automation scripts for Azeebo+ platform",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "docs-sync": "ts-node --project tsconfig.scripts.json scripts/docs-sync.ts",
    "docs-sync:watch": "nodemon --watch services --exec ts-node --project tsconfig.scripts.json scripts/docs-sync.ts",
    "coverage-analyze": "ts-node --project tsconfig.scripts.json scripts/coverage-analyzer.ts",
    "contracts": "pnpm --filter @azeebo/contract-tests test:contracts",
    "contracts:watch": "pnpm --filter @azeebo/contract-tests test:watch"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "typescript",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "prisma",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}

{
  "name": "azeebo-scripts",
  "version": "1.0.0",
  "description": "Automation scripts for Azeebo+ platform",
  "scripts": {
    "docs-sync": "ts-node --project tsconfig.scripts.json scripts/docs-sync.ts",
    "docs-sync:watch": "nodemon --watch services --exec ts-node --project tsconfig.scripts.json scripts/docs-sync.ts",
    "coverage-analyze": "ts-node --project tsconfig.scripts.json scripts/coverage-analyzer.ts"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "typescript",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "prisma",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "jest": "29.7.0",
      "@jest/core": "29.7.0",
      "@jest/runtime": "29.7.0",
      "jest-runtime": "29.7.0",
      "ts-jest": "29.1.0"
    }
  }
}

# Environment Variables for Azeebo+
# Copy this file to .env and fill in the actual values
# NEVER commit actual values to version control

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=azeebo_db

# JWT Secrets (minimum 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# API URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
WALLET_SERVICE_URL=http://localhost:3005
REFERRAL_SERVICE_URL=http://localhost:3006
SPORTS_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
API_GATEWAY_URL=http://localhost:3000

# Payment Gateway Keys (for development only - use real keys in production)
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
FLW_PUBLIC_KEY=your_flutterwave_public_key_here
FLW_SECRET_KEY=your_flutterwave_secret_key_here

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# External APIs
YOUTUBE_API_KEY=your_youtube_api_key_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Email Service (for development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=noreply@azeebo.com

# Feature Flags
ENABLE_REALITY_UNIVERSE=true
ENABLE_VERTICAL_UNIVERSE=true
ENABLE_LIFESTYLE_UNIVERSE=true
ENABLE_COMEDY_UNIVERSE=true
ENABLE_SPORTS_UNIVERSE=true
ENABLE_GAMES_UNIVERSE=true
ENABLE_REWARDS_UNIVERSE=true

# Logging
LOG_LEVEL=info

# Other
NODE_ENV=development
PORT=3000
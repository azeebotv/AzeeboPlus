# Azeebo+ Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file with real credentials.

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Master PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_MASTER_PASSWORD
POSTGRES_DB=azeebo_plus_dev

# Per-service database passwords (used by init script)
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
USER_DB_PASSWORD=CHANGE_ME_USER_DB_PASSWORD
WALLET_DB_PASSWORD=CHANGE_ME_WALLET_DB_PASSWORD
PAYMENT_DB_PASSWORD=CHANGE_ME_PAYMENT_DB_PASSWORD
CONTENT_DB_PASSWORD=CHANGE_ME_CONTENT_DB_PASSWORD
MEDIA_DB_PASSWORD=CHANGE_ME_MEDIA_DB_PASSWORD
SEARCH_DB_PASSWORD=CHANGE_ME_SEARCH_DB_PASSWORD
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_DB_PASSWORD
REWARD_DB_PASSWORD=CHANGE_ME_REWARD_DB_PASSWORD
ANALYTICS_DB_PASSWORD=CHANGE_ME_ANALYTICS_DB_PASSWORD
RECOMMENDATION_DB_PASSWORD=CHANGE_ME_RECOMMENDATION_DB_PASSWORD
REALITY_DB_PASSWORD=CHANGE_ME_REALITY_DB_PASSWORD
MOVIE_DB_PASSWORD=CHANGE_ME_MOVIE_DB_PASSWORD
GAMES_DB_PASSWORD=CHANGE_ME_GAMES_DB_PASSWORD
COMEDY_DB_PASSWORD=CHANGE_ME_COMEDY_DB_PASSWORD
SPORTS_DB_PASSWORD=CHANGE_ME_SPORTS_DB_PASSWORD
LIFESTYLE_DB_PASSWORD=CHANGE_ME_LIFESTYLE_DB_PASSWORD
VERTICAL_DB_PASSWORD=CHANGE_ME_VERTICAL_DB_PASSWORD
CREATOR_DB_PASSWORD=CHANGE_ME_CREATOR_DB_PASSWORD
SUPPORT_DB_PASSWORD=CHANGE_ME_SUPPORT_DB_PASSWORD
MODERATION_DB_PASSWORD=CHANGE_ME_MODERATION_DB_PASSWORD
QUEUE_DB_PASSWORD=CHANGE_ME_QUEUE_DB_PASSWORD

# Per-service database URLs (via PgBouncer connection pooling)
AUTH_DATABASE_URL=postgresql://auth_user:${AUTH_DB_PASSWORD}@pgbouncer:6432/auth_db?sslmode=require
USER_DATABASE_URL=postgresql://user_user:${USER_DB_PASSWORD}@pgbouncer:6432/user_db?sslmode=require
WALLET_DATABASE_URL=postgresql://wallet_user:${WALLET_DB_PASSWORD}@pgbouncer:6432/wallet_db?sslmode=require
PAYMENT_DATABASE_URL=postgresql://payment_user:${PAYMENT_DB_PASSWORD}@pgbouncer:6432/payment_db?sslmode=require
CONTENT_DATABASE_URL=postgresql://content_user:${CONTENT_DB_PASSWORD}@pgbouncer:6432/content_db?sslmode=require
MEDIA_DATABASE_URL=postgresql://media_user:${MEDIA_DB_PASSWORD}@pgbouncer:6432/media_db?sslmode=require
SEARCH_DATABASE_URL=postgresql://search_user:${SEARCH_DB_PASSWORD}@pgbouncer:6432/search_db?sslmode=require
NOTIFICATION_DATABASE_URL=postgresql://notification_user:${NOTIFICATION_DB_PASSWORD}@pgbouncer:6432/notification_db?sslmode=require
REWARD_DATABASE_URL=postgresql://reward_user:${REWARD_DB_PASSWORD}@pgbouncer:6432/reward_db?sslmode=require
ANALYTICS_DATABASE_URL=postgresql://analytics_user:${ANALYTICS_DB_PASSWORD}@pgbouncer:6432/analytics_db?sslmode=require
RECOMMENDATION_DATABASE_URL=postgresql://recommendation_user:${RECOMMENDATION_DB_PASSWORD}@pgbouncer:6432/recommendation_db?sslmode=require
REALITY_DATABASE_URL=postgresql://reality_user:${REALITY_DB_PASSWORD}@pgbouncer:6432/reality_db?sslmode=require
MOVIE_DATABASE_URL=postgresql://movie_user:${MOVIE_DB_PASSWORD}@pgbouncer:6432/movie_db?sslmode=require
GAMES_DATABASE_URL=postgresql://games_user:${GAMES_DB_PASSWORD}@pgbouncer:6432/games_db?sslmode=require
COMEDY_DATABASE_URL=postgresql://comedy_user:${COMEDY_DB_PASSWORD}@pgbouncer:6432/comedy_db?sslmode=require
SPORTS_DATABASE_URL=postgresql://sports_user:${SPORTS_DB_PASSWORD}@pgbouncer:6432/sports_db?sslmode=require
LIFESTYLE_DATABASE_URL=postgresql://lifestyle_user:${LIFESTYLE_DB_PASSWORD}@pgbouncer:6432/lifestyle_db?sslmode=require
VERTICAL_DATABASE_URL=postgresql://vertical_user:${VERTICAL_DB_PASSWORD}@pgbouncer:6432/vertical_db?sslmode=require
CREATOR_DATABASE_URL=postgresql://creator_user:${CREATOR_DB_PASSWORD}@pgbouncer:6432/creator_db?sslmode=require
SUPPORT_DATABASE_URL=postgresql://support_user:${SUPPORT_DB_PASSWORD}@pgbouncer:6432/support_db?sslmode=require
MODERATION_DATABASE_URL=postgresql://moderation_user:${MODERATION_DB_PASSWORD}@pgbouncer:6432/moderation_db?sslmode=require
QUEUE_DATABASE_URL=postgresql://queue_user:${QUEUE_DB_PASSWORD}@pgbouncer:6432/queue_db?sslmode=require

# Legacy DATABASE_URL (for backward compatibility during migration)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/azeebo_plus_dev?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=azeebo_plus_dev

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# JWT & AUTHENTICATION
# ===========================================
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=azeebo-plus
JWT_AUDIENCE=azeebo-plus-users

# ===========================================
# API GATEWAY
# ===========================================
API_GATEWAY_PORT=3013
API_GATEWAY_URL=http://localhost:3013

# ===========================================
# SERVICE URLS (Internal)
# ===========================================
AUTH_SERVICE_URL=http://auth-service:3000
USER_SERVICE_URL=http://user-service:3000
WALLET_SERVICE_URL=http://wallet-service:3000
PAYMENT_SERVICE_URL=http://payment-service:3000
CONTENT_SERVICE_URL=http://content-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
REWARD_SERVICE_URL=http://reward-service:3000
SEARCH_SERVICE_URL=http://search-service:3000
ANALYTICS_SERVICE_URL=http://analytics-service:3000
MODERATION_SERVICE_URL=http://moderation-service:3000
RECOMMENDATION_SERVICE_URL=http://recommendation-service:3000
CREATOR_SERVICE_URL=http://creator-portal:3000
LIFESTYLE_SERVICE_URL=http://lifestyle-service:3016
VERTICAL_SERVICE_URL=http://vertical-service:3017
QUEUE_SERVICE_URL=http://queue-service:3015
MEDIA_SERVICE_URL=http://media-service:3019

# ===========================================
# PAYMENT PROVIDERS
# Paystack - https://dashboard.paystack.com
# Flutterwave - https://dashboard.flutterwave.com
# ===========================================
PAYSTACK_SECRET_KEY=sk_live_YOUR_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_KEY_HERE
PAYSTACK_CALLBACK_URL=https://your-domain.com/payments/webhook

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_YOUR_KEY_HERE
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_YOUR_KEY_HERE
FLUTTERWAVE_CALLBACK_URL=https://your-domain.com/payments/webhook

# ===========================================
# NOTIFICATION PROVIDERS
# SendGrid - https://app.sendgrid.com
# Twilio - https://console.twilio.com
# Firebase - https://console.firebase.google.com
# ===========================================
SENDGRID_API_KEY=SG.YOUR_KEY_HERE
SENDGRID_FROM_EMAIL=no-reply@your-domain.com
SENDGRID_FROM_NAME=Your Company Name

TWILIO_ACCOUNT_SID=AC_YOUR_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MG_YOUR_SID_HERE

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID"}

# ===========================================
# AWS / S3 CONFIGURATION
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_S3_BUCKET=your-bucket-name
AWS_CDN_URL=https://cdn.your-domain.com

# ===========================================
# NODE & SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3013
NEXT_PUBLIC_WS_URL=ws://localhost:3013

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
ADMIN_ALLOWED_ORIGINS=http://localhost:3016
CREATOR_ALLOWED_ORIGINS=http://localhost:3014

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_SECRET=CHANGE_ME_TO_A_SECURE_SESSION_SECRET
SESSION_TTL=86400

# ===========================================
# WEBHOOK CONFIGURATION
# ===========================================
WEBHOOK_SECRET=CHANGE_ME_TO_A_SECURE_WEBHOOK_SECRET

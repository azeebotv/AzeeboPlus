# ============================================================
# Azeebo+ Local Development Environment
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# Generate secrets with: openssl rand -base64 48

# ---- PostgreSQL ----
POSTGRES_USER=azeebo
POSTGRES_PASSWORD=<your-dev-password>
POSTGRES_DB=azeebo_dev

# ---- Redis ----
REDIS_PASSWORD=<your-dev-redis-password>
REDIS_URL=redis://:your-dev-redis-password@localhost:6379
# ---- Feature Flags (runtime store) ----
# Used by @azeebo/feature-flags across services + the admin universe flag bridge.
# Falls back to REDIS_URL when unset.
FEATURE_FLAG_REDIS_URL=redis://:your-dev-redis-password@localhost:6379
# Per-flag default override when the store is empty, e.g.:
# FEATURE_FLAG_DEFAULT_WEB_MAINTENANCE_MODE=true
# FEATURE_FLAG_DEFAULT_ANALYTICS_SAMPLING_RATE=50

# ---- Per-Service Database Passwords (all use same password for local dev) ----
AUTH_DB_PASSWORD=<your-dev-password>
USER_DB_PASSWORD=<your-dev-password>
WALLET_DB_PASSWORD=<your-dev-password>
PAYMENT_DB_PASSWORD=<your-dev-password>
CONTENT_DB_PASSWORD=<your-dev-password>
MEDIA_DB_PASSWORD=<your-dev-password>
SEARCH_DB_PASSWORD=<your-dev-password>
NOTIFICATION_DB_PASSWORD=<your-dev-password>
REWARD_DB_PASSWORD=<your-dev-password>
ANALYTICS_DB_PASSWORD=<your-dev-password>
RECOMMENDATION_DB_PASSWORD=<your-dev-password>
REALITY_DB_PASSWORD=<your-dev-password>
MOVIE_DB_PASSWORD=<your-dev-password>
GAMES_DB_PASSWORD=<your-dev-password>
COMEDY_DB_PASSWORD=<your-dev-password>
SPORTS_DB_PASSWORD=<your-dev-password>
LIFESTYLE_DB_PASSWORD=<your-dev-password>
VERTICAL_DB_PASSWORD=<your-dev-password>
CREATOR_DB_PASSWORD=<your-dev-password>
SUPPORT_DB_PASSWORD=<your-dev-password>
MODERATION_DB_PASSWORD=<your-dev-password>
QUEUE_DB_PASSWORD=<your-dev-password>
ENGAGEMENT_DB_PASSWORD=<your-dev-password>
MESSAGING_DB_PASSWORD=<your-dev-password>
REFERRAL_DB_PASSWORD=<your-dev-password>
SUBSCRIPTION_DB_PASSWORD=<your-dev-password>
ADMIN_DB_PASSWORD=<your-dev-password>

# ---- JWT (minimum 64 characters) ----
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=<generate-random-secret>
JWT_REFRESH_SECRET=<generate-random-secret>
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Inter-Service Auth ----
# Generate with: openssl rand -base64 48
INTERNAL_API_KEY=<generate-random-secret>

# ---- Payment Gateways (placeholders for local dev) ----
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=whsec_placeholder
FLW_PUBLIC_KEY=FLWPUBK_TEST_placeholder
FLW_SECRET_KEY=FLWSECK_TEST_placeholder
FLW_WEBHOOK_SECRET=whsec_placeholder

# ---- AWS / Media (placeholders) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_S3_BUCKET=azeebo-media-dev
# CDN distribution ID for cache purging (POST /admin/cdn/purge). Leave unset
# in local dev — purges become logged no-ops.
# CLOUDFRONT_DISTRIBUTION_ID=ABCDEF123456

# ---- Email (SMTP - use mailhog for local dev) ----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@azeebo.dev

# ---- External APIs (placeholders) ----
YOUTUBE_API_KEY=placeholder
TWITTER_API_KEY=placeholder
TWITTER_API_SECRET=placeholder
TWITTER_ACCESS_TOKEN=placeholder
TWITTER_ACCESS_TOKEN_SECRET=placeholder

# ---- SendGrid (Email) ----
SENDGRID_API_KEY=SG.placeholder
# Optional HTML overrides for the first-class transactional email templates
# (Handlebars). Leave unset to use the built-in defaults.
# EMAIL_TEMPLATE_EMAIL_VERIFICATION_HTML=<h1>Verify your email…</h1>
# EMAIL_TEMPLATE_PASSWORD_RESET_HTML=<h1>Reset your password…</h1>

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+1234567890

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGIN=http://localhost:4000,http://localhost:4016,http://localhost:4014
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4016,http://localhost:4014

# ---- Gateway Secret (shared between gateway and all services) ----
# Generate with: openssl rand -base64 48
GATEWAY_SECRET=<generate-random-secret>

# ---- Gateway upstream overrides (optional) ----
# docker-compose.prod.yml defaults this to http://knowledge-service:3020;
# set it only when the knowledge service lives somewhere else.
# KNOWLEDGE_SERVICE_URL=http://knowledge-service:3020

# ---- Logging ----
LOG_LEVEL=debug
NODE_ENV=development

# ---- Feature Flags ----
ENABLE_REALITY_UNIVERSE=true
ENABLE_VERTICAL_UNIVERSE=true
ENABLE_LIFESTYLE_UNIVERSE=true
ENABLE_COMEDY_UNIVERSE=true
ENABLE_SPORTS_UNIVERSE=true
ENABLE_GAMES_UNIVERSE=true
ENABLE_REWARDS_UNIVERSE=true

# ---- Pricing (NGN) ----
PRICING_CURRENCY=NGN
WALLET_FUND_MINIMUM=100
WALLET_FUND_MAXIMUM=1000000
WALLET_WITHDRAW_MINIMUM=500
WALLET_WITHDRAW_MAXIMUM=500000
WALLET_TRANSFER_MINIMUM=100
WALLET_TRANSFER_MAXIMUM=100000
CONTENT_PAY_PER_VIEW=500
SUBSCRIPTION_BASIC_PRICE=2000
SUBSCRIPTION_PREMIUM_PRICE=5000
SUBSCRIPTION_VIP_PRICE=10000
UNIVERSE_COMEDY_PRICE=300
UNIVERSE_REALITY_PRICE=500
UNIVERSE_MOVIE_PRICE=1000
UNIVERSE_SPORTS_PRICE=200
UNIVERSE_GAMES_PRICE=150
UNIVERSE_LIFESTYLE_PRICE=400
UNIVERSE_MUSIC_PRICE=250
SUPER_VOTE_PRICE=100
SUPER_VOTE_1_PRICE=100
SUPER_VOTE_5_PRICE=450
SUPER_VOTE_10_PRICE=800
SUPER_VOTE_50_PRICE=3500
PREDICTION_MIN_BET=100
PREDICTION_MAX_BET=100000

# ---- API & Deployment ----
NEXT_PUBLIC_API_URL=http://localhost:3013
NEXT_PUBLIC_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
SSL_DOMAIN=localhost
DEMO_MODE=false
CLEAR_DB=false

# ---- Firebase (Authentication) ----
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=placeholder

# ---- Sentry (Error Tracking) ----
NEXT_PUBLIC_SENTRY_DSN=https://placeholder@sentry.io/placeholder

# ---- Monitoring stack (docker/docker-compose.monitoring.yml) ----
# Required: the Grafana container refuses to start without it.
GRAFANA_ADMIN_PASSWORD=change-me-grafana

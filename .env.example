# ============================================================
# Azeebo+ Environment Variables
# Copy to .env and fill in actual values
# NEVER commit .env to version control
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=azeebo_plus_dev

# ---- Per-Service Database Passwords ----
AUTH_DB_PASSWORD=change_me_auth
USER_DB_PASSWORD=change_me_user
WALLET_DB_PASSWORD=change_me_wallet
PAYMENT_DB_PASSWORD=change_me_payment
CONTENT_DB_PASSWORD=change_me_content
MEDIA_DB_PASSWORD=change_me_media
SEARCH_DB_PASSWORD=change_me_search
NOTIFICATION_DB_PASSWORD=change_me_notification
REWARD_DB_PASSWORD=change_me_reward
ANALYTICS_DB_PASSWORD=change_me_analytics
RECOMMENDATION_DB_PASSWORD=change_me_recommendation
REALITY_DB_PASSWORD=change_me_reality
MOVIE_DB_PASSWORD=change_me_movie
GAMES_DB_PASSWORD=change_me_games
COMEDY_DB_PASSWORD=change_me_comedy
SPORTS_DB_PASSWORD=change_me_sports
LIFESTYLE_DB_PASSWORD=change_me_lifestyle
VERTICAL_DB_PASSWORD=change_me_vertical
CREATOR_DB_PASSWORD=change_me_creator
SUPPORT_DB_PASSWORD=change_me_support
MODERATION_DB_PASSWORD=change_me_moderation
QUEUE_DB_PASSWORD=change_me_queue
ENGAGEMENT_DB_PASSWORD=change_me_engagement
MESSAGING_DB_PASSWORD=change_me_messaging
REFERRAL_DB_PASSWORD=change_me_referral
SUBSCRIPTION_DB_PASSWORD=change_me_subscription
ADMIN_DB_PASSWORD=change_me_admin
CREATOR_PORTAL_DB_PASSWORD=change_me_creator_portal

# ---- JWT (minimum 32 characters) ----
JWT_ACCESS_SECRET=change_me_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---- Payment Gateways ----
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
FLW_PUBLIC_KEY=your_flutterwave_public_key
FLW_SECRET_KEY=your_flutterwave_secret_key

# ---- AWS / Media ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=azeebo-media

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@azeebo.com

# ---- External APIs ----
YOUTUBE_API_KEY=your_youtube_api_key
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGIN=http://localhost:4000,http://localhost:3000

# ---- Logging ----
LOG_LEVEL=info
NODE_ENV=development

# ---- Feature Flags ----
ENABLE_REALITY_UNIVERSE=true
ENABLE_VERTICAL_UNIVERSE=true
ENABLE_LIFESTYLE_UNIVERSE=true
ENABLE_COMEDY_UNIVERSE=true
ENABLE_SPORTS_UNIVERSE=true
ENABLE_GAMES_UNIVERSE=true
ENABLE_REWARDS_UNIVERSE=true


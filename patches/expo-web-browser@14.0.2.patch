+package expo.modules.core.errors;
+
+/**
+ * Marker exception thrown when there is no current activity to attach to.
+ * Restored locally: expo-web-browser 14.x references this class (previously
+ * exported by expo-modules-core) which SDK 56's core no longer ships.
+ */
+public class CurrentActivityNotFoundException extends RuntimeException {
+  public CurrentActivityNotFoundException() {}
+  public CurrentActivityNotFoundException(String message) { super(message); }
+  public CurrentActivityNotFoundException(Throwable cause) { super(cause); }
+}

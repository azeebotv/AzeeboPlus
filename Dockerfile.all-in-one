# ============================================================
# Azeebo+ All-in-One Dockerfile
# ============================================================
# Two-stage build:
#   1. Builder — install ALL deps, build everything
#   2. Runtime — fresh prod install + built artifacts only
#
# This avoids pnpm prune (broken in workspaces) by doing a
# clean `pnpm install --prod` in the runtime stage.
# ============================================================

# ============================================================
# Stage 1: Build — compile everything
# ============================================================
FROM node:20-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY apps/creator-portal/package.json apps/creator-portal/
COPY packages/api-client/package.json packages/api-client/
COPY packages/error-handling/package.json packages/error-handling/
COPY packages/logger/package.json packages/logger/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/utils/package.json packages/utils/
COPY packages/validation/package.json packages/validation/
COPY packages/design-tokens/package.json packages/design-tokens/
COPY packages/security/package.json packages/security/
COPY packages/shared-services/package.json packages/shared-services/
COPY packages/auth/package.json packages/auth/
COPY packages/observability/package.json packages/observability/
COPY packages/feature-flags/package.json packages/feature-flags/
COPY packages/analytics-sdk/package.json packages/analytics-sdk/
COPY packages/internal-clients/package.json packages/internal-clients/
COPY packages/test-utils/package.json packages/test-utils/
COPY packages/contract-tests/package.json packages/contract-tests/
COPY packages/ui/package.json packages/ui/
COPY services/core/auth-service/package.json services/core/auth-service/
COPY services/core/user-service/package.json services/core/user-service/
COPY services/core/wallet-service/package.json services/core/wallet-service/
COPY services/core/payment-service/package.json services/core/payment-service/
COPY services/core/content-service/package.json services/core/content-service/
COPY services/core/search-service/package.json services/core/search-service/
COPY services/core/media-service/package.json services/core/media-service/
COPY services/engagement/notification-service/package.json services/engagement/notification-service/
COPY services/engagement/reward-service/package.json services/engagement/reward-service/
COPY services/engagement/engagement-service/package.json services/engagement/engagement-service/
COPY services/engagement/messaging-service/package.json services/engagement/messaging-service/
COPY services/engagement/referral-service/package.json services/engagement/referral-service/
COPY services/engagement/subscription-service/package.json services/engagement/subscription-service/
COPY services/intelligence/analytics-service/package.json services/intelligence/analytics-service/
COPY services/intelligence/recommendation-service/package.json services/intelligence/recommendation-service/
COPY services/universes/reality-service/package.json services/universes/reality-service/
COPY services/universes/movie-service/package.json services/universes/movie-service/
COPY services/universes/comedy-service/package.json services/universes/comedy-service/
COPY services/universes/games-service/package.json services/universes/games-service/
COPY services/universes/sports-service/package.json services/universes/sports-service/
COPY services/universes/lifestyle-service/package.json services/universes/lifestyle-service/
COPY services/universes/vertical-service/package.json services/universes/vertical-service/
COPY services/universes/creator-service/package.json services/universes/creator-service/
COPY services/operations/queue-service/package.json services/operations/queue-service/
COPY services/operations/support-service/package.json services/operations/support-service/
COPY services/operations/moderation-service/package.json services/operations/moderation-service/
COPY services/gateway/api-gateway/package.json services/gateway/api-gateway/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_URL}

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm --filter @azeebo/utils run build && \
    pnpm --filter @azeebo/shared-types run build && \
    pnpm --filter @azeebo/validation run build && \
    pnpm --filter @azeebo/error-handling run build && \
    pnpm --filter @azeebo/logger run build && \
    pnpm --filter @azeebo/api-client run build && \
    pnpm --filter @azeebo/design-tokens run build && \
    pnpm --filter @azeebo/shared-services prisma:generate && pnpm --filter @azeebo/shared-services run build && \
    pnpm --filter @azeebo/security run build && \
    pnpm --filter @azeebo/ui run build && \
    pnpm --filter @azeebo/auth-service prisma:generate && pnpm --filter @azeebo/auth-service run build && \
    pnpm --filter @azeebo/user-service prisma:generate && pnpm --filter @azeebo/user-service run build && \
    pnpm --filter @azeebo/wallet-service prisma:generate && pnpm --filter @azeebo/wallet-service run build && \
    pnpm --filter @azeebo/payment-service prisma:generate && pnpm --filter @azeebo/payment-service run build && \
    pnpm --filter @azeebo/content-service prisma:generate && pnpm --filter @azeebo/content-service run build && \
    pnpm --filter @azeebo/search-service prisma:generate && pnpm --filter @azeebo/search-service run build && \
    pnpm --filter @azeebo/media-service run build

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm --filter @azeebo/notification-service prisma:generate && pnpm --filter @azeebo/notification-service run build && \
    pnpm --filter @azeebo/reward-service prisma:generate && pnpm --filter @azeebo/reward-service run build && \
    pnpm --filter @azeebo/engagement-service prisma:generate && pnpm --filter @azeebo/engagement-service run build && \
    pnpm --filter @azeebo/messaging-service prisma:generate && pnpm --filter @azeebo/messaging-service run build && \
    pnpm --filter @azeebo/referral-service prisma:generate && pnpm --filter @azeebo/referral-service run build && \
    pnpm --filter @azeebo/subscription-service prisma:generate && pnpm --filter @azeebo/subscription-service run build && \
    pnpm --filter @azeebo/analytics-service prisma:generate && pnpm --filter @azeebo/analytics-service run build && \
    pnpm --filter @azeebo/recommendation-service prisma:generate && pnpm --filter @azeebo/recommendation-service run build && \
    pnpm --filter @azeebo/reality-service prisma:generate && pnpm --filter @azeebo/reality-service run build && \
    pnpm --filter @azeebo/movie-service prisma:generate && pnpm --filter @azeebo/movie-service run build && \
    pnpm --filter @azeebo/comedy-service prisma:generate && pnpm --filter @azeebo/comedy-service run build && \
    pnpm --filter @azeebo/games-service prisma:generate && pnpm --filter @azeebo/games-service run build && \
    pnpm --filter @azeebo/sports-service prisma:generate && pnpm --filter @azeebo/sports-service run build && \
    pnpm --filter @azeebo/lifestyle-service prisma:generate && pnpm --filter @azeebo/lifestyle-service run build && \
    pnpm --filter @azeebo/vertical-service prisma:generate && pnpm --filter @azeebo/vertical-service run build && \
    pnpm --filter @azeebo/creator-service prisma:generate && pnpm --filter @azeebo/creator-service run build && \
    pnpm --filter @azeebo/queue-service prisma:generate && pnpm --filter @azeebo/queue-service run build && \
    pnpm --filter @azeebo/support-service prisma:generate && pnpm --filter @azeebo/support-service run build && \
    pnpm --filter @azeebo/moderation-service prisma:generate && pnpm --filter @azeebo/moderation-service run build && \
    pnpm --filter @azeebo/api-gateway run build

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm --filter @azeebo/admin prisma:generate && pnpm --filter @azeebo/admin run build && \
    pnpm --filter @azeebo/creator-portal prisma:generate && pnpm --filter @azeebo/creator-portal run build && \
    pnpm --filter @azeebo/web run build && \
    mkdir -p apps/admin/dist/generated && cp -r apps/admin/src/generated/prisma apps/admin/dist/generated/prisma && \
    mkdir -p apps/creator-portal/dist/generated && cp -r apps/creator-portal/src/generated/prisma apps/creator-portal/dist/generated/prisma

# Create /runtime with only what the container needs at runtime.
# This avoids copying source code and the full node_modules into
# the runtime image. A fresh pnpm install --prod in the runtime
# stage will provide production-only dependencies.
RUN mkdir -p /runtime/node_modules && \
    cp package.json pnpm-lock.yaml pnpm-workspace.yaml /runtime/ && \
    find . -maxdepth 4 -name "package.json" \
      -not -path "*/node_modules/*" \
      -not -path "*/dist/*" \
      -not -path "*/.next/*" \
      -not -path "*/.prisma/*" \
      | while read f; do \
        mkdir -p "/runtime/$(dirname "$f")" && cp "$f" "/runtime/$f"; \
      done && \
    find services -maxdepth 3 -mindepth 3 -type d | while read svc; do \
      if [ -d "$svc/dist" ]; then \
        mkdir -p "/runtime/$svc" && cp -r "$svc/dist" "/runtime/$svc/dist"; \
      fi; \
      if [ -d "$svc/prisma" ]; then \
        mkdir -p "/runtime/$svc" && cp -r "$svc/prisma" "/runtime/$svc/prisma"; \
      fi; \
    done && \
    mkdir -p /runtime/apps/admin && cp -r apps/admin/dist /runtime/apps/admin/dist && \
    mkdir -p /runtime/apps/creator-portal && cp -r apps/creator-portal/dist /runtime/apps/creator-portal/dist && \
    mkdir -p /runtime/apps/web && \
    cp -r apps/web/.next /runtime/apps/web/.next && \
    cp -r apps/web/public /runtime/apps/web/public 2>/dev/null; \
    cp apps/web/next.config.js /runtime/apps/web/ 2>/dev/null; \
    true

# ============================================================
# Stage 2: Runtime — lean image with production deps only
# ============================================================
FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-15 \
    redis-server \
    pgbouncer \
    supervisor \
    nginx \
    curl \
    locales \
    procps \
    net-tools \
    openssl \
  && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
  && locale-gen en_US.UTF-8 \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

RUN useradd -r -s /bin/false pgbouncer || true && \
    mkdir -p /var/lib/redis /var/run/pgbouncer /var/log/supervisor /var/log/postgresql && \
    chown -R redis:redis /var/lib/redis && \
    chown -R pgbouncer:pgbouncer /var/run/pgbouncer && \
    chown -R postgres:postgres /var/log/postgresql

WORKDIR /app

# Copy runtime skeleton from builder (workspace structure + built artifacts)
COPY --from=builder /runtime /app

# Fresh production install — only production dependencies, no devDeps
# --ignore-scripts: skip postinstall (prisma generate etc.) since
# we already have the generated client from the builder stage
ENV CI=true
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Install Prisma CLI globally (needed for migrate deploy and client generation)
RUN npm install -g prisma@6.19.3

# Generate Prisma clients for all services (fresh, matching prod node_modules)
# The builder stage generates these in .pnpm/ store which doesn't work at runtime
RUN for schema in $(find services apps -name "schema.prisma" -not -path "*/node_modules/*" -not -path "*/dist/*"); do \
      dir=$(dirname "$schema"); \
      echo "Generating Prisma client for $dir..."; \
      cd "/app/$dir" && prisma generate --schema=schema.prisma 2>&1 || true; \
      cd /app; \
    done

# Copy config files
COPY supervisord.conf /etc/supervisord.conf
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
RUN rm -f /etc/nginx/sites-enabled/default && chmod +x /entrypoint.sh

EXPOSE 80 443 3013 4000 4014 4016 5432 6379 6432

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=180s \
  CMD curl -f http://localhost:3013/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]

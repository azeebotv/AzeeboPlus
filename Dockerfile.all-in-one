# ============================================================
# Azeebo+ All-in-One Dockerfile (Optimized)
# ============================================================
# Two-stage build:
#   1. Builder — install ALL deps, build everything, snapshot Prisma clients
#   2. Runtime — fresh prod install + built artifacts only
#
# Optimizations:
#   - Merged RUN layers for faster export and smaller image
#   - Aggressive cleanup of build artifacts, caches, and temp files
#   - Prisma clients snapshotted from builder, restored in runtime
#   - Only production dependencies in final image
# ============================================================

# ============================================================
# Stage 1: Build — compile everything
# ============================================================
FROM node:22.16.0-bookworm-slim AS builder

ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY apps/creator-portal/package.json apps/creator-portal/
COPY packages/api-client/package.json packages/api-client/
COPY packages/error-handling/package.json packages/error-handling/
COPY packages/logger/package.json packages/logger/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/utils/package.json packages/utils/
COPY packages/validation/package.json packages/validation/
COPY packages/design-tokens/package.json packages/design-tokens/
COPY packages/security/package.json packages/security/
COPY packages/shared-services/package.json packages/shared-services/
COPY packages/auth/package.json packages/auth/
COPY packages/observability/package.json packages/observability/
COPY packages/feature-flags/package.json packages/feature-flags/
COPY packages/analytics-sdk/package.json packages/analytics-sdk/
COPY packages/internal-clients/package.json packages/internal-clients/
COPY packages/test-utils/package.json packages/test-utils/
COPY packages/contract-tests/package.json packages/contract-tests/
COPY packages/ui/package.json packages/ui/
COPY services/core/auth-service/package.json services/core/auth-service/
COPY services/core/user-service/package.json services/core/user-service/
COPY services/core/wallet-service/package.json services/core/wallet-service/
COPY services/core/payment-service/package.json services/core/payment-service/
COPY services/core/content-service/package.json services/core/content-service/
COPY services/core/search-service/package.json services/core/search-service/
COPY services/core/media-service/package.json services/core/media-service/
COPY services/engagement/notification-service/package.json services/engagement/notification-service/
COPY services/engagement/reward-service/package.json services/engagement/reward-service/
COPY services/engagement/engagement-service/package.json services/engagement/engagement-service/
COPY services/engagement/messaging-service/package.json services/engagement/messaging-service/
COPY services/engagement/referral-service/package.json services/engagement/referral-service/
COPY services/engagement/subscription-service/package.json services/engagement/subscription-service/
COPY services/intelligence/analytics-service/package.json services/intelligence/analytics-service/
COPY services/intelligence/recommendation-service/package.json services/intelligence/recommendation-service/
COPY services/universes/reality-service/package.json services/universes/reality-service/
COPY services/universes/movie-service/package.json services/universes/movie-service/
COPY services/universes/comedy-service/package.json services/universes/comedy-service/
COPY services/universes/games-service/package.json services/universes/games-service/
COPY services/universes/sports-service/package.json services/universes/sports-service/
COPY services/universes/lifestyle-service/package.json services/universes/lifestyle-service/
COPY services/universes/vertical-service/package.json services/universes/vertical-service/
COPY services/universes/creator-service/package.json services/universes/creator-service/
COPY services/operations/queue-service/package.json services/operations/queue-service/
COPY services/operations/support-service/package.json services/operations/support-service/
COPY services/operations/moderation-service/package.json services/operations/moderation-service/
COPY services/gateway/api-gateway/package.json services/gateway/api-gateway/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_URL}

ARG NEXT_PUBLIC_BASE_URL=""
ARG NEXT_PUBLIC_AUTH_URL=""
ARG NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
ARG NEXT_PUBLIC_FIREBASE_API_KEY=""
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
ARG NEXT_PUBLIC_SENTRY_DSN=""

ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_AUTH_URL=${NEXT_PUBLIC_AUTH_URL}
ENV NEXT_PUBLIC_STRIPE_PUBLIC_KEY=${NEXT_PUBLIC_STRIPE_PUBLIC_KEY}
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY}
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN}
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID}
ENV NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN}

# Cache-bust: set to a unique value (e.g. git hash or timestamp) to force rebuild
ARG CACHEBUST

# Build shared packages, then all services, then apps — single merged layer
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    echo "Cache bust: $CACHEBUST" && \
    pnpm --filter @azeebo/utils run build && \
    pnpm --filter @azeebo/shared-types run build && \
    pnpm --filter @azeebo/validation run build && \
    pnpm --filter @azeebo/error-handling run build && \
    pnpm --filter @azeebo/logger run build && \
    pnpm --filter @azeebo/api-client run build && \
    pnpm --filter @azeebo/design-tokens run build && \
    pnpm --filter @azeebo/shared-services prisma:generate && pnpm --filter @azeebo/shared-services run build && \
    pnpm --filter @azeebo/security run build && \
    pnpm --filter @azeebo/ui run build && \
    pnpm --filter @azeebo/auth-service prisma:generate && pnpm --filter @azeebo/auth-service run build && \
    pnpm --filter @azeebo/user-service prisma:generate && pnpm --filter @azeebo/user-service run build && \
    pnpm --filter @azeebo/wallet-service prisma:generate && pnpm --filter @azeebo/wallet-service run build && \
    pnpm --filter @azeebo/payment-service prisma:generate && pnpm --filter @azeebo/payment-service run build && \
    pnpm --filter @azeebo/search-service prisma:generate && pnpm --filter @azeebo/search-service run build && \
    pnpm --filter @azeebo/media-service run build && \
    pnpm --filter @azeebo/notification-service prisma:generate && pnpm --filter @azeebo/notification-service run build && \
    pnpm --filter @azeebo/reward-service prisma:generate && pnpm --filter @azeebo/reward-service run build && \
    pnpm --filter @azeebo/engagement-service prisma:generate && pnpm --filter @azeebo/engagement-service run build && \
    pnpm --filter @azeebo/messaging-service prisma:generate && pnpm --filter @azeebo/messaging-service run build && \
    pnpm --filter @azeebo/referral-service prisma:generate && pnpm --filter @azeebo/referral-service run build && \
    pnpm --filter @azeebo/subscription-service prisma:generate && pnpm --filter @azeebo/subscription-service run build && \
    pnpm --filter @azeebo/analytics-service prisma:generate && pnpm --filter @azeebo/analytics-service run build && \
    pnpm --filter @azeebo/recommendation-service prisma:generate && pnpm --filter @azeebo/recommendation-service run build && \
    pnpm --filter @azeebo/reality-service prisma:generate && pnpm --filter @azeebo/reality-service run build && \
    pnpm --filter @azeebo/movie-service prisma:generate && pnpm --filter @azeebo/movie-service run build && \
    pnpm --filter @azeebo/comedy-service prisma:generate && pnpm --filter @azeebo/comedy-service run build && \
    pnpm --filter @azeebo/games-service prisma:generate && pnpm --filter @azeebo/games-service run build && \
    pnpm --filter @azeebo/sports-service prisma:generate && pnpm --filter @azeebo/sports-service run build && \
    pnpm --filter @azeebo/lifestyle-service prisma:generate && pnpm --filter @azeebo/lifestyle-service run build && \
    pnpm --filter @azeebo/vertical-service prisma:generate && pnpm --filter @azeebo/vertical-service run build && \
    pnpm --filter @azeebo/creator-service prisma:generate && pnpm --filter @azeebo/creator-service run build && \
    pnpm --filter @azeebo/queue-service prisma:generate && pnpm --filter @azeebo/queue-service run build && \
    pnpm --filter @azeebo/support-service prisma:generate && pnpm --filter @azeebo/support-service run build && \
    pnpm --filter @azeebo/moderation-service prisma:generate && pnpm --filter @azeebo/moderation-service run build && \
    pnpm --filter @azeebo/content-service prisma:generate && pnpm --filter @azeebo/content-service run build && \
    pnpm --filter @azeebo/api-gateway run build && \
    pnpm --filter @azeebo/admin prisma:generate && pnpm --filter @azeebo/admin run build && \
    pnpm --filter @azeebo/creator-portal prisma:generate && pnpm --filter @azeebo/creator-portal run build && \
    mkdir -p apps/admin/dist/generated && cp -r apps/admin/src/generated/prisma apps/admin/dist/generated/prisma && \
    mkdir -p apps/creator-portal/dist/generated && cp -r apps/creator-portal/src/generated/prisma apps/creator-portal/dist/generated/prisma && \
    echo "=== Flattening nested dist directories ===" && \
    for svc in $(find services -name "dist" -type d -not -path "*/node_modules/*"); do \
      nested=$(find "$svc" -name "main.js" -path "*/src/*" 2>/dev/null | head -1); \
      if [ -n "$nested" ] && [ ! -f "$svc/main.js" ]; then \
        echo "Flattening: $nested -> $svc/main.js"; \
        cp "$nested" "$svc/main.js"; \
      fi; \
    done && \
    echo "=== Flattened dist inventory ===" && \
    find services -name "main.js" -path "*/dist/*" | sort && \
    pnpm --filter @azeebo/web run build; \
    echo "=== Web .next/ contents ===" && ls -la apps/web/.next/ 2>&1 | head -20; \
    echo "=== .next/standalone check ===" && ls -la apps/web/.next/standalone/ 2>&1 | head -10; \
    echo "=== .next/standalone/server.js check ===" && ls -la apps/web/.next/standalone/server.js 2>&1

# Create /runtime with only what the container needs at runtime.
# Each copy section is independent (;) so a failure in one section does NOT
# silently skip the others (which was the root cause of the dist-missing bug).
RUN echo "Cache bust: $CACHEBUST" && \
    mkdir -p /runtime/node_modules && \
    cp package.json pnpm-lock.yaml pnpm-workspace.yaml /runtime/ && \
    find . -maxdepth 4 -name "package.json" \
      -not -path "*/node_modules/*" \
      -not -path "*/dist/*" \
      -not -path "*/.next/*" \
      -not -path "*/.prisma/*" \
      | while read f; do \
        mkdir -p "/runtime/$(dirname "$f")" && cp "$f" "/runtime/$f"; \
      done; \
    find services -maxdepth 2 -mindepth 2 -type d | while read svc; do \
      if [ -d "$svc/dist" ]; then \
        mkdir -p "/runtime/$svc/dist" && cp -r "$svc/dist/." "/runtime/$svc/dist/"; \
      fi; \
      if [ -d "$svc/prisma" ]; then \
        mkdir -p "/runtime/$svc/prisma" && cp -r "$svc/prisma/." "/runtime/$svc/prisma/"; \
      fi; \
    done; \
    find packages -maxdepth 1 -mindepth 1 -type d | while read pkg; do \
      if [ -d "$pkg/dist" ]; then \
        mkdir -p "/runtime/$pkg/dist" && cp -r "$pkg/dist/." "/runtime/$pkg/dist/"; \
      fi; \
    done; \
    mkdir -p /runtime/apps/admin/dist && cp -r apps/admin/dist/. /runtime/apps/admin/dist/ && \
    mkdir -p /runtime/apps/admin/prisma && cp -r apps/admin/prisma/. /runtime/apps/admin/prisma/ 2>/dev/null; \
    mkdir -p /runtime/apps/creator-portal/dist && cp -r apps/creator-portal/dist/. /runtime/apps/creator-portal/dist/ && \
    mkdir -p /runtime/apps/creator-portal/prisma && cp -r apps/creator-portal/prisma/. /runtime/apps/creator-portal/prisma/ 2>/dev/null; \
    mkdir -p /runtime/apps/web/standalone && \
    if [ -f apps/web/.next/standalone/server.js ]; then \
      cp -r apps/web/.next/standalone/. /runtime/apps/web/standalone/ && \
      echo "Standalone: copied from .next/standalone/ (direct)"; \
    elif [ -f apps/web/.next/standalone/apps/web/server.js ]; then \
      cp -r apps/web/.next/standalone/apps/web/. /runtime/apps/web/standalone/ && \
      echo "Standalone: copied from .next/standalone/apps/web/ (nested)"; \
    elif [ -d apps/web/.next/standalone ]; then \
      cp -r apps/web/.next/standalone/. /runtime/apps/web/standalone/ && \
      echo "Standalone: copied from .next/standalone/ (fallback)"; \
    else \
      echo "WARNING: No standalone output found in apps/web/.next/standalone/"; \
    fi; \
    mkdir -p /runtime/apps/web/standalone/static && \
    cp -r apps/web/.next/static/. /runtime/apps/web/standalone/static/ 2>/dev/null; \
    cp -r apps/web/public/. /runtime/apps/web/standalone/public/ 2>/dev/null; \
    cp apps/web/next.config.js /runtime/apps/web/standalone/ 2>/dev/null; \
    echo "=== Builder dist inventory ===" && \
    find services -name "main.js" -path "*/dist/*" | sort && \
    echo "=== Web standalone inventory ===" && \
    ls -la apps/web/.next/standalone/server.js 2>/dev/null && echo "OK: standalone/server.js exists in builder" || echo "MISSING: standalone/server.js NOT in builder" && \
    echo "=== /runtime dist inventory ===" && \
    find /runtime/services -name "main.js" -path "*/dist/*" 2>/dev/null | sort && \
    echo "=== Verifying critical dist files ===" && \
    test -f /runtime/services/core/content-service/dist/main.js && echo "OK: content-service" || echo "MISSING: content-service/dist/main.js" && \
    test -f /runtime/services/core/wallet-service/dist/main.js && echo "OK: wallet-service" || echo "MISSING: wallet-service/dist/main.js" && \
    (test -f /runtime/apps/web/standalone/server.js && echo "OK: web-app standalone" || echo "MISSING: web-app/standalone/server.js") && \
    true

# ============================================================
# Stage 2: Runtime — lean image with production deps only
# ============================================================
FROM node:22.16.0-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies in a single layer with aggressive cleanup
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate && \
    apt-get update && apt-get install -y --no-install-recommends \
      postgresql-15 \
      redis-server \
      pgbouncer \
      supervisor \
      nginx \
      curl \
      locales \
      openssl \
      procps \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && useradd -r -s /bin/false pgbouncer || true \
    && mkdir -p /var/lib/redis /var/run/pgbouncer /var/log/supervisor /var/log/postgresql \
    && chown -R redis:redis /var/lib/redis \
    && chown -R pgbouncer:pgbouncer /var/run/pgbouncer \
    && chown -R postgres:postgres /var/log/postgresql \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

WORKDIR /app

# Copy runtime skeleton from builder (workspace structure + built artifacts)
COPY --from=builder /runtime /app

# Fresh production install — only production dependencies, no devDeps
ENV CI=true
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# All post-install setup in a single layer:
#   1. Symlink workspace packages (avoid duplicate node_modules copies)
#   2. Remove orphaned pnpm packages (replaced by symlinks)
#   3. Install Prisma CLI (needed for migrate deploy in entrypoint.sh)
#   4. Generate Prisma clients (schema-specific, must run per-service)
#   5. Copy @prisma/client shim to each service's local node_modules
#   6. Aggressive cleanup of all caches and temp files
RUN mkdir -p /app/node_modules/@azeebo && \
    for pkg_json in $(find packages services apps -maxdepth 3 -name "package.json" \
      -not -path "*/node_modules/*" -not -path "*/dist/*" -not -path "*/.prisma/*"); do \
      name=$(node -e "process.stdout.write(require('./$pkg_json').name||'')" 2>/dev/null); \
      if [ -n "$name" ]; then \
        target=$(realpath "$(dirname "$pkg_json")"); \
        rm -rf "/app/node_modules/$name" && \
        ln -sfn "$target" "/app/node_modules/$name"; \
      fi; \
    done && \
    find /app/node_modules/.pnpm -maxdepth 1 -type d -name "*@azeebo*" -exec rm -rf {} + 2>/dev/null; \
    rm -rf /root/.local/share/pnpm 2>/dev/null; \
    npm install -g prisma@6.19.3 && npm cache clean --force 2>/dev/null; \
    true

# Generate Prisma clients per-service with ISOLATED output.
#
# All services share a single @prisma/client pnpm package, so `prisma generate`
# writes the generated client to the SHARED .pnpm/@prisma+client@*/node_modules/.prisma/client.
# Without isolation, each generate overwrites the previous, and only the LAST schema's
# enums/models survive — causing `@IsEnum(SomePrismaEnum)` to crash with
# "Cannot convert undefined or null to object" at module load for every other service.
#
# Fix: after each service's `prisma generate`, copy a real (de-symlinked) copy of
# @prisma/client into that service's own node_modules and write a shim that
# re-exports the generated client (either from a custom output dir or from the
# shared .prisma/client that prisma generate just wrote).
#
# IMPORTANT: Do NOT rm -rf .prisma — that deletes the generated client that
# prisma generate just wrote. Only rm -rf @prisma/client (to replace with shared).
#
# Non-custom-output services: leave @prisma/client intact — the real package's
# index.js resolves .prisma/client/ automatically via relative require.
# Custom-output services: replace @prisma/client/index.js with shim pointing to
# the custom output dir (e.g., src/prisma/client/).
#
# DATABASE_URL is required by prisma generate (schema validation) even though no connection is made.
RUN DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" && \
    export DATABASE_URL && \
    SHARED_CLIENT_DIR=$(cd /app/services/core/auth-service && node -e "console.log(require('path').dirname(require.resolve('@prisma/client')))" 2>/dev/null) && \
    echo "  Shared @prisma/client: $SHARED_CLIENT_DIR" && \
    for schema in $(find services apps -name "schema.prisma" -not -path "*/node_modules/*" -not -path "*/dist/*"); do \
      proj_root=$(dirname "$schema"); \
      svc_root=$(dirname "$proj_root"); \
      echo "  Generating Prisma client for $svc_root..."; \
      SVC_NM="/app/$svc_root/node_modules"; \
      rm -rf "$SVC_NM/@prisma/client"; \
      mkdir -p "$SVC_NM/@prisma/client"; \
      cp -r "$SHARED_CLIENT_DIR/." "$SVC_NM/@prisma/client/"; \
      rm -rf "$SVC_NM/@prisma/client/node_modules"; \
      CUSTOM_OUTPUT=$(grep -m1 'output\s*=' "/app/$schema" | sed 's/.*"\(.*\)".*/\1/'); \
      if [ -n "$CUSTOM_OUTPUT" ]; then \
        FULL_OUTPUT="/app/$proj_root/$CUSTOM_OUTPUT"; \
        (cd "/app/$proj_root" && prisma generate --schema=schema.prisma 2>&1) || \
          echo "  WARNING: prisma generate failed for $proj_root"; \
        if [ -d "$FULL_OUTPUT" ]; then \
          echo "module.exports = { ...require('$FULL_OUTPUT') }" > "$SVC_NM/@prisma/client/index.js"; \
          echo "module.exports = { ...require('$FULL_OUTPUT') }" > "$SVC_NM/@prisma/client/default.js"; \
        else \
          echo "  WARNING: Custom output $FULL_OUTPUT not found for $svc_root"; \
        fi; \
      else \
        (cd "/app/$proj_root" && prisma generate --schema=schema.prisma 2>&1) || \
          echo "  WARNING: prisma generate failed for $proj_root"; \
        if [ -d "$SVC_NM/.prisma/client" ]; then \
          echo "  Generated Prisma client for $svc_root at $SVC_NM/.prisma/client"; \
        else \
          echo "  WARNING: No .prisma/client found for $svc_root after generate!"; \
        fi; \
      fi; \
      cd /app; \
    done && \
    SHARED_ENGINE=""; \
    for engine in $(find /app/services /app/apps -path "*/.prisma/client/libquery_engine-*.node" -type f 2>/dev/null); do \
      if [ -z "$SHARED_ENGINE" ]; then \
        SHARED_ENGINE="$engine"; \
      else \
        rm -f "$engine" && ln -sfn "$SHARED_ENGINE" "$engine"; \
      fi; \
    done; \
    npm cache clean --force 2>/dev/null; \
    rm -rf /tmp/* /var/tmp/* /root/.npm /root/.cache /root/.local 2>/dev/null; \
    find /app/node_modules -name "*.md" -o -name "*.txt" -o -name "*.map" -o -name "LICENSE*" -o -name "CHANGELOG*" | xargs rm -f 2>/dev/null; \
    find /app/node_modules -name "__tests__" -type d -exec rm -rf {} + 2>/dev/null; \
    find /app/node_modules -name "test" -type d -exec rm -rf {} + 2>/dev/null; \
    find /app/node_modules -name "docs" -type d -exec rm -rf {} + 2>/dev/null; \
    true

# Copy config files (single layer with final cleanup)
COPY supervisord.conf /etc/supervisord.conf
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
RUN rm -f /etc/nginx/sites-enabled/default && chmod +x /entrypoint.sh && \
    rm -rf /var/cache/apt /var/lib/apt/lists/* /tmp/* /var/tmp/*

EXPOSE 80 443 3013 4000 4014 4016 5432 6379 6432

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=300s \
  CMD curl -f http://localhost:80/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]

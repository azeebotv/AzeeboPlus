# ============================================================
# Azeebo+ Production Environment Configuration
# ============================================================
# IMPORTANT: Replace ALL placeholder values before deploying.
# NEVER commit this file to version control.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=azeebo
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD_MIN_32_CHARS
POSTGRES_DB=azeebo_plus

# ---- Redis ----
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# ---- Per-Service Database Passwords ----
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=REPLACE_WITH_AUTH_DB_PASSWORD
USER_DB_USER=user_user
USER_DB_PASSWORD=REPLACE_WITH_USER_DB_PASSWORD
WALLET_DB_USER=wallet_user
WALLET_DB_PASSWORD=REPLACE_WITH_WALLET_DB_PASSWORD
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=REPLACE_WITH_PAYMENT_DB_PASSWORD
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=REPLACE_WITH_CONTENT_DB_PASSWORD
SEARCH_DB_USER=search_user
SEARCH_DB_PASSWORD=REPLACE_WITH_SEARCH_DB_PASSWORD
MEDIA_DB_USER=media_user
MEDIA_DB_PASSWORD=REPLACE_WITH_MEDIA_DB_PASSWORD
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_NOTIFICATION_DB_PASSWORD
REWARD_DB_USER=reward_user
REWARD_DB_PASSWORD=REPLACE_WITH_REWARD_DB_PASSWORD
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=REPLACE_WITH_ANALYTICS_DB_PASSWORD
RECOMMENDATION_DB_USER=recommendation_user
RECOMMENDATION_DB_PASSWORD=REPLACE_WITH_RECOMMENDATION_DB_PASSWORD
REALITY_DB_USER=reality_user
REALITY_DB_PASSWORD=REPLACE_WITH_REALITY_DB_PASSWORD
MOVIE_DB_USER=movie_user
MOVIE_DB_PASSWORD=REPLACE_WITH_MOVIE_DB_PASSWORD
GAMES_DB_USER=games_user
GAMES_DB_PASSWORD=REPLACE_WITH_GAMES_DB_PASSWORD
COMEDY_DB_USER=comedy_user
COMEDY_DB_PASSWORD=REPLACE_WITH_COMEDY_DB_PASSWORD
SPORTS_DB_USER=sports_user
SPORTS_DB_PASSWORD=REPLACE_WITH_SPORTS_DB_PASSWORD
LIFESTYLE_DB_USER=lifestyle_user
LIFESTYLE_DB_PASSWORD=REPLACE_WITH_LIFESTYLE_DB_PASSWORD
VERTICAL_DB_USER=vertical_user
VERTICAL_DB_PASSWORD=REPLACE_WITH_VERTICAL_DB_PASSWORD
CREATOR_DB_USER=creator_user
CREATOR_DB_PASSWORD=REPLACE_WITH_CREATOR_DB_PASSWORD
SUPPORT_DB_USER=support_user
SUPPORT_DB_PASSWORD=REPLACE_WITH_SUPPORT_DB_PASSWORD
MODERATION_DB_USER=moderation_user
MODERATION_DB_PASSWORD=REPLACE_WITH_MODERATION_DB_PASSWORD
QUEUE_DB_USER=queue_user
QUEUE_DB_PASSWORD=REPLACE_WITH_QUEUE_DB_PASSWORD
ENGAGEMENT_DB_USER=engagement_user
ENGAGEMENT_DB_PASSWORD=REPLACE_WITH_ENGAGEMENT_DB_PASSWORD
MESSAGING_DB_USER=messaging_user
MESSAGING_DB_PASSWORD=REPLACE_WITH_MESSAGING_DB_PASSWORD
REFERRAL_DB_USER=referral_user
REFERRAL_DB_PASSWORD=REPLACE_WITH_REFERRAL_DB_PASSWORD
SUBSCRIPTION_DB_USER=subscription_user
SUBSCRIPTION_DB_PASSWORD=REPLACE_WITH_SUBSCRIPTION_DB_PASSWORD
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=REPLACE_WITH_ADMIN_DB_PASSWORD
CREATOR_PORTAL_DB_USER=creator_portal_user
CREATOR_PORTAL_DB_PASSWORD=REPLACE_WITH_CREATOR_PORTAL_DB_PASSWORD

# ---- JWT & Gateway Secrets (minimum 64 chars for JWT, 32 chars for Gateway) ----
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
GATEWAY_SECRET=REPLACE_WITH_32_CHAR_RANDOM_GATEWAY_SECRET
INTERNAL_API_KEY=REPLACE_WITH_32_CHAR_RANDOM_INTERNAL_API_KEY
WEBHOOK_SECRET=REPLACE_WITH_32_CHAR_RANDOM_WEBHOOK_SECRET

# ---- Demo Mode (set true to seed test users/content on boot) ----
DEMO_MODE=false
SEED_DEMO_DATA=false

# ---- Payment Gateways (use live keys in production) ----
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
FLW_PUBLIC_KEY=REPLACE_WITH_FLUTTERWAVE_PUBLIC_KEY
FLW_SECRET_KEY=REPLACE_WITH_FLUTTERWAVE_SECRET_KEY
FLW_WEBHOOK_SECRET=REPLACE_WITH_FLUTTERWAVE_WEBHOOK_SECRET

# ---- AWS / Media ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=azeebo-media

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=noreply@azeeboplus.com

# ---- Notification Providers ----
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER

# ---- External APIs ----
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_API_KEY
TWITTER_API_KEY=REPLACE_WITH_TWITTER_API_KEY
TWITTER_API_SECRET=REPLACE_WITH_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=REPLACE_WITH_TWITTER_ACCESS_TOKEN
TWITTER_ACCESS_TOKEN_SECRET=REPLACE_WITH_TWITTER_ACCESS_TOKEN_SECRET

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGIN=https://app.azeeboplus.com,https://admin.azeeboplus.com,https://creator.azeeboplus.com

# ---- Logging ----
LOG_LEVEL=warn
NODE_ENV=production

# ---- Feature Flags ----
ENABLE_REALITY_UNIVERSE=true
ENABLE_VERTICAL_UNIVERSE=true
ENABLE_LIFESTYLE_UNIVERSE=true
ENABLE_COMEDY_UNIVERSE=true
ENABLE_SPORTS_UNIVERSE=true
ENABLE_GAMES_UNIVERSE=true
ENABLE_REWARDS_UNIVERSE=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://app.azeeboplus.com

# ---- Port Overrides (optional) ----

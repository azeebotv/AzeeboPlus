# Dependencies - exclude all, pnpm will install fresh in Docker
node_modules
**/node_modules

# Git
.git
.gitignore
.github

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Documentation and non-runtime directories
audit-evidence/
docs/
docx/
md/

# Infrastructure (Terraform, etc.)
infra/
terraform/
ci/

# Test files (not needed in production images)
**/*.spec.ts
**/*.test.ts
**/*.e2e.spec.ts
**/__tests__/
**/__mocks__/
coverage/
.nyc_output/

# Build artifacts (rebuilt inside Docker)
**/dist/
**/build/
**/.next/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker files (don't include other Dockerfiles)
docker-compose*.yml
Dockerfile*
.dockerignore

# Prisma migrations (applied at runtime, not baked in)
**/migrations/

# Scripts that aren't needed in production
scripts/
test/

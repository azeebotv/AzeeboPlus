# Dependencies
node_modules
**/node_modules

# Build outputs (exclude service dist, but keep packages/*/dist for runtime)
dist
**/dist
build
.next
*.log

# But keep packages' built outputs - they're required at runtime
!packages/
!packages/**/dist
!packages/**/dist/**
!packages/**/node_modules
!packages/**/node_modules/**

# Git
.git
.gitignore

# Environment files
.env
.env.*
!.env.example

# Documentation and non-runtime directories
audit-evidence/
docs/
docx/
infra/
scripts/
.github/
.qoder/

# Markdown (except README)
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# Docker and config files
docker-compose*.yml
.eslintrc.json
.prettierrc
prettier.config.*
jest.config.*
stryker.config.*

# Keep tsconfig files (needed by Dockerfiles for building)
# tsconfig.build.json is required by service build scripts (tsc -p tsconfig.build.json)

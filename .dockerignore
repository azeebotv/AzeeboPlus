# Dependencies - exclude all, pnpm will install fresh in Docker
node_modules
**/node_modules

# Git
.git
.gitignore
.github

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Documentation and non-runtime directories
audit-evidence/
docs/
docx/
md/

# Infrastructure (Terraform, etc.)
infra/
terraform/
ci/

# Test files (not needed in production images)
**/*.spec.ts
**/*.test.ts
**/*.e2e.spec.ts
**/__tests__/
**/__mocks__/
coverage/
.nyc_output/

# Build artifacts (rebuilt inside Docker)
**/dist/
**/build/
**/.next/
**/*.tsbuildinfo

# Cache directories
.cache/
**/.cache/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker files (don't include other Dockerfiles)
docker-compose*.yml
Dockerfile*
.dockerignore

# Prisma migrations (included so entrypoint can run `prisma migrate deploy` at runtime)
# **/migrations/

# Scripts that aren't needed in production (whitelist scripts required by Docker build and entrypoint)
scripts/*
!scripts/generate-prisma-clients.sh
!scripts/patch-prisma-client.sh
!scripts/check-prisma-client-stale.mjs
!scripts/build-service.sh
!scripts/build-package.sh
!scripts/install-git-hooks.sh
!scripts/lib
!scripts/generate-domain-env.mjs
!scripts/demo-content
test/

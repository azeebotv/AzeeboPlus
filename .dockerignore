# Dependencies - exclude all, pnpm will install fresh in Docker
node_modules
**/node_modules

# Git
.git
.gitignore

# Environment files
.env
.env.*
!.env.example

# Documentation and non-runtime directories
audit-evidence/
docs/
docx/
infra/
scripts/
ci/
.github/
.qoder/
docker-bake.hcl

# Markdown (except README)
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# Docker and config files (not needed inside the build)
docker-compose*.yml
Dockerfile*

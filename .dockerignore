# Dependencies - exclude all, pnpm will install fresh in Docker
node_modules
**/node_modules

# Git
.git
.gitignore

# Environment files
.env
.env.*
!.env.example

# Documentation and non-runtime directories
audit-evidence/
docs/
docx/
infra/
scripts/
ci/
.github/
.qoder/
.trae/
docker-bake.hcl

# Markdown (except README)
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# Docker and config files (not needed inside the build)
docker-compose*.yml
Dockerfile*

# Logs
*.log
logs/
*.rdb

# Test files (not needed in production build)
**/*.test.ts
**/*.spec.ts
**/*.test.js
**/*.spec.js
**/__tests__/
**/test/
**/tests/
**/e2e/
**/playwright-report/
**/coverage/

# Build artifacts that will be rebuilt inside Docker
**/dist/
**/.next/
**/.nuxt/
**/.output/

# Generated Prisma clients (will be regenerated in Docker)
**/src/generated/
**/.prisma/

# Dev tooling configs (tsconfig.json and .npmrc MUST be included — needed for build)
.prettierrc
eslint.config.js
tsconfig.scripts.json
.nvmrc
Procfile
nixpacks.toml
nixpacks-start.sh

# Mobile app (not part of all-in-one build)
apps/mobile/

# Temp and cache files
.cache/
*.cache
.turbo/
.vercel/
